     fhir:CodeSystem.concept.display [ fhir:value "CERCLAGEM DE COLO DO ÚTERO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA SUTURA CIRÚRGICA EM BOLSA DO COLO UTERINO, EM SUA PORÇÃO VAGINAL. GERALMENTE INDICADA COM O OBJETIVO DE MANTER O COLO UTERINO FECHADO ATÉ O FINAL DA GRAVIDEZ PARA PREVENIR UM PARTO PREMATURO" ]
  ], [
     fhir:index 3264 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060020" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "COLPOPERINEOPLASTIA ANTERIOR E POSTERIOR C/ AMPUTAÇÃO DE COLO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA INTERVENÇÃO CIRÚRGICA PARA REPARAR AS ESTRUTURAS VAGINAIS, PERINEAIS E RECONSTRUÇÃO DO ASSOALHO PÉLVICO. É UMA CIRURGIA REPARADORA DAS PAREDES VAGINAIS ANTERIOR E POSTERIOR ONDE O OBJETIVO É RESTAURAR O POSICIONAMENTO DA BEXIGA NA PAREDE ANTERIOR, CORRIGINDO A CISTOCELE, E NA PAREDE POSTERIOR RESTAURAR A POSIÇÃO DO RETO, CORRIGINDO A RETOCELE. ASSOCIADA A AMPUTAÇÃO DO COLO PARA CORREÇÃO DO PROLAPSO DO ÚTERO." ]
  ], [
     fhir:index 3265 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060038" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXCISÃO TIPO 3 DO COLO UTERINO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REMOÇÃO DA ZONA DE TRANSFORMAÇÃO E DE 2 A 2,5 CM DO CANAL CERVICAL.PODE SER REALIZADA A FRIO (COM BISTURI COMUM) OU POR ELETROCIRURGICA (COM BISTURI ELÉTRICO DE ALTA CLASSIFICAÇÃO QUE MELHOR ORIENTA A CONDUTA TERAPÊUTICA SUBSEQUENTE E O PROGNÓSTICO DOS CASOS)." ]
  ], [
     fhir:index 3266 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060046" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "CURETAGEM SEMIÓTICA C/ OU S/ DILATAÇÃO DO COLO DO ÚTERO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO CIRÚRGICO PARA ESVAZIAMENTO DA CAVIDADE UTERINA POR MEIO DE UMA CURETA PARA RETIRADA DE MATERIAL ENDOMETRIAL PARA REALIZAÇÃO DE DIAGNÓSTICO OU COMO FORMA DE TRATAMENTO. PODE SER FEITA COM OU SEM A DILATAÇÃO PRÉVIA DO CANAL CERVICAL" ]
  ], [
     fhir:index 3267 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060054" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "CURETAGEM UTERINA EM MOLA HIDATIFORME" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA INTERVENÇÃO CIRÚRGICA PARA PROCEDER A RASPAGEM DO ÚTERO EM DECORRÊNCIA DA EXISTÊNCIA DE UMA MOLA HIDATIFORME, QUE É O CRESCIMENTO DE UM ÓVULO FERTILIZADO ANORMAL OU CRESCIMENTO EXCESSIVO DO TECIDO DA PLACENTA." ]
  ], [
     fhir:index 3268 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060062" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DILATAÇÃO DE COLO DO ÚTERO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO TRATAMENTO DA ESTENOSE CERVICAL DO COLO, PRINCIPALMENTE NOS CASOS SINTOMÁTICOS COM HEMATOMETRA OU PIOMETRA. NO PROCEDIMENTO, O COLO DO ÚTERO PODE SER DILATADO INSERINDO PEQUENAS HASTES DE METAL LUBRIFICADAS (DILATADORES) ATRAVÉS DA ABERTURA E, SE NECESSÁRIO, INSERINDO DEPOIS, DILATADORES DE MAIOR CALIBRE." ]
  ], [
     fhir:index 3269 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060070" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ESVAZIAMENTO DE ÚTERO POS-ABORTO POR ASPIRAÇÃO MANUAL INTRA-UTERINA (AMIU)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO ESVAZIAMENTO UTERINO POR ASPIRAÇÃO MANUAL INTRAUTERINA ATRAVÉS DE UM ASPIRADOR À VÁCUO (SERINGA DE VÁLVULA DUPLA) ACOPLADO A CÂNULAS DE PLÁSTICO SEMI-FLEXÍVEIS DE DIFERENTES ESPESSURAS" ]
  ], [
     fhir:index 3270 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060089" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXCISÃO TIPO I DO COLO UTERINO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA DA ZONA DE TRANSFORMAÇÃO ECTOCERVICAL,  POR MEIO DA CIRURGIA DE ALTA FREQUÊNCIA E COM PROFUNDIDADE MÁXIMA DE 01 CM. POSSUI OBJETIVO TERAPÊUTICO, SENDO REALIZADO AMBULATORIALMENTE, SOB ANESTESIA LOCAL E VISÃO COLPOSCÓPICA. RECOMENDADA PARA O TRATAMENTO DE LESÕES PRE-INVASIVAS DIAGNOSTICADAS POR BIOPSIA PREVIA OU COMO PARTE DO MÉTODO VER E TRATAR QUANDO A ZONA DE TRANS FORMAÇÃO ESTA COMPLETAMENTE VISÍVEL E SITUADA NA ECTOCÉRVICE  (A JUNÇÃO ESCAMOCOLUNAR DEVE ESTAR LOCALIZADA NA ECTOCÉRVICE OU NO ORIFÍCIO EXTERNO  DO CANAL ENDOCERVICAL - ZONA DE TRANSFORMAÇÃO TIPO 1)." ]
  ], [
     fhir:index 3271 ;
     fhir:CodeSystem.concept.code [ fhir:value "0409060097" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXERESE DE PÓLIPO DE ÚTERO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA MANOBRA CIRÚRGICA UTILIZADA PARA RETIRAR UMA PARTE OU A TOTALIDADE DE UM PÓLIPO QUE É O CRESCIMENTO ANORMAL DE CÉLULAS MADURAS BEM DIFERENCIADAS SEM CAPACIDADE DE INVADIR OUTROS TIPOS DE TECIDOS OU ÓRGÃOS (NEOPLASIA BENIGNA) FIXADA NA PAREDE INTERNA DO ÚTERO NA CÉRVICE, NA CAVIDADE ENDOMETRIAL OU NA TRANSIÇÃO ENTRE AS DUAS REGIÕES. TEM FINALIDADE TERAPÊUTICA." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "VASECTOMIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO CIRÚRGICO QUE CONSISTE NA RESSECÇÃO E LIGADURA DAS DUAS EXTREMIDADES DOS CANAIS DEFERENTES, SOB ANESTESIA LOCAL, BILATERALMENTE, COM O OBJETIVO DE PROMOVER A CONTRACEPÇÃO MASCULINA APÓS DESEJO CLARO DE VONTADE DO SOLICITANTE E CUMPRIDO TODOS OS REQUISITOS LEGAIS, COM BASE NA LEI DO PLANEJAMENTO FAMILIAR. PODE SER AUTORIZADO, INDEPENDENTEMENTE DE SER UNI OU BILATERAL, NOS RAROS CASOS DE INFECÇÃO CRÔNICA OU FIBROSE, ACOMPANHADA OU NÃO DE SINTOMAS ALGICOS, NA FALHA DO TRATAMENTO CONSERVADOR." ]

     fhir:CodeSystem.concept.code [ fhir:value "0202030296" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PESQUISA DE ANTICORPOS ANTI-HIV-1 (WESTERN BLOT)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM UMA TÉCNICA ANALÍTICA USADA PARA DETECTAR PROTEÍNAS ESPECÍFICAS EM UMA DADA AMOSTRA DE HOMOGENEIZADO DE TECIDO OU EXTRATO. UTILIZA ELETROFORESE EM GEL PARA SEPARAR AS PROTEÍNAS NATIVAS, QUE SÃO TRANSFERIDAS PARA UMA MEMBRANA DE NITROCELULOSE, UTILIZANDO ANTICORPOS ESPECÍFICOS PARA DETECÇÃO DA PROTEÍNA ALVO. INDICADO COMO TESTE CONFIRMATÓRIO, EM CASOS DE RESULTADO POSITIVO NO TESTE ELISA PARA HIV." ]
  ], [

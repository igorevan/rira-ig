     fhir:CodeSystem.concept.display [ fhir:value "AÇÃO COLETIVA DE APLICAÇÃO TÓPICA DE FLÚOR GEL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "APLICAÇÃO TÓPICA DE FLÚOR EM GEL COM CONCENTRAÇÃO DE 1,23 , REALIZADA SISTEMATICAMENTE POR GRUPOS POPULACIONAIS SOB ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE, UTILIZANDO-SE ESCOVA DENTAL, MOLDEIRA, PINCELAMENTO OU OUTRAS FORMAS DE APLICAÇÃO. AÇÃO REGISTRADA POR PESSOA POR MÊS." ]
  ], [
     fhir:index 5 ;
     fhir:CodeSystem.concept.code [ fhir:value "0101020023" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AÇÃO COLETIVA DE BOCHECHO FLUORADO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "BOCHECHO DE SOLUÇÃO FLUORETADA, REALIZADO SISTEMATICAMENTE POR GRUPOS POPULACIONAIS SOB  ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE, PODENDO TER PERIODICIDADE SEMANAL, CASO A  SOLUÇÃO DE FLUORETO DE SÓDIO TENHA A CONCENTRAÇÃO DE 0,2 , OU DIARIAMENTE, CASO A CONCENTRAÇÃO SEJA DE 0,05. AÇÃO REGISTRADA POR USUÁRIO PARTICIPANTE POR MÊS, INDEPENDENTE DA FREQUÊNCIA COM QUE É REALIZADA (DIÁRIA OU SEMANAL) OU DA FREQUÊNCIA COM QUE O USUÁRIO PARTICIPOU DA AÇÃO." ]
  ], [
     fhir:index 6 ;
     fhir:CodeSystem.concept.code [ fhir:value "0101020031" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AÇÃO COLETIVA DE ESCOVAÇÃO DENTAL SUPERVISIONADA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ESCOVAÇÃO DENTAL COM OU SEM EVIDENCIAÇÃO DE PLACAS BACTERIANAS. REALIZADA COM GRUPOS POPULACIONAIS SOB ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE. AÇÃO REGISTRADA POR USUÁRIO POR USUÁRIO PARTICIPANTE DA AÇÃO." ]
  ], [
     fhir:index 7 ;
     fhir:CodeSystem.concept.code [ fhir:value "0101020040" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AÇÃO COLETIVA DE EXAME BUCAL COM FINALIDADE EPIDEMIOLÓGICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "COMPREENDE A AVALIAÇÃO DE ESTRUTURAS DA CAVIDADE BUCAL, COM FINALIDADE DE DIAGNÓSTICO SEGUNDO CRITÉRIOS EPIDEMIOLÓGICOS, EM ESTUDOS DE PREVALÊNCIA, INCIDÊNCIA E OUTROS, COM O OBJETIVO DE ELABORAR PERFIL EPIDEMIOLÓGICO E/OU AVALIAR O IMPACTO DAS ATIVIDADES DESENVOLVIDAS, SUBSIDIANDO O PLANEJAMENTO." ]
  ], [

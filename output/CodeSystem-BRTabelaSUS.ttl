     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO EXAME CITOPATOLOGICO DE MATERIAL DE DESCARGA PAPILAR  OU OBTIDO POR PUNCAO DE NODULO MAMARIO, ESTA REALIZADA POR  ASPIRACAO ATRAVES DE SERINGA ACOPLADA A AGULHA FINA." ]
  ], [

  ], [
     fhir:index 3621 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416090133" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO DE TUMOR DE PARTES MOLES EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE PARTES MOLES POR TUMOR MALIGNO OU INCERTO SE BENIGNO OU MALIGNO. A COMPATIBILIDADE DA LINFADENECTOMIA SUPERFICIAL É DE ACORDO COM A TOPOGRAFIA TUMORAL. OS PROCEDIMENTOS SEQUENCIAIS DE PLÁSTICA RECONSTRUTORA SÃO EXCLUDENTES ENTRE SI." ]
  ], [

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZAÇÃO SIMULTANEA DE PROVAS CRUZADAS DE LINFÓCITOS T, LINFÓCITOS T+DTT, LINFÓCITOS T+AGH, LINFÓCITOS B E LINFÓCITOS B+DTT" ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "TOMOGRAFIA COMPUTADORIZADA DE COLUNA CERVICAL C/ OU S/ CONTRASTE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO MÉTODO DE DIAGNÓSTICO POR IMAGEM QUE ATRAVÉS DE CORTES AXIAIS PROPORCIONA ESTUDO DETALHADO DE DIFERENTES ESTRUTURAS DO CORPO HUMANO, FACILITA A LOCALIZAÇÃO, DETECTA ALTERAÇÕES MUITO PEQUENAS EM OSSOS, TECIDOS, ÓRGÃOS E OUTRAS ESTRUTURAS DO CORPO E PROPORCIONA MAIOR PRECISÃO NAS INTERVENÇÕES CLÍNICAS E CIRÚRGICAS." ]

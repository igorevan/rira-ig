  ], [
     fhir:index 297 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202020509" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PROVA DO LAÇO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM UM MÉTODO DE DIAGNÓSTICO CLÍNICO PARA DETERMINAR A TENDÊNCIA HEMORRÁGICA DE UM PACIENTE, É UM EXAME RÁPIDO QUE AJUDA A IDENTIFICAR FRAGILIDADE DOS VASOS SANGUÍNEOS. O TESTE É REALIZADO APLICANDO-SE AO BRAÇO DO PACIENTE MANGUITO DE ESFIGMOMANOMETRO, CALIBRADO NA PRESSÃO ARTERIAL MÉDIA, DURANTE 5 MINUTOS, APÓS O QUE SE OBSERVA O APARECIMENTO OU NÃO DE PETÉQUIAS, QUE VÃO DEFINIR A POSITIVIDADE DO TESTE." ]
  ], [
     fhir:index 298 ;

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NAS ATIVIDADES EDUCATIVAS, EM GRUPO,  SOBRE AÇÕES DE PROMOÇÃO E PREVENÇÃO À SAÚDE, DESENVOLVIDAS NA UNIDADE OU NA COMUNIDADE.  RECOMENDA-SE O MÍNIMO DE 10 (DEZ) PARTICIPANTES,COM DURAÇÃO MÍNIMA  DE 30 (TRINTA) MINUTOS.DEVE-SE REGISTRAR O NÚMERO DE ATIVIDADES REALIZADAS POR MÊS" ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO DE EQUILÍBRIO ESTÁTICO EM PLACA DE FORÇA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO DE INFORMACOES QUANTITATIVAS DO EQUILIBRIO ESTATICO." ]
  ], [
     fhir:index 947 ;
     fhir:CodeSystem.concept.code [ fhir:value "0211030040" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO DE FUNÇÃO E MECÂNICA RESPIRATÓRIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZACAO DE CONSULTA, COM FORNECIMENTO DE INFORMACOES DA CAPACIDADE CARDIORESPIRATORIA POR MEIO DE RECURSOS CLINICO, AUSCULTA, TESTE DA FUNCAO MUSCULAR E CAPACIDADE FUNCIONAL." ]
  ], [
     fhir:index 948 ;

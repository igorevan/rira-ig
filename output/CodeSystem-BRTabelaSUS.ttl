  ], [
     fhir:index 2145 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010210" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MASTOIDECTOMIA RADICAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DA RETIRADA DA PAREDE POSTERIOR DO CONDUTO AUDITIVO EXTERNO,  COMBINADA COM RETIRADA DO TÍMPANO, MARTELO, BIGORNA E MUCOSA DE ORELHA MÉDIA E OCLUSÃO DA TUBA AUDITIVA, MANTENDO O ESTRIBO, VISANDO A REMOÇÃO DO TECIDO DOENTE NO OUVIDO, NORMALMENTE UMA INFLAMAÇÃO CRÔNICA OU UM COLESTEATOMA, ATRAVÉS DA ABERTURA DAS CÉLULAS AÉREAS DA MASTOIDE FAZENDO COM QUE O OUVIDO E A MASTOIDE SE TORNEM UMA SÓ CAVIDADE." ]
  ], [
     fhir:index 2146 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010229" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MASTOIDECTOMIA SUBTOTAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO QUE PERMITE ACESSO AO ANTRO, ÁTICO, LABIRINTO E SACO ENDOLINFÁTICO,  INDICADO PARA DRENAGEM DE MASTOIDITE COALESCENTE OU PARA EXPOSIÇÃO DAS ESTRUTURAS CITADAS, SENDO QUE A  PAREDE POSTERIOR DO CONDUTO AUDITIVO EXTERNO É MANTIDA INTACTA. ATRAVÉS DE UMA INCISÃO RETROAURICULAR É REMOVIDA PARTE DO OSSO QUE REVESTE A MASTOIDE E SUAS CÉLULAS AERADAS, VISANDO IDENTIFICAR E PROTEGER AS ESTRUTURAS VIZINHAS E REMOVER OS TECIDOS DOENTES." ]
  ], [
     fhir:index 2147 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010237" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MICROCIRURGIA OTOLOGICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "MICROCIRURGIA OTOLÓGICA É UM PROCEDIMENTO QUE SE APLICA ÀS CIRURGIAS OTOLÓGICAS QUE SE UTILIZAM DE MICROSCÓPIO CIRÚRGICO EM ESPECIAL PROCEDIMENTO QUE- VISA EQUILIBRAR PRESSÕES INTERNA E EXTERNA NA DISFUNÇÃO TUBÁRIA. INCLUI TUBO DE VENTILAÇÃO." ]
  ], [
     fhir:index 2148 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010245" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MIRINGOTOMIA (TIMPANOPLASTIA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA INCISÃO CIRÚRGICA NA MEMBRANA DO TÍMPANO. CONSISTE EM PROCEDIMENTO CIRÚRGICO AMBULATORIAL, TAMBÉM CHAMADO DE TIMPANOSTOMIA. REFERE-SE A UMA INCISÃO NO TÍMPANO OU MEMBRANA TIMPÂNICA, MAIS FREQUENTEMENTE FEITA COM UM PEQUENO BISTURI, MAS TAMBÉM PODE SER REALIZADO COM UM LASER. PROCEDIMENTO UNILATERAL." ]
  ], [
     fhir:index 2149 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010253" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PARACENTESE DO TIMPANO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA INCISÃO CIRÚRGICA DA MEMBRANA TIMPÂNICA, REALIZADA NO TRATAMENTO DA OTITE MÉDIA AGUDA PARA ALÍVIO PELA REMOÇÃO DE SECREÇÃO EM OUVIDO MÉDIO. PROCEDIMENTO UNILATERAL" ]
  ], [
     fhir:index 2150 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010261" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PUNCAO TRANSMEATICA DO SEIO MAXILAR (UNILATERAL)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA PUNÇÃO DE SEIO MAXILAR, ATRAVÉS DO MEATO INFERIOR, COM PUNÇÃO ABAIXO DA CONCHA INFERIOR, PARA A ABORDAGEM DOS  SEIOS PARANASAIS, PODENDO SER ASSOCIADA À COLETA DE AMOSTRAS PARA CULTURA E ANATOMOPATOLÓGICO, À IRRIGAÇÃO MAXILAR, À DIMINUIÇÃO DO VOLUME DE MATERIAL INFECTADO." ]
  ], [
     fhir:index 2151 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010270" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "REMOCAO DE CERUMEN DE CONDUTO AUDITIVO EXTERNO UNI / BILATERAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REMOÇÃO DE CERA DOS OUVIDOS, PODENDO SER REALIZADA  COM O USO DE ASPIRADORES, CURETAS, MICRO PINÇAS OU LAVAGENS, INDICADA QUANDO A PRESENÇA DO CERÚMEN PROVOCA A SENSAÇÃO DE SURDEZ. PROCEDIMENTO UNI OU BILATERAL." ]
  ], [
     fhir:index 2152 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010288" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO DE GLOMO TIMPANICO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DE  RESSECÇÃO DO GLOMO TIMPÂNICO, UM CORPO OVÓIDE ALTAMENTE VASCULARIZADO DE TECIDO QUIMIORRECEPTOR ADJACENTE À CAVIDADE TIMPÂNICA ONDE DE DESENVOLVE UMA RARA NEOPLASIA CHAMADA TUMOR DE GLOMO TIMPÂNICO QUE CONSTITUE A NEOPLASIA BENIGNA MAIS COMUM DA ORELHA MÉDIA.  CONTEMPLA AS CIRURGIAS REALIZADAS PELAS VIAS DE ACESSO ENDAURAL,  TRANSMASTÓIDEA COM CAVIDADE FECHADA E POR VIA TRANSMASTÓIDEA COM CAVIDADE ABERTA." ]
  ], [
     fhir:index 2153 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010296" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO DE SINEQUIAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM DESFAZER E/OU RESSECAR AS ADERÊNCIAS NASAIS QUE OCORREM QUANDO AS MUCOSAS DAS PAREDES DO NARIZ, GERALMENTE ENTRE O SEPTO E OS CORNETOS INFERIORES, SE UNEM DE FORMA IRREGULAR, BLOQUEANDO O FLUXO DO AR, MAIS FREQUENTEMENTE POR SEQUELA DE CIRURGIA NASAL OU SINUSAL, MAS TAMBÉM PODEM SER CONSEQUÊNCIA DE TRAUMA LOCAL, INFECÇÕES, RINITE ALÉRGICA, USO DE VASOCONSTRITORES E CAUTERIZAÇÕES. PROCEDIMENTO REALIZADO SOB ANESTESIA LOCAL, EM AMBIENTE AMBULATORIAL,  INCLUI A  TÉCNICA DO LASER DE DIODO." ]
  ], [
     fhir:index 2154 ;

     fhir:CodeSystem.concept.definition [ fhir:value "PROMOVER EVENTOS, PALESTRAS E DEMAIS ATIVIDADES DE DIVULGAÇÃO DA LEGISLAÇÃO SANITÁRIA PARA O SETOR REGULADO PELA VIGILÂNCIA SANITÁRIA." ]
  ], [

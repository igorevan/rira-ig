  ], [
     fhir:index 1294 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080232" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ACOLHIMENTO INICIAL POR CENTRO DE ATENÇÃO PSICOSSOCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PRIMEIRO ATENDIMENTO OFERTADO PELO CAPS PARA NOVOS USUÁRIOS, POR DEMANDA ESPONTÂNEA OU REFERENCIADA, INCLUINDO AS SITUAÇÕES DE CRISE NO TERRITÓRIO. O ACOLHIMENTO CONSISTE NA ESCUTA QUALIFICADA, QUE REAFIRMA A LEGITIMIDADE DA PESSOA E/OU FAMILIARES QUE BUSCAM O SERVIÇO E VISA REINTERPRETAR AS DEMANDAS, CONSTRUIR O VÍNCULO TERAPÊUTICO INICIAL E/OU CORRESPONSABILIZAR-SE PELO ACESSO A OUTROS SERVIÇOS, CASO NECESSÁRIO." ]
  ], [
     fhir:index 1295 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080240" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ATENDIMENTO DOMICILIAR PARA PACIENTES DE CENTRO DE ATENÇÃO PSICOSSOCIAL E/OU FAMILIARES" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ATENÇÃO PRESTADA NO LOCAL DE MORADA DA PESSOA E/OU FAMILIARES, PARA COMPREENSÃO DE SEU CONTEXTO E SUA RELAÇÕES, ACOMPANHAMENTO DO CASO E/OU EM SITUAÇÕES QUE IMPOSSIBILITEM OUTRA MODALIDADE DE ATENDIMENTO, QUE VISE À ELABORAÇÃO DO PROJETO TERAPÊUTICO SINGULAR OU DELE DERIVE, QUE GARANTA A CONTINUIDADE DO CUIDADO. ENVOLVE AÇÕES DE PROMOÇÃO, PREVENÇÃO E ASSISTÊNCIA." ]
  ], [
     fhir:index 1296 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080259" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AÇÕES DE ARTICULAÇÃO DE REDES INTRA E INTERSETORIAIS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ESTRATÉGIAS QUE PROMOVAM A ARTICULAÇÃO COM OUTROS PONTOS DE ATENÇÃO DA REDE DE SAÚDE, EDUCAÇÃO, JUSTIÇA, ASSISTÊNCIA SOCIAL, DIREITOS HUMANOS E OUTROS, ASSIM COMO OS RECURSOS COMUNITÁRIOS PRESENTES NO TERRITÓRIO." ]
  ], [
     fhir:index 1297 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080291" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ATENÇÃO ÀS SITUAÇÕES DE CRISE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "AÇÕES DESENVOLVIDAS PARA MANEJO DAS SITUAÇÕES DE CRISE, ENTENDIDAS COMO MOMENTOS DO PROCESSO DE ACOMPANHAMENTO DOS USUÁRIOS, NOS QUAIS CONFLITOS RELACIONAIS COM FAMILIARES, CONTEXTOS, AMBIÊNCIA E VIVÊNCIAS, GERAM INTENSO SOFRIMENTO E DESORGANIZAÇÃO. ESTA AÇÃO EXIGE DISPONIBILIDADE DE ESCUTA ATENTA PARA COMPREENDER E MEDIAR OS POSSÍVEIS CONFLITOS, PODENDO SER REALIZADA NO AMBIENTE DO PRÓPRIO SERVIÇO, NO  DOMICÍLIO OU EM OUTROS ESPAÇOS DO TERRITÓRIO QUE FAÇAM SENTIDO AO USUÁRIO E SUA FAMÍLIA, FAVORECENDO A CONSTRUÇÃO E A PRESERVAÇÃO DE VÍNCULOS." ]
  ], [
     fhir:index 1298 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080305" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MATRICIAMENTO DE EQUIPES DA ATENÇÃO BÁSICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "APOIO PRESENCIAL SISTEMÁTICO ÀS EQUIPES DE ATENÇÃO BÁSICA QUE OFERTE SUPORTE TÉCNICO À CONDUÇÃO DO CUIDADO EM SAÚDE MENTAL ATRAVÉS DE DISCUSSÕES DE CASOS E DO PROCESSO DE TRABALHO, ATENDIMENTO COMPARTILHADO, AÇÕES INTERSETORIAIS NO TERRITÓRIO, E CONTRIBUA NO PROCESSO DE COGESTÃO E CORRESPONSABILIZAÇÃO NO AGENCIAMENTO DO PROJETO TERAPÊUTICO SINGULAR." ]
  ], [
     fhir:index 1299 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080321" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ACOMPANHAMENTO DE SERVIÇO RESIDENCIAL TERAPÊUTICO POR CENTRO DE ATENÇÃO PSICOSSOCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "SUPORTE ÀS EQUIPES DOS SERVIÇOS RESIDENCIAIS TERAPÊUTICOS, COM A CORRESPONSABILIZAÇÃO NOS PROJETOS TERAPÊUTICOS DOS USUÁRIOS, QUE PROMOVA A ARTICULAÇÃO ENTRE AS REDES E OS PONTOS DE ATENÇÃO COM O FOCO NO CUIDADO E DESENVOLVIMENTO DE AÇÕES INTERSETORIAIS, E VISE À PRODUÇÃO DE AUTONOMIA E REINSERÇÃO SOCIAL." ]
  ], [
     fhir:index 1300 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080330" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "APOIO À SERVIÇO RESIDENCIAL DE CARÁTER TRANSITÓRIO POR CENTRO DE ATENÇÃO PSICOSSOCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "APOIO PRESENCIAL SISTEMÁTICO AOS SERVIÇOS RESIDENCIAIS DE CARÁTER TRANSITÓRIO, QUE BUSQUE A MANUTENÇÃO DO VÍNCULO, A RESPONSABILIDADE COMPARTILHADA, O SUPORTE TÉCNICO-INSTITUCIONAL AOS TRABALHADORES DAQUELES SERVIÇOS, O MONITORAMENTO DOS PROJETOS TERAPÊUTICOS, A PROMOÇÃO DE ARTICULAÇÃO ENTRE OS PONTOS DE ATENÇÃO COM FOCO NO CUIDADO E AÇÕES INTERSETORIAIS E QUE FAVOREÇA A INTEGRALIDADE DAS AÇÕES." ]
  ], [

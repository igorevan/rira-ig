     fhir:CodeSystem.concept.display [ fhir:value "DIAGNÓSTICO DE LEUCEMIA CROMOSSOMA PHILADELPHIA POSITIVO POR TÉCNICA MOLECULAR" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA APLICAÇÃO DAS TÉCNICAS DE BIOLOGIA MOLECULAR DE RT-PCR(REVERSE TRANSCRIPTION POLYMERASE CHAIN REACTION) COM VISTAS A DEMONSTRAR A PRESENÇA DO CROMOSSOMO PHILADELPHIA (22Q-) COM PRESENÇA DE TRANSLOCAÇÃO T (9;22) (Q34; Q11) OU, QUANDO NÃO POSSÍVEL, DE HIBRIDIZAÇÃO IN SITU (ISH) PARA IDENTIFICAÇÃO DE ANORMALIDADES MOLECULARES BCR-ALB, DIANTE DE QUADRO SUGESTIVO DE LEUCEMIA MIELOIDE CRÔNICA (LMC) OU LEUCEMIA LINFOBLÁSTICA AGUDA CROMOSSOMA PHILADELPHIA POSITIVO (LLA PH+), QUE INCLUI A OCORRÊNCIA DE LEUCOCITOSE PERSISTENTE (OU TROMBOCITOSE, OCASIONALMENTE) E OUTROS SINAIS TÍPICOS.PODE SER FEITO ALTERNATIVAMENTE AO EXAME DE CITOGENÉTICA CONVENCIONAL/CARIÓTIPO EM MEDULA ÓSSEA E SANGUE PERIFÉRICO." ]
  ], [

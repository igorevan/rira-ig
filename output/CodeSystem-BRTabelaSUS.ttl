     fhir:CodeSystem.concept.definition [ fhir:value "ATENDIMENTO INTEGRATIVO E COMPLEMENTAR QUE ADOTA A OSTEOPATIA PARA UMA ABORDAGEM INTEGRAL NO CUIDADO EM SAÚDE, UTILIZANDO VÁRIAS TÉCNICAS MANUAIS PARA AUXILIAR NO TRATAMENTO DE DOENÇAS – ENTRE ELAS, A DA MANIPULAÇÃO DO SISTEMA MÚSCULO ESQUELÉTICO (OSSOS, MÚSCULOS E ARTICULAÇÕES)." ]
  ], [

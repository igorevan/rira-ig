     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CONTAGEM E MONITORAMENTO DAS POPULAÇÕES DE LINFÓCITOS T EM DOENÇAS AUTOIMUNES, IMUNODEFICIÊNCIAS, INFECÇÕES VIRAIS E EM SÍNDROMES LINFOPROLIFERATIVAS." ]
  ], [
     fhir:index 308 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030040" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETECÇÃO DE ÁCIDOS NUCLEICOS DO HIV-1 (QUALITATIVO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DETECÇÃO DO ÁCIDO NUCLÉICO DO HIV. UTILIZADO NA CONFIRMAÇÃO PRECOCE DO DIAGNÓSTICO DE INFECÇÃO PELO HIV EM RECÉM-NASCIDOS DE MÃES INFECTADAS E APÓS EPISÓDIOS DE POSSÍVEIS CONTAMINAÇÕES PELO HIV, VISANDO DETECTAR O MAIS PRECOCEMENTE POSSÍVEL A PRESENÇA DO VÍRUS." ]
  ], [
     fhir:index 309 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030059" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETECÇÃO DE RNA DO VÍRUS DA HEPATITE C (QUALITATIVO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DETECÇÃO DO RNA VIRAL, QUE É UM MARCADOR DIRETO DA INFECÇÃO ATIVA POR HVC, POR MEIO DAS TÉCNICAS DE REAÇÃO EM CADEIA DA POLIMERASE (PCR). UTILIZADO NO DIAGNÓSTICO DIFERENCIAL DA HEPATITE AUTO-IMUNE SEVERA E HEPATITE C." ]
  ], [
     fhir:index 310 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030067" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO DE COMPLEMENTO (CH50)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA AVALIAÇÃO DA ATIVIDADE DO COMPLEMENTO EM QUADROS FORMADORES DE IMUNOCOMPLEXOS CIRCULANTES ONDE OCORRE UM CONSUMO DOS COMPONENTES DO COMPLEMENTO. REFLETE A INTERAÇÃO SEQUENCIAL DE TODOS OS COMPONENTES DA VIA CLÁSSICA, MAIS A PORÇÃO COMUM DA CASCATA COM A VIA ALTERNATIVA." ]
  ], [
     fhir:index 311 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030075" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO DE FATOR REUMATÓIDE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE O FATOR REUMATÓIDE (FR) EM UM AUTO-ANTICORPO GERALMENTE DA CLASSE IGM, DIRIGIDO CONTRA O FRAGMENTO CRISTALIZÁVEL DA MOLÉCULA IGG. UTILIZADO CLASSICAMENTE NO DIAGNÓSTICO DA ARTRITE REUMATÓIDE." ]
  ], [
     fhir:index 312 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030083" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO QUANTITATIVA DE PROTEÍNA C REATIVA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA QUANTIFICAÇÃO DA PROTEÍNA C REATIVA, QUE É UMA DAS PROTEÍNAS DE FASE AGUDA, CONSIDERADA UM MARCADOR SENSÍVEL NO MONITORAMENTO DAS DOENÇAS INFLAMATÓRIAS E REUMÁTICAS EM GERAL." ]
  ], [
     fhir:index 313 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030091" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE ALFA-FETOPROTEINA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE ALFA-FETOPROTEÍNA, QUE É UMA IMPORTANTE GLICOPROTEÍNA DO PLASMA FETAL, PRODUZIDA EM GRANDES QUANTIDADES DURANTE A FASE EMBRIONÁRIA E TEM A SÍNTESE REDUZIDA RAPIDAMENTE APOS O NASCIMENTO. UTILIZADA COMO MARCADOR TUMORAL E NO ACOMPANHAMENTO DA GESTAÇÃO." ]
  ], [
     fhir:index 314 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030105" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE ANTIGENO PROSTATICO ESPECIFICO (PSA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE ANTÍGENO PROSTÁTICO ESPECIFICO (PSA), QUE É UMA PROTEASE PRODUZIDA QUASE EXCLUSIVAMENTE PELAS CÉLULAS EPITELIAIS DO TECIDO PROSTÁTICO. UTILIZADO NA AVALIAÇÃO DO CÂNCER DE PRÓSTATA, NA HIPERTROFIA PROSTÁTICA BENIGNA E NA PROSTATITE." ]
  ], [
     fhir:index 315 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030113" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE BETA-2-MICROGLOBULINA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE BETA-2-MICROGLOBULINA,QUE É UMA PROTEÍNA DE BAIXO PESO MOLECULAR PRESENTE NA SUPERFÍCIE DE TODAS AS CÉLULAS NUCLEADAS. UTILIZADO NA AVALIAÇÃO DAS DOENÇAS AUTOIMUNES, INFLAMATÓRIAS CRÔNICAS, DOENÇAS INFECCIOSAS E DOENÇAS LINFOPROLIFERATIVAS E MIELOPROLIFERATIVAS." ]
  ], [
     fhir:index 316 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030121" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE COMPLEMENTO C3" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA QUANTIFICAÇÃO DA FRAÇÃO C3, QUE É UM DOS COMPONENTES PRINCIPAIS DO SISTEMA COMPLEMENTO E ATUA NA RESPOSTA IMUNOLÓGICA HUMORAL E É ATIVADA PELA VIA CLÁSSICA E ALTERNATIVA. UTILIZADA NA AVALIAÇÃO DAS GLOMERULONEFRITES, LES E CRIOGLOBULINEMIA." ]
  ], [
     fhir:index 317 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030130" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE COMPLEMENTO C4" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA QUANTIFICAÇÃO DA FRAÇÃO C4, QUE É UM DOS COMPONENTES DO SISTEMA COMPLEMENTO, ATUA NA RESPOSTA IMUNOLÓGICA HUMORAL E PARTICIPA SOMENTE DA VIA CLÁSSICA DE ATIVAÇÃO. UTILIZADA NA AVALIAÇÃO DE ESTADOS INFLAMATÓRIOS, PROCESSOS MALIGNOS, NAS DOENÇAS POR IMUNOCOMPLEXOS E NAS DEFICIÊNCIAS CONGÊNITAS" ]
  ], [
     fhir:index 318 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030148" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE CRIOAGLUTININA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PESQUISA DE CRIOAGLUTININA. CONSISTE NA PESQUISA DE CRIOAGLUTININAS, QUE SÃO ANTICORPOS DA CLASSE IGM DIRIGIDOS CONTRA O ANTÍGENO I DA MEMBRANA ERITROCITÁRIA. UTILIZADA NA AVALIAÇÃO DAS PNEUMONIAS ATÍPICAS PRIMÁRIAS, ANEMIAS HEMOLÍTICAS E CIRROSES HEPÁTICAS." ]
  ], [
     fhir:index 319 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030156" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE IMUNOGLOBULINA A (IGA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE IMUNOGLOBULINA A, QUE CONSTITUI 15 A 20% DAS IMUNOGLOBULINAS SÉRICAS. COMPREENDE A MAIOR CLASSE DE ANTICORPOS EM SECREÇÕES, COMO SALIVA, LÁGRIMA,  LEITE, SECREÇÕES GASTROINTESTINAIS E DO TRATO RESPIRATÓRIO. UTILIZADA NA AVALIAÇÃO DAS INFECÇÕES CRÔNICAS, IMUNODEFICIÊNCIA PRIMÁRIA E MIELOMA MÚLTIPLO TIPO IGA." ]
  ], [
     fhir:index 320 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030164" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE IMUNOGLOBULINA E (IGE)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE IMUNOGLOBULINA E, IMUNOGLOBULINA QUE TEM UM PAPEL CENTRAL NA PATOGÊNESE DAS REAÇÕES DE HIPERSENSIBILIDADE IMEDIATA. UTILIZADA NA AVALIAÇÃO DAS REAÇÕES ALÉRGICAS, COMO RINITE ALÉRGICA, ASMA E DERMATITE ATÓPICA." ]
  ], [
     fhir:index 321 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030172" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE IMUNOGLOBULINA G (IGG)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE IMUNOGLOBULINA G, QUE É A PRINCIPAL IMUNOGLOBULINA PRODUZIDA PELAS CÉLULAS PLASMÁTICAS. UTILIZADA NA AVALIAÇÃO DA IMUNIDADE HUMORAL, MIELOMA DA CLASSE IGG, DOENÇAS AUTOIMUNES E INFECCIOSAS." ]
  ], [
     fhir:index 322 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202030180" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE IMUNOGLOBULINA M (IGM)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE IMUNOGLOBULINA M, QUE É A PRIMEIRA IMUNOGLOBULINA A SURGIR NA RESPOSTA IMUNOLÓGICA E A ÚNICA SINTETIZADA EM NEONATOS. UTILIZADA  NA AVALIAÇÃO DA IMUNIDADE HUMORAL, DIAGNÓSTICO E MONITORAMENTO DA TERAPIA DA MACROGLOBULINEMIA DE WALDENSTRÖM  OU DO MIELOMA DE CÉLULAS PLASMÁTICAS." ]
  ], [

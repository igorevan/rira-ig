     fhir:CodeSystem.concept.display [ fhir:value "DRENAGEM DO SACO ENDO-LINFATICO - SHUNT (C/ AUDICAO POR VIA TRANSMASTOIDEA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CIRURGIA REALIZADA ATRAVÉS DE ACESSO RETROAURICULAR VISANDO A  DESCOMPRESSÃO E DRENAGEM DO SACO ENDOLINFÁTICO PARA A MASTOIDE OU PARA O ESPAÇO SUBARACNÓIDEO,  PODENDO  SER REALIZADA COM OU SEM A UTILIZAÇÃO DE UM SHUNT,  COM O OBJETIVO DE DIMINUIR A PRESSÃO ENDOLINFÁTICA PERMITINDO O EQUILÍBRIO DA PRESSÃO ENTRE A  ENDOLINFA, A PERILINFA E O LIQUIDO CEFALORRAQUIDIANO, CONSERVANDO A AUDIÇÃO." ]
  ], [
     fhir:index 2133 ;

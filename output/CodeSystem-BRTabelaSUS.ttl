     fhir:CodeSystem.concept.display [ fhir:value "MATRICIAMENTO DE EQUIPES DOS OUTROS PONTOS E NÍVEIS DA REDE DE ATENÇÃO À SAÚDE PARA ATENÇÃO À SAÚDE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "MATRICIAMENTO DE EQUIPES DOS OUTROS PONTOS E NÍVEIS DA REDE DE ATENÇÃO À SAÚDE PARA ATENÇÃO À SAÚDE DAS PESSOAS COM DEFICIÊNCIA APOIO SISTEMÁTICO ÀS EQUIPES DOS OUTROS PONTOS DE ATENÇÃO DA REDE DE ATENÇÃO À SAÚDE, PARA ATENÇÃO À SAÚDE DAS PESSOAS COM DEFICIÊNCIA, POR MEIO DE DISCUSSÕES DE CASOS E DO PROCESSO DE TRABALHO, ATENDIMENTO COMPARTILHADO, AÇÕES INTERSETORIAIS NO TERRITÓRIO, E CONTRIBUA NO PROCESSO DE COGESTÃO E CORRESPONSABILIZAÇÃO NA CONDUÇÃO DO PROJETO TERAPÊUTICO SINGULAR, PODENDO SER REALIZADO À DISTÂNCIA POR MEIO DE TECNOLOGIA DA INFORMAÇÃO E COMUNICAÇÃO (TIC) UTILIZANDO MÉTODOS SÍNCRONOS." ]
  ], [

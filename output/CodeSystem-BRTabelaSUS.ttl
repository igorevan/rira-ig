     fhir:CodeSystem.concept.code [ fhir:value "0309050030" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "SESSÃO DE ELETROESTIMULAÇÃO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "TÉCNICA TERAPÊUTICA QUE CONSISTE NA APLICAÇÃO DE AGULHAS CONECTADAS A ELETRODOS, TRANSMITINDO ESTÍMULOS ELÉTRICOS DE BAIXA FREQUÊNCIA NOS PONTOS DE ACUPUNTURA. A ELETROESTIMULAÇÃO É OBTIDA POR ESTÍMULOS ELÉTRICOS COM FORMATOS DE ONDA ESPECÍFICOS, DE FREQUÊNCIA VARIÁVEL DE 1 HZ A 1.000 HZ, DE BAIXA VOLTAGEM E BAIXA AMPERAGEM, PRODUZIDOS POR APARELHO PRÓPRIO, QUE, NA MEDICINA TRADICIONAL CHINESA, SÃO APLICADOS NAS ZONAS NEURORREATIVAS DE ACUPUNTURA POR MEIO DE INTENSO RELAXAMENTO, CONCENTRAÇÃO E/OU FOCO, INDUZ A PESSOA A ALCANÇAR UM ESTADO DE CONSCIÊNCIA AUMENTADO QUE PERMITA ALTERAR UMA AMPLA GAMA DE CONDIÇÕES OU COMPORTAMENTOS INDESEJADOS COMO MEDOS, FOBIAS, INSÔNIA, DEPRESSÃO, ANGÚSTIA, ESTRESSE, DORES CRÔNICAS." ]
  ], [
     fhir:index 1938 ;
     fhir:CodeSystem.concept.code [ fhir:value "0309050049" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "SESSÃO DE AURICULOTERAPIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "TÉCNICA TERAPÊUTICA QUE PROMOVE A REGULAÇÃO PSÍQUICO-ORGÂNICA DO INDIVÍDUO POR MEIO DE ESTÍMULOS NOS PONTOS ENERGÉTICOS LOCALIZADOS NA ORELHA – ONDE TODO O ORGANISMO SE ENCONTRA REPRESENTADO COMO UM MICROSSISTEMA. A ACUPUNTURA AURICULAR OU AURICULOTERAPIA ESTIMULA AS ZONAS NEURORREATIVAS POR MEIO DE AGULHAS, ESFERAS DE AÇO, OURO, PRATA, PLÁSTICO, OU SEMENTES DE MOSTARDA, PREVIAMENTE PREPARADAS PARA  ESSE FIM." ]
  ], [
     fhir:index 1939 ;
     fhir:CodeSystem.concept.code [ fhir:value "0309050057" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "SESSÃO DE MASSOTERAPIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PRÁTICA TERAPÊUTICA QUE ENVOLVE A APLICAÇÃO DE TÉCNICAS MANUAIS SOBRE OS TECIDOS EXTERNOS DO CORPO VISANDO MELHORAR O FUNCIONAMENTO DO ORGANISMO COMO UM TODO, EM DECORRÊNCIA DA COMBINAÇÃO DE FATORES MECÂNICOS, FISIOLÓGICOS E PSICOLÓGICOS. OS BENEFÍCIOS DA MASSOTERAPIA VÃO ALÉM DO RELAXAMENTO, COM EFEITOS BENÉFICOS DE GRANDE INFLUÊNCIA SOBRE O ORGANISMO, NO ÂMBITO MECÂNICO, NEURAL, FISIOLÓGICO E QUÍMICO, QUE SE RELACIONAM ENTRE SI E COM FATORES EMOCIONAIS. REPRESENTA UMA MANIFESTAÇÃO DE ATENÇÃO, HUMANIZAÇÃO E CUIDADO EM SAÚDE, PROPORCIONANDO EFEITOS FISIOLÓGICOS COMPATÍVEIS COM AS NECESSIDADES DO INDIVÍDUO." ]
  ], [
     fhir:index 1940 ;
     fhir:CodeSystem.concept.code [ fhir:value "0309050065" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO TERMAL/CRENOTERÁPICO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ATENDIMENTO INTEGRATIVO E COMPLEMENTAR QUE ADOTA O TERMALISMO COMO PRÁTICA TERAPÊUTICA PELAS ÁGUAS MINERAIS COM PROPRIEDADES MEDICINAIS, DE MODO PREVENTIVO OU CURATIVO, EM COMPLEMENTO A OUTROS TRATAMENTOS DE SAÚDE." ]
  ], [
     fhir:index 1941 ;
     fhir:CodeSystem.concept.code [ fhir:value "0309050073" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO NATUROPÁTICO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ATENDIMENTO INTEGRATIVO E COMPLEMENTAR QUE ADOTA VISÃO AMPLIADA E MULTIDIMENSIONAL DO PROCESSO VIDA-SAÚDE-DOENÇA E UTILIZA UM CONJUNTO DE PRÁTICAS INTEGRATIVAS E COMPLEMENTARES NO CUIDADO E NA ATENÇÃO EM SAÚDE. ENVOLVE CONHECIMENTOS DIVERSOS, COMO AROMATERAPIA, TERAPIA DE FLORAIS, CROMOTERAPIA, DIETOTERAPIA, GEOTERAPIA, ENTRE OUTROS." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "TREINAMENTO DE PACIENTE SUBMETIDO A DIALISE PERITONEAL - DPAC-DPA (9 DIAS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NAS ORIENTACOES FORNECIDAS PELO(A) ENFERMEIRO (A) DURANTE O TREINAMENTO DE PACIENTE SUBMETIDO A DPA/DPAC EM RELACAO AS TECNICAS DE ASSEPSIA E USO CORRETO DE MATERIAIS  E EQUIPAMENTOS UTLIZALAOS NESTAS MODALIDADES DE TRATAMENTO DIALITICO" ]
  ], [

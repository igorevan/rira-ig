  ], [
     fhir:index 1288 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080020" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ACOLHIMENTO NOTURNO DE PACIENTE EM CENTRO DE ATENÇÃO PSICOSSOCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "AÇÃO DE HOSPITALIDADE NOTURNA REALIZADA NOS CAPS COMO RECURSO DO PROJETO TERAPÊUTICO SINGULAR, DE USUÁRIOS JÁ EM ACOMPANHAMENTO NO SERVIÇO, QUE RECORRE AO AFASTAMENTO DO USUÁRIO DAS SITUAÇÕES CONFLITUOSAS, VISANDO AO MANEJO DE SITUAÇÕES DE CRISE MOTIVADAS POR SOFRIMENTOS DECORRENTES DE TRANSTORNOS MENTAIS, INCLUÍDOS AQUELES POR USO DE DROGAS, E QUE ENVOLVEM CONFLITOS RELACIONAIS CARACTERIZADOS POR RUPTURAS FAMILIARES, COMUNITÁRIAS, LIMITES DE COMUNICAÇÃO E/OU IMPOSSIBILIDADES DE CONVIVÊNCIA, OBJETIVANDO A RETOMADA, RESGATE, REDIMENSIONAMENTO DAS RELAÇÕES INTERPESSOAIS, O CONVÍVIO FAMILIAR E/OU COMUNITÁRIO. NÃO DEVE EXCEDER O MÁXIMO DE 14 DIAS." ]
  ], [
     fhir:index 1289 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301080038" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ACOLHIMENTO EM TERCEIRO TURNO DE PACIENTE EM CENTRO DE ATENÇÃO PSICOSSOCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO CONJUNTO DE ATENDIMENTOS DESENVOLVIDOS, NO PERIODO COMPREENDIDO ENTRE 18 E 21 HORAS." ]
  ], [
     fhir:index 1290 ;

     fhir:CodeSystem.concept.definition [ fhir:value "REGISTRO DA ATIVIDADE ELÉTRICA CEREBRAL EM VIGÍLIA E SONO ESPONTÂNEO OU INDUZIDO POR MEDICAMENTO, POR NO MÍNIMO 30 MINUTOS." ]
  ], [

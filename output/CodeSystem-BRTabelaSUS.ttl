     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO COM A FINALIDADE DE ESTABELECER A EXTENSÃO DE NEOPLASIA MALIGNA OPERÁVEL E RESSECÁVEL, COM VISTA AO TRATAMENTO CIRÚRGICO DE LESÕES INTRA-ABDOMINAIS INVASIVAS OU MAL DEFINIDAS (LESÕES CONTIGUAS QUE ACOMETEM UM MESMO ÓRGÃO OU ÓRGÃOS CONTÍGUOS OU LESÕES MÚLTIPLAS EM UM MESMO ÓRGÃO OU EM DIFERENTES ÓRGÃOS/ESTRUTURAS). NÃO SE APLICA A BIOPSIA(S) DE NEOPLASIA MALIGNA INOPERÁVEL OU IRRESSECÁVEL. EXCLUDENTE COM A LAPAROTOMIA PARA AVALIAÇÃO DE TUMOR DE OVÁRIO. INCLUI INTERVENÇÃO(ÕES) CIRÚRGICA(S) TERAPÊUTICA(S)." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "MEDIÇÃO DE ALTURA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA MEDIÇÃO DA ALTURA CORPORAL, POR MEIO DE EQUIPAMENTOS APROPRIADOS, EM CENTÍMETROS." ]
  ], [

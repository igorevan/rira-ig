     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICACAO DE DOADOR VIVO DE RIM 1A FASE (POR DOADOR TIPADO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO DE HLA-A, B - CLASSE I, POR SOROLOGIA OU POR TESTE MOLECULAR COM TECNICAS DE BAIXA RESOLUCAO POR DNA. ESSE EXAME DEVERA SER AUTORIZADO EM GRUPO DE ATE 04 PESSOAS." ]
  ], [
     fhir:index 3681 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501040048" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICACAO DE DOADOR VIVO DE RIM 2A FASE (POR DOADOR TIPADO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO DE HLA-DR - CLASSE II, POR SOROLOGIA OU POR TESTE MOLECULAR DE BAIXA RESOLUCAO POR DNA. O EXAME PREVISTO NA SEGUNDA FASE  DEVERA SER REALIZADO EM UM UNICO DOADOR QUE JA TENHA SIDO CONSIDERADO COMPATIVEL NA PRIMEIRA FASE. NO CASO DE HAVER APENAS UM CANDIDATO A DOADOR, PODERA SER AUTORIZADA A REALIZACAO SIMULTANEA DAS FASES PRIMEIRA E SEGUNDA." ]
  ], [
     fhir:index 3682 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501040056" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PROVA CRUZADA EM DOADOR VIVO CONTRA LINFOCITOS T OU B C/ ABSORCAO DE PLAQUETAS (CROSS MATCH)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZACAO DE PROVA CRUZADA CONTRA LINFOCITOS T OU B COM ABSORCAO DE PLAQUETAS PARA A DETERMINACAO DE ANTICORPOS CONTRA A CLASSE I DO HLA. ESTE EXAME DEVERA SER REALIZADO APENAS NO DOADOR VIVO QUE TIVER PROVA CRUZADA PARA LINFOCITOS B  OU T POSITIVA." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "ATENDIMENTO EM PSICOTERAPIA DE GRUPO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO ATENDIMENTO EM GRUPO (NO MÍNIMO 05 E NO MÁXIMO 15 PACIENTES) REALIZADO POR PROFISSIONAL DE SAÚDE MENTAL DE ACORDO COM PROJETO TERAPÊUTICO ESPECÍFICO. DESTINA-SE PARTICULARMENTE AOS PACIENTES COM OS CHAMADOS TRANSTORNOS MENTAIS MENORES." ]
  ], [

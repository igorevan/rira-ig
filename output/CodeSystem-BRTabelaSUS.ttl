  ], [
     fhir:index 4633 ;
     fhir:CodeSystem.concept.code [ fhir:value "0702040614" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "STENT FARMACOLÓGICO PARA ARTERIA CORONARIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "DISPOSITIVO TUBULAR ESTÉRIL , STENT, CONCEBIDO PARA SER IMPLANTADO NUMA ARTÉRIA CORONÁRIA PARA MANTER A SUA DESOBSTRUÇÃO E AUMENTAR O DIÂMETRO DO SEU LÚMEN COM ELUIÇÃO DE FÁRMACOS PARA USO NAS INTERVENÇÕES ENDOVASCULARES CARDÍACAS EM PACIENTES DIABÉTICOS E EM PACIENTES COM LESÕES EM VASOS FINOS (LESÕES DE CALIBRE INFERIOR A 2,5MM E EXTENSÃO MAIOR DO QUE 18MM)." ]
  ], [

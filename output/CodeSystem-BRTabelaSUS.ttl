     fhir:CodeSystem.concept.display [ fhir:value "PROSTATECTOMIA SUPRAPÚBICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO CIRÚRGICO QUE CONSISTE NA REMOÇÃO PARCIAL (CENTRAL) DA PRÓSTATA (ADENECTOMIA), PERMANECENDO A CAPSULA PROSTÁTICA. INDICADA EM CASOS DE HIPERPLASIA BENIGNA, EM PRÓSTATA COM PESO ESTIMADO ACIMA DE 80 GRAMAS E QUE ALTERA O PADRÃO MICCIONAL, OCASIONANDO OBSTRUÇÃO DO FLUXO URINÁRIO. COM O OBJETIVO DE MELHORAR O FLUXO URINÁRIO OU MESMO DISPENSAR O USO DE SONDA VESICAL DE DEMORA. APLICÁVEL TAMBÉM A PROSTATECTOMIA POR CÂNCER DE PRÓSTATA." ]

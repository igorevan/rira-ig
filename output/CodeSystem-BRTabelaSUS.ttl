     fhir:CodeSystem.concept.definition [ fhir:value "INSTALACAO DE DISPOSITIVO HIDRICO, FIXADO A UM CATETER VENOSO CENTRAL, PARA MEDIR E REGISTRAR A PRESSAO SANGUINEA NAS GRANDES VEIAS DO CORPO." ]
  ], [

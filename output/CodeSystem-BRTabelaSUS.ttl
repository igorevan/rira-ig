     fhir:CodeSystem.concept.display [ fhir:value "HEMIPELVECTOMIA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "DESARTICULAÇÃO INTERILIOABDOMINAL PARCIAL OU TOTAL, INTERNA OU NÃO, INCLUINDO OSSOS DA PELVE COM OU SEM PRESERVAÇÃO DO MEMBRO INFERIOR POR NEOPLASIA MALIGNA OU POR TUMOR INCERTO SE BENIGNO OU MALIGNO. ADMITE PROCEDIMENTO SEQUENCIAL." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO DE ANEMIA APLASTICA E OUTRAS ANEMIAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "TRATAMENTO CLÍNICO QUE VISA SOLUCIONAR O PRINCIPAL PROBLEMA DA ASSISTÊNCIA HOSPITALAR DO PACIENTE COM O FOCO NA PATOLOGIA RESPONSÁVEL PELA INTERNAÇÃO INICIAL OU EM PATOLOGIA SUPERVENIENTE DE MAIOR GRAVIDADE OU COMPLEXIDADE QUE DETERMINAM OS CUIDADOS DE SAÚDE APROPRIADOS AO ATENDIMENTO AO PACIENTE EM CIRCUNSTÂNCIAS CLÍNICAS ESPECÍFICAS. NESTE CASO, A ANEMIA APLÁSTICA OU APLÁSICA É O RESULTADO DA DIMINUIÇÃO SIMULTÂNEA DO NÚMERO DE HEMÁCIAS E LEUCÓCITOS DO SANGUE OU PANCITOPENIA DECORRENTE DA DIMINUIÇÃO DA HEMATOPOIESE, OU SEJA, DO PROCESSO DE PRODUÇÃO DE CÉLULAS SANGUÍNEAS. ESSA DISFUNÇÃO PODE TER ORIGEM CONGÊNITA, IDENTIFICADA NO NASCIMENTO OU NOS PRIMEIROS MESES DE VIDA DO INDIVÍDUO, OU ORIGEM ADQUIRIDA, COMO USO DE ALGUNS TIPOS DE MEDICAMENTOS, DOENÇAS AUTOIMUNES, INFECÇÕES VIRAIS E EXPOS" ]
  ], [

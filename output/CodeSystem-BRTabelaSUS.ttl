     fhir:CodeSystem.concept.display [ fhir:value "RETOSSIGMOIDECTOMIA ABDOMINAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA DE TODO O SIGMOIDE E RESSECÇÃO PARCIAL OU TOTAL DO RETO EM CASO DE TUMOR MALIGNO DO RETOSSIGMOIDE. ADMITE PROCEDIMENTO(S) SEQUENCIAL(AIS). AOS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO SOMAM-SE O GRAMPEADOR E CARGA EM CASO DE METASTASECTOMIA HEPÁTICA COMO PROCEDIMENTO SEQUENCIAL. A PEÇA CIRÚRGICA PODE SER LIVRE DE NEOPLASIA MALIGNA NO RETO." ]
  ], [
     fhir:index 3595 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416050093" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXENTERAÇÃO PÉLVICA POSTERIOR EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TUMOR MALÍGNO DO RETO E ÓRGÃOS GENITAIS INTERNOS, COM OU  SEM PRESERVAÇÃO DO ÂNUS. INCLUI CISTECTOMIA PARCIAL, HISTERECTOMIA TOTAL,  ANEXECTOMIA UNI/BILATERAL, PROSTATOVESICULECTOMIA, ENTERECTOMIA OU, EM  CASO DE AMPUTAÇÃO DO ÂNUS, COLOSTOMIA OU ILEOSTOMIA DEFINITIVA. A PEÇA  CIRÚRGICA PODE CONTER TUMOR INCERTO SE BENIGNO OU MALIGNO OU SER LIVRE  DE NEOPLASIA MALÍGNA. ADMITE PROCEDIMENTO (S) SEQUENCIAL (AIS). A ILEOSTOMIA  É DE PROTEÇÃO." ]
  ], [
     fhir:index 3596 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416050107" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXENTERACAO PELVICA TOTAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TUMOR MALIGNO DE LOCALIZAÇÃO PÉLVICA, COM RETIRADA DE ÓRGÃOS GENITAIS INTERNOS, CISTECTOMIA TOTAL COM DERIVAÇÃO SIMPLES E COLOSTOMIA OU ILEOSTOMIA. A PEÇA CIRÚRGICA PODE CONTER TUMOR INCERTO SE BENIGNO OU MALIGNO OU SER LIVRE DE NEOPLASIA MALIGNA. ADMITE PROCEDIMENTO(S) SEQUENCIAL(AIS). A ILEOSTOMIA É DE PROTEÇÃO." ]
  ], [
     fhir:index 3597 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416050115" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PROCTOCOLECTOMIA TOTAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO TOTAL DO INTESTINO GROSSO E RETO POR TUMOR MALIGNO OU INCERTO SE BENIGNO OU MALIGNO PODENDO SER PRESERVADO O CANAL ANAL. INCLUI  O RESERVATÓRIO ILEAL. ADMITE PROCEDIMENTO(S) SEQUENCIAL (AIS). AOS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO, SOMAM-SE O GRAMPEADOR E CARGA EM CASO DE METASTASECTOMIA HEPÁTICA COMO PROCEDIMENTO SEQUENCIAL." ]
  ], [
     fhir:index 3598 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060013" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AMPUTACAO CONICA DE COLO DE UTERO C/ COLPECTOMIA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DO COLO UTERINO E DE PARTE SUPERIOR DA VAGINA POR CARCINOMA DO COLO UTERINO (IN SITU OU INVASIVO EM ESTÁGIO INICIAL)." ]
  ], [
     fhir:index 3599 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060021" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ANEXECTOMIA UNI / BILATERAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE UM OU AMBOS OS OVÁRIOS COM OU SEM RESSECÇÃO DE UMA OU AMBAS AS TUBAS UTERINAS POR TUMOR MALIGNO PRIMÁRIO, SECUNDÁRIO OU DE COMPORTAMENTO INCERTO SE BENIGNO OU MALIGNO DE OVÁRIO OU DE TUBA UTERINA." ]
  ], [
     fhir:index 3600 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060030" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "COLPECTOMIA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO PARCIAL OU TOTAL DE VAGINA POR TUMOR MALIGNO. ADMITE PROCEDIMENTO(S) SEQUENCIAL(AIS)." ]
  ], [
     fhir:index 3601 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060056" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "HISTERECTOMIA C/ RESSECCAO DE ORGAOS CONTIGUOS EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DO ÚTERO E ANEXO(S) MAIS APÊNDICE CECAL, PARTE DE BEXIGA OU SEGMENTO INTESTINAL POR TUMOR MALIGNO DE ÓRGÃO GENITAL FEMININO. ADMITE COMO PROCEDIMENTO(S) SEQUENCIAL(AIS) A LINFADENECTOMIA PÉLVICA, INGUINO-ILÍACA OU RETROPERITONEAL." ]
  ], [
     fhir:index 3602 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060064" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "HISTERECTOMIA TOTAL AMPLIADA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "REMOÇÃO DO ÚTERO POR TUMOR MALIGNO COM RESSECÇÃO DO TERÇO SUPERIOR DE VAGINA, PARAMÉTRIOS E LIGAMENTOS COM OU SEM ANEXECTOMIA UNI OU BILATERAL. INCLUI LINFADENECTOMIA." ]
  ], [
     fhir:index 3603 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416060080" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRAQUELECTOMIA RADICAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "REMOÇÃO DO COLO UTERINO E PARAMÉTRIOS COM PRESERVAÇÃO DO CORPO UTERINO POR TUMOR  INSITU, MALIGNO OU INCERTO SE MALIGNO OU BENIGNO DO COLO UTERINO. INCLUI LINFADENECTOMIA PÉLVICA INDICADA EM CASO DE MULHERES (1) QUE DESEJAM ENGRAVIDAR, (2) COM CÂNCER DO COLO DO UTERO , COM HISTERECTOMIA SUB-TOTAL PRÉVIA; (3) TUMOR COM < 2CM; (4) AUSÊNCIA DE INVASÃO LINFOVASCULAR; E (5) LINFONODO NEGATIVO." ]
  ], [

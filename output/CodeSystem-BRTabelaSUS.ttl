     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE INIBIDOR DE C1-ESTERASE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DOSAGEM DE INIBIDOR DA C1-ESTERASE, QUE É UM BLOQUEADOR DA ATIVAÇÃO DA PRÓ-ENZIMA C1 PARA SUA FORMA ATIVA. UTILIZADO NO DIAGNÓSTICO E AVALIAÇÃO DE ANGIOEDEMA." ]
  ], [

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA PESQUISA E TITULACAO DE ANTICORPOS ANTI A  E  ANTI B DE CLASSE IGM E IGG PRINCIPALMENTE. O PROCEDIMENTO ESTA EM GERAL INDICADO PARA AVALIACAO DA  ALOIMUNIZACAO MATERNA  A ANTIGENOS DO SISTEMA ABO DE GRUPOS SANGUINEOS. O VALOR DO PROCEDIMENTO INCLUI OS INSUMOS NECESSARIOS A SUA EXECUCAO" ]

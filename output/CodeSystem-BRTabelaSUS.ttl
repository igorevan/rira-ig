     fhir:CodeSystem.concept.display [ fhir:value "TURBINECTOMIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO CIRÚRGICO PARA REDUÇÃO DO VOLUME DOS CORNETOS NASAIS, TAMBÉM CONHECIDOS COMO CONCHAS NASAIS. EXISTEM NO NARIZ CERCA DE TRÊS CORNETOS DE CADA LADO (SUPERIOR, MÉDIO E INFERIOR). PODE SER REALIZADO EM CONJUNTO COM OUTROS TIPOS DE CIRURGIA COMO SEPTOPLASTIA." ]

     fhir:CodeSystem.concept.display [ fhir:value "AUTO-PROVA CRUZADA EM RECEPTOR DE RIM (AUTO CROSS-MATCH)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZACAO DE PROVA CRUZADA PARA A DETERMINACAO DE AUTO ANTICORPOS. DEVERA SER REALIZADA APENAS NAQUELE DOADOR QUE TIVER PROVA CRUZADA PARA LINFOCITOS B E  OU T POSITIVA" ]
  ], [
     fhir:index 3679 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501040021" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICACAO DE DOADOR FALECIDO DE RIM / PANCREAS E RIM-PANCREAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO DE HLA-A, B - CLASSE I, POR SOROLOGIA OU POR TESTE MOLECULAR COM TECNICAS DE BAIXA RESOLUCAO POR DNA E TIPIFICACAO DE HLA-DR - CLASSE II, POR SOROLOGIA OU POR TESTE MOLECULAR COM TECNICAS DE BAIXA RESOLUCAO POR DNA. ESSES DOIS EXAMES DEVERAO SER REALIZADOS NOS DOADORES CADAVERES, APENAS NAQUELES ESTADOS EM QUE A DISTRIBUICAO DOS ORGAOS ESTEJA SENDO FEITA POR HLA." ]
  ], [
     fhir:index 3680 ;

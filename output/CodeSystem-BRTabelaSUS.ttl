     fhir:CodeSystem.concept.display [ fhir:value "AVALIACAO CINEMATICA E DE PARAMETROS LINEARES" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO DE INFORMACOES ANGULARES QUANTO AO MOVIMENTO TRIDIMENSIONAL DA MARCHA" ]
  ], [
     fhir:index 945 ;

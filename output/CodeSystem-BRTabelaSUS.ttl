  ], [
     fhir:index 3688 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501050019" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO DE REATIVIDADE DO RECEPTOR CONTRA PAINEL EM RECEPTORES HIPERSENSIBILIZADOS DE ÓRGÃOS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZAÇÃO DE REATIVIDADE CONTRA PAINEL HLA - CLASSE I OU CLASSE II, COM CARACTERIZAÇÃO DO ANTICORPO ANTI-HLA PARA OS RECEPTORES DE ÓRGÃOS E  RECEPTORES DE TCTH COM DOADOR SEM IDENTIDADE HLA TOTAL. PERMITIDO ATÉ 4 VEZES AO ANO E APÓS UM EVENTO SENSIBILIZAÇÃO." ]
  ], [
     fhir:index 3689 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501050027" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICACAO DE RECEPTOR DE RIM / PANCREAS E RIM-PANCREAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO DE HLA-A, B - CLASSE I, POR SOROLOGIA OU POR TESTE MOLECULAR COM TECNICAS DE BAIXA RESOLUCAO POR DNA E TIPIFICACAO DE HLA-DR - CLASSE II, POR SOROLOGIA OU POR TESTE MOLECULAR COM TECNICA DE BAIXA RESOLUCAO POR DNA. OS DOIS EXAMES PREVISTOS NESTE PROCEDIMENTO DEVERAO SER REALIZADOS EM TODOS OS CANDIDATOS A TRANSPLANTE RENAL, TRANSPLANTE DE PANCREAS E TRANSPLANTE DE RIM-PANCREAS INSCRITOS NAS LISTAS UNICAS DOS ESTADOS." ]
  ], [

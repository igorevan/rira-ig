     fhir:CodeSystem.concept.display [ fhir:value "IMPLANTE COCLEAR" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA IMPLANTAÇÃO CIRÚRGICA UNILATERAL DE FEIXE DE ELETRODOS POSICIONADO DENTRO DA CÓCLEA COM OBJETIVO DE SUBSTITUIR PARCIALMENTE AS FUNÇÕES DA ORELHA INTERNA (CÓCLEA), TRANSFORMANDO OS SINAIS SONOROS EM SINAIS ELÉTRICOS." ]
  ], [

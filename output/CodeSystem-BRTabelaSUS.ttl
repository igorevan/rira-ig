     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CONTAGEM E MONITORAMENTO DAS POPULAÇÕES DE LINFÓCITOS B EM DOENÇAS AUTOIMUNES, IMUNODEFICIÊNCIAS, INFECÇÕES VIRAIS E EM SÍNDROMES LINFOPROLIFERATIVAS." ]
  ], [

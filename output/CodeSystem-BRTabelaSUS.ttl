     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA INCISÃO DE LESÃO CIRCUNSCRITA, AGUDA, PURULENTA, LIMITADA A PELE E TECIDO CELULAR SUBCUTÂNEO DO CONDUTO AUDITIVO EXTERNO." ]
  ], [
     fhir:index 2132 ;

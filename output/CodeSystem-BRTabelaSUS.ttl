     fhir:CodeSystem.concept.definition [ fhir:value "PRÁTICA TERAPÊUTICA QUE UTILIZA AS CORES DO ESPECTRO SOLAR – VERMELHO, LARANJA, AMARELO, VERDE, AZUL, ANIL E VIOLETA – PARA RESTAURAR O EQUILÍBRIO FÍSICO E ENERGÉTICO DO CORPO." ]
  ], [

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA REALIZADA PELA VIA COMBINADA ABDOMINO-PERINEAL,PARA A RETIRADA DE TODO O SIGMOIDE E RESSECÇÃO PARCIAL OU TOTAL DO RETO E REALIZA-SE A UNIÃO DO CÓLON ESQUERDO OU DESCENDENTE AO RETO" ]
  ], [
     fhir:index 2714 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020420" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE ANOMALIAS CONGÊNITAS DO ÂNUS E RETO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA REALIZADA PARA CORREÇÃO DE ANOMALIAS CONGÊNITAS DO RETO E ÂNUS, SENDO A MAIS COMUM A ATRESIA DO ÂNUS." ]
  ], [
     fhir:index 2715 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020438" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE AUSÊNCIA DO RETO (ABDOMINO-PERINEAL)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA REALIZADA PARA RECOMPOR O RETO DEVIDO À SUA AUSÊNCIA AO NASCIMENTO. EM GERAL, ASPECTO DO ÂNUS É NORMAL, HAVERÁ AUSÊNCIA DE ELIMINAÇÃO DE MECÔNIO, DISTENSÃO ABDOMINAL E VÔMITOS BILIOSOS, DEPOIS FECALÓIDES, CONFIGURANDO PROCESSO OBSTRUTIVO BAIXO." ]
  ], [
     fhir:index 2716 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020446" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE ILEO MECONIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA REALIZADA PARA TRATAR A OBSTRUÇÃO CAUSADA PELO ÍLEO MECONIAL, DIAGNOSTICADA DIAS APÓS O NASCIMENTO, QUANDO O TRATAMENTO COM ENEMA PARA LIQUEFAZER E REMOVER O MECÔNIO ANORMAL NÃO DER RESULTADO," ]
  ], [
     fhir:index 2717 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020454" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE IMPERFURAÇÃO MEMBRANOSA DO ÂNUS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA REALIZADA PARA RECONSTRUÇÃO OU DESCOMPRESSÃO DO ÂNUS, PODENDO EXIGIR URGÊNCIA OU NÃO, AVALIANDO SE O PACIENTE DEVE PASSAR POR CIRURGIA DE CORREÇÃO LOGO APÓS O NASCIMENTO, SEM A NECESSIDADE DE COLOSTOMIA OU DEFINIR A REALIZAÇÃO DE COLOSTOMIA, SENDO A CIRURGIA DEFINITIVA RETARDADA." ]
  ], [
     fhir:index 2718 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020462" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE MÁ ROTAÇÃO INTESTINAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA PARA CORREÇÃO DE EMERGÊNCIA DA MÁ ROTAÇÃO INTESTINAL COM LISE DAS BRIDAS RETROPERITONEAIS E REPARAÇÃO DO VÓLVULO MESOGÁSTRICO, PODE SER FEITA POR LAPAROSCOPIA OU COMO UM PROCEDIMENTO ABERTO." ]
  ], [
     fhir:index 2719 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020470" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRÚRGICO DE PROLAPSO ANAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CIRURGIA PARA CORREÇÃO DO PROLAPSO RETAL, QUE PODE SER FEITA POR DIVERSAS TÉCNICAS: ESTREITAMENTO DO ORIFÍCIO ANAL, RESTAURAÇÃO DO ASSOALHO PÉLVICO QUE CONSISTE NA PLICATURA DOS MÚSCULOS ELEVADORES DO ÂNUS, PODENDO SER PELA VIA TRANSABDOMINAL OU PERINEAL. RESSECÇÃO INTESTINAL, SUSPENSÃO OU FIXAÇÃO DO RETO. ALGUMAS DESSAS TÉCNICAS PODEM SER PELA VIA VIDEOLAPAROSCÓPICA. OU AINDA, COMBINAÇÕES DE DOIS OU MAIS DOS MÉTODOS ANTERIORES." ]
  ], [
     fhir:index 2720 ;
     fhir:CodeSystem.concept.code [ fhir:value "0407020489" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRURGICO DE PRURIDO ANAL" ]

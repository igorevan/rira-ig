     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM UNIFICAR RAMOS DA ARTÉRIA PULMONAR, CONGENITAMENTE MALFORMADOS, EM UM RAMO ÚNICO PARA MELHORAR O APORTE DE SANGUE PARA O PULMÃO. É NECESSÁRIA A CIRCULAÇÃO EXTRA-CORPÓREA NOS CASOS EM QUE A OXIGENAÇÃO DO SANGUE É MUITO BAIXA." ]
  ], [

     fhir:CodeSystem.concept.code [ fhir:value "0416050018" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AMPUTACAO ABDOMINO-PERINEAL DE RETO EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TODO O RETO, ANUS E PARTE DO SIGMOIDE COM ACESSO COMBINADO POR LAPAROTOMIA E VIA PERINEAL POR TUMOR MALIGNO DE RETO, ANUS OU CANAL ANAL. INCLUI COLOSTOMIA. A PEÇA CIRÚRGICA PODE SER LIVRE DE NEOPLASIA MALIGNA NO RETO. ADMITE PROCEDIMENTO(S) SEQUENCIAL(AIS). AOS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO SOMAM-SE O GRAMPEADOR E CARGA EM CASO DE METASTASECTOMIA HEPÁTICA COMO PROCEDIMENTO SEQUENCIAL." ]
  ], [

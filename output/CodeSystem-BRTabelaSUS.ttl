     fhir:CodeSystem.concept.display [ fhir:value "APLICAÇÃO DE CARIOSTÁTICO (POR DENTE)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ATIVIDADE COM FINALIDADE TERAPEUTICA E  CONTROLE DE UM OU MAIS DENTES COM LESOES DE CARIE." ]
  ], [
     fhir:index 9 ;
     fhir:CodeSystem.concept.code [ fhir:value "0101020066" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "APLICAÇÃO DE SELANTE (POR DENTE)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "APLICAÇÃO DE MATERIAL SELADOR POR DENTE EM PONTOS, SULCOS E FISSURAS, REALIZADA COM FINALIDADE PREVENTIVA DAS LESÕES DE CÁRIE." ]
  ], [
     fhir:index 10 ;
     fhir:CodeSystem.concept.code [ fhir:value "0101020074" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "APLICAÇÃO TÓPICA DE FLÚOR (INDIVIDUAL POR SESSÃO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "APLICAÇÃO TÓPICA DE FLÚOR NA FORMA DE GEL COM CONCENTRAÇÃO DE 1,23  OU NA FORMA DE VERNIZ, PODENDO USAR PINCÉIS, ESCOVA DENTAL, MOLDEIRA E OUTRAS FORMAS DE APLICAÇÕES, COM A FINALIDADE DE PREVENIR E/OU  REMINERALIZAR OS DENTES COM OU SEM LESÕES. O NUMERO DE SESSÕES DEVE SER DEFINIDO SEGUNDO PADRÕES TÉCNICO CIENTÍFICO DE ABORDAGEM DO CASO E DO ACOMPANHAMENTO DO PROFISSIONAL AOS PROGRAMAS LOCAIS." ]
  ], [

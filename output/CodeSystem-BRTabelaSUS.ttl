     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO DE FUNÇÃO E MECÂNICA RESPIRATÓRIA COM TRANSDUTORES MICROPROCESSADOS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA CONSULTA COM AVALIACAO DE FUNCAO E MECANICA RESPIRATORIA C/ TRANSDUTORES MICROPROCESSADOS." ]
  ], [
     fhir:index 949 ;
     fhir:CodeSystem.concept.code [ fhir:value "0211030066" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO DE MOVIMENTO (POR IMAGEM)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO DE INFORMACOES QUANTO AO MOVIMENTO DE MARCHA E ATIVIDADES DE VIDA DIARIA ATRAVES DO PROCESSAMENTO DE IMAGENS." ]
  ], [
     fhir:index 950 ;
     fhir:CodeSystem.concept.code [ fhir:value "0211030074" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "AVALIAÇÃO FUNCIONAL MUSCULAR" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO DE INFORMACOES DA FUNCAO MUSCULAR ATRAVES DE RECURSOS CLINICOS: PERIMETRIA, TESTE MUSCULAR, AVALIACAO DE AMPLITUDE ARTICULAR, AMPLITUDE DE MOVIMENTO( ADM)." ]
  ], [

  ], [
     fhir:index 4431 ;
     fhir:CodeSystem.concept.code [ fhir:value "0702010197" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "MICROBALAO DE REMODELAGEM" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "MICROCATETER COM BALÃO NÃO DESTACÁVEL NA PONTA DISTAL; BALÃO COMPLACENTE INDICADO PARA TÉCNICA DE REMODELAMENTO EM ANEURISMAS DE COLO LARGO LOCALIZADOS NO SIFÃO CAROTÍDEO; PODE SER AINDA UTILIZADO PARA TRATAMENTO DE VASOESPASMOS E TESTE DE OCLUSÃO; BALÃO DE LÚMEN ÚNICO, COMPATÍVEL COM MICROGUIA 0.012¿¿;  POSSUI ANÉIS RADIOPACOS PARA INDICAR A EXTREMIDADE DO BALÃO; DEVE POSSUIR  ESVAZIAMENTO RÁPIDO." ]
  ], [

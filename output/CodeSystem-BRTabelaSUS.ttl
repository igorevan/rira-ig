     fhir:CodeSystem.concept.display [ fhir:value "TRAQUEOSTOMIA MEDIASTINAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM REALIZAR A ABERTURA DA TRAQUÉIA AO MEIO EXTERNO POR VIA MEDIASTINAL QUANDO HÁ LESÕES OBSTRUTIVAS QUE ACOMETEM A TRAQUEIA CERVICAL E PASSA A SER NECESSÁRIO O ACESSO À TRAQUEIA MEDIASTINAL, A QUAL ESTÁ SITUADA ABAIXO E PROFUNDAMENTE AO OSSO ESTERNO. EM ALGUMAS SITUAÇÕES É NECESSÁRIA A RESSECÇÃO DE PARTE DO ESTERNO PARA CONSEGUIR FAZER O ACESSO MEDIASTINAL À TRAQUEIA, EM LESÕES AVANÇADAS PODE SER NECESSÁRIA A IMPLANTAÇÃO DO TRAQUEOSTOMA PRÓXIMO DO ESTERNO." ]

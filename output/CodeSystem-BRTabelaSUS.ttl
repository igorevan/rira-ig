     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO DE INFORMACOES QUANTO A CAPACIDADE DOS MUSULOS EM GERAR E ABSORVER ENERGIA DURANTE A MARCHA" ]
  ], [
     fhir:index 946 ;

     fhir:CodeSystem.concept.definition [ fhir:value "MÉTODO QUE UTILIZA A APLICAÇÃO DE MISTURA DOS GASES OXIGÊNIO E OZÔNIO, POR DIVERSAS VIAS DE ADMINISTRAÇÃO, COM FINALIDADE TERAPÊUTICA." ]
  ], [

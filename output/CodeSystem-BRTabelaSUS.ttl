  ], [
     fhir:index 3693 ;
     fhir:CodeSystem.concept.code [ fhir:value "0501060014" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ANGIOGRAFIA CEREBRAL P/ DIAGNOSTICO DE MORTE ENCEFÁLICA (4 VASOS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "EXAME ANGIOGRÁFICO COMPLEMENTAR PARA CARACTERIZAÇÃO DE MORTE ENCEFÁLICA DE ACORDO COM A RESOLUÇÃO CFM VIGENTE." ]
  ], [
     fhir:index 3694 ;

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM UM TESTE IMUNOENZIMÁTICO, PARA DETECTAR A PRESENÇA DE ANTICORPOS ANTI-HTLV NO SORO OU PLASMA." ]

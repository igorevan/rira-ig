     fhir:CodeSystem.concept.definition [ fhir:value "TÉCNICAS QUE, POR MEIO DE INTENSO RELAXAMENTO, CONCENTRAÇÃO E/OU FOCO, INDUZ A PESSOA A ALCANÇAR UM ESTADO DE CONSCIÊNCIA AUMENTADO QUE PERMITA ALTERAR UMA AMPLA GAMA DE CONDIÇÕES OU COMPORTAMENTOS INDESEJADOS COMO MEDOS, FOBIAS, INSÔNIA, DEPRESSÃO, ANGÚSTIA, ESTRESSE, DORES CRÔNICAS." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "ATENDIMENTO ORTOPÉDICO COM IMOBILIZAÇÃO PROVISÓRIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "COMPREENDE A CONSULTA MÉDICA E A REALIZAÇÃO IMOBILIZAÇÃO PROVISÓRIA. NO CASO DE REALIZAÇÃO DE EXAME RADIOLÓGICO (RAIO X) PARA ESTE ATENDIMENTO, ESTE DEVE SER REGISTRADO EM SEPARADO COM O REGISTRO DO CÓDIGO PRÓPRIO DE CADA TIPO DE EXAME EXISTENTE NO SIGTAP." ]
  ], [

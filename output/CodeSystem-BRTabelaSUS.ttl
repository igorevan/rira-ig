     fhir:CodeSystem.concept.display [ fhir:value "CATETERISMO VESICAL DE DEMORA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "INTRODUÇÃO, COM TÉCNICA ASSÉPTICA, DE UM CATETER ESTÉRIL NA BEXIGA, ATRAVÉS DA URETRA, COM O OBJETIVO DE DRENAR A URINA EM SITUAÇÕES DE INCOMPETÊNCIA VESICAL E INCONTINÊNCIA URINARIA." ]
  ], [
     fhir:index 1314 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301100063" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "CUIDADOS COM ESTOMAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "AVALIACAO DO PACIENTE COM ESTOMA (ORIFICIO CRIADO CIRURGICAMENTE NA BEXIGA, ILEO OU COLON PARA A PASSAGEM TEMPORARIA OU PERMANENTE DE URINA E FEZES), COMPREENDENDO A MENSURACAO DO ESTOMA, RECONHECIMENTO DE ALTERACOES DO ESTOMA E DA AREA PERIESTOMA, ADAPTACAO E TROCAS DE DISPOSITIVOS COLETORES DOS EXCREMENTOS. APOIO EMOCIONAL E ACOES  DE EDUCACAO EM SAUDE AOS PACIENTES E SEUS FAMILIARES." ]
  ], [
     fhir:index 1315 ;
     fhir:CodeSystem.concept.code [ fhir:value "0301100071" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "CUIDADOS C/ TRAQUEOSTOMIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA ASPIRACAO DE SECRECOES, LIMPEZA DO ESTOMA, E TROCA DE CURATIVO, OBJETIVANDO A PROMOCAO DA OXIGENACAO SATISFATORIA DO PACIENTE. NO MOMENTO É FEITA A MONITORAÇÃO E MANEJO DO BALONETE (CUFF), CUJA FUNÇÃO É PERMITIR QUE A LUZ DO TRAQUEÓSTOMO SEJA O ÚNICO PERTUITO VIÁVEL, OU SEJA, PERMITIR A APLICAÇÃO DE VENTILAÇÃO COM PRESSÃO POSITIVA SEM PERDA DE VOLUME CORRENTE E PREVENIR A BRONCO ASPIRAÇÃO DE SECREÇÃO ORAL E GÁSTRICA. A PRESSÃO DO BALONETE É MENSURADA UTILIZANDO UM APARELHO MANUAL CHAMADO CUFFÔMETRO E DEVE SER MONITORADA DIARIAMENTE. NA OCASIÃO DO CUIDADO PODE SER FEITA A SUBSTITUIÇÃO DA CÂNULA." ]
  ], [

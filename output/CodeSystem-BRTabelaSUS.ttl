     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO DE HLA-A, B , DR e DQ - DE MÉDIA RESOLUCAO POR DNA.ESSE EXAME DEVERA SER REALIZADO SOMENTE APÓS PROVA CRUZADA COM RESULTADO NEGATIVO." ]
  ], [

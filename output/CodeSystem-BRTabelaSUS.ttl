  ], [
     fhir:index 2134 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010105" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ESTAPEDECTOMIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO REALIZADO NO OUVIDO MÉDIO ONDE É REALIZADA A REMOÇÃO DE UMA PARTE OU DE TODO OSSO ESTRIBO, COM SUBSTITUIÇÃO POR UMA PROTESE, SENDO INDICADA PARA TRATAMENTO DE OTOSCLEROSE. A PRÓTESE QUANDO UTILIZADA DEVE SER REGISTRADA COMO PROCEDIMENTO AIH-ESPECIAL." ]
  ], [
     fhir:index 2135 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010113" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXERESE DE PAPILOMA EM LARINGE" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DE EXERESE DO PAPILOMA LARÍNGEO E ENVOLVE BASICAMENTE A RESSECÇÃO DE LESÕES BENIGNAS, EM FORMATO DE VERRUGA, QUE PODEM SER ÚNICAS OU MÚLTIPLAS E QUE SE FORMAM, PRINCIPALMENTE, NA MUCOSA LARÍNGEA SENDO MAIS FEQUENTE NAS PREGAS VOCAIS, PREGAS VESTIBULARES E NA EPIGLOTE, COM A UTILIZAÇÃO DE QUALQUER TÉCNICA. A CIRURGIA É REALIZADA, VIA DE REGRA, SOB ANESTESIA GERAL." ]
  ], [
     fhir:index 2136 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010121" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXERESE DE TUMOR DE VIAS AEREAS SUPERIORES, FACE E PESCOCO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA CIRÚRGICA DE TUMORES BENIGNOS OU MALIGNOS DA CAVIDADE NASAL, DOS SEIOS PARANASAIS, DO CONDUTO AUDITIVO, DAS GLÂNDULAS SALIVARES, DA FACE OU DA REGIÃO CERVICAL REALIZADA SOB ANESTESIA." ]
  ], [

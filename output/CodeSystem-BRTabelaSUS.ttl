     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICACAO DE DOADOR APARENTADO DE CELULAS-TRONCO HEMATOPOETICAS 2A FASE (POR DOADOR TIPADO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA TIPIFICACAO HLA-DR, DQ - CLASSE II POR TESTE MOLECULAR COM TECNICAS DE BAIXA RESOLUCAO POR DNA. O EXAME PREVISTO NA SEGUNDA FASE DEVERA SER REALIZADO NAQUELES DOADORES QUE JA TENHAM SIDO CONSIDERADOS COMPATIVEIS NA PRIMEIRA FASE." ]
  ], [
     fhir:index 3655 ;

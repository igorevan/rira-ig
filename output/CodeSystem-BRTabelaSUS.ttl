     fhir:CodeSystem.concept.code [ fhir:value "0208010076" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "CINTILOGRAFIA SINCRONIZADA DE CAMARAS CARDIACAS EM SITUACAO DE ESFORCO" ] ;

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO EXAME CITOPATOLÓGICO  DE ESFREGACOS, FIXADOS E CORADOS, PROVENIENTES DA ASPIRAÇÃO DE LÍQUIDOS BIOLÓGICOS, OU TECIDOS RASPADOS, LAVADOS, IMPRINT E CELL BLOCK." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO ALARGADA DE TUMOR DE PARTES MOLES DE PAREDE ABDOMINAL EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TUMOR MALIGNO OU INCERTO SE BENIGNO OU MALIGNO DE PARTES MOLES QUE ACOMETE PAREDE ABDOMINAL, ASSOCIADA À RESSECÇÃO DE VÍSCERA INTRA-ABDOMINAL. ADMITE PROCEDIMENTO SEQUENCIAL. OS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO OBSERVAM O TIPO DE VÍSCERA RESSECADA." ]
  ], [
     fhir:index 3586 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416040276" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO ALARGADA DE TUMOR DE INTESTINO EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA DE TUMOR MALIGNO DE INTESTINO COM A RESSECÇÃO DE  VÍSCERA (S) OCA(S)  OU SÓLIDA(S) OU PAREDE ABDOMINAL. INCLUI LINFADENECTOMIA(S). ADMITE COMO PROCEDIMENTO (S) SEQUENCIAL (AIS) : OU ILEOSTOMIA OU COLOSTOMIA, RETALHO MIOCUTÂNEO, METASTASECTOMIA HEPÁTICA EM ONCOLOGIA. OS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO OBSERVAM O TIPO DE VÍSCERA RESSECADA. AOS MATERIAIS COMPATÍVEIS COM ESTE PROCEDIMENTO, SOMAM-SE O GRAMPEADOR E CARGA EM CASO DE METASTASECTOMIA HEPÁTICA COMO PROCEDIMENTO SEQUENCIAL E A TELA INORGÂNICA DE POLIPROPILENO EM CASO DE RETALHO MIOCUTÂNEO." ]
  ], [

     fhir:CodeSystem.concept.display [ fhir:value "IMUNOELETROFORESE DE PROTEINAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA SEPARAÇÃO ELETROFORÉTICA DAS PROTEÍNAS SÉRICAS E IMUNODIFUSÃO CONTRA ANTI-SOROS HUMANO TOTAL E ESPECÍFICOS PARA CADEIAS PESADAS E LEVES DE IMUNOGLOBULINAS. UTILIZADO NO DIAGNÓSTICO DE PARAPROTEINEMIAS, MACROGLOBULINEMIA DE WALDENSTRON, DOENÇAS LINFOPROLIFERATIVAS MALIGNAS E NAS GAMOPATIAS MUNICIONAIS BENIGNAS." ]
  ], [
     fhir:index 327 ;

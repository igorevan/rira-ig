  ], [
     fhir:index 1032 ;
     fhir:CodeSystem.concept.code [ fhir:value "0211070343" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TESTES DE PROCESSAMENTO AUDITIVO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "OS TESTES DE PROCESSAMENTO AUDITIVO SÃO COMPOSTOS POR PROVAS QUE BUSCAM MEDIDAS DAS HABILIDADES DOS INDIVIDUOS NO RECONHECIMENTO DE UM DETRMINADO ESTIMULO MESMO QUANDO AS CONDIÇÕES DE ESCUTA APRESENTAM-SE DIFICULTADAS. A AVALIAÇÃO DA FUNÇÃO AUDITIVA CENTRAL É FORMADA POR UMA BATERIA DE TESTES VERBAIS E NÃO VERBAIS QUE AVALIAM AS FUNÇÕES DO TRONCO ENCEFÁLICO E CÉREBRO." ]
  ], [

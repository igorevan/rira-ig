     fhir:CodeSystem.concept.display [ fhir:value "VULVECTOMIA TOTAL AMPLIADA C/ LINFADENECTOMIA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO TOTAL DE VULVA POR TUMOR MALIGNO COM LINFADENECTOMIA INGUINAL UNILATERAL OU BILATERAL. ADMITE PROCEDIMENTO SEQUENCIAL." ]
  ], [
     fhir:index 3605 ;

     fhir:CodeSystem.concept.definition [ fhir:value "AÇÕES COLETIVAS DE PROMOÇÃO DA SAÚDE E PREVENÇÃO DE DOENÇAS VOLTADAS À PREVENÇÃO DO NOVO CORONAVÍRUS (COVID-19) REALIZADAS NO ÂMBITO NAS ESCOLAS" ]
  ], [
     fhir:index 4 ;

     fhir:CodeSystem.concept.display [ fhir:value "LARINGECTOMIA PARCIAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DE  REMOÇÃO DE PARTE DA LARINGE, PODENDO SER PARCIAL VERTICAL, PARCIAL HORIZONTAL, PARCIAL SUPLAGLÓTICA OU PARCIAL SUBTOTAL, DEPENDENDO DA LOCALIZAÇÃO DA LESÃO." ]
  ], [

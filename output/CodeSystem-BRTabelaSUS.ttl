     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE PROTEINA C REATIVA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA PESQUISA QUALITATIVA DA PROTEÍNA C REATIVA, QUE É UMA DAS PROTEÍNAS DE FASE AGUDA, CONSIDERADA UM MARCADOR SENSÍVEL NA MONITORIZAÇÃO DAS DOENÇAS INFLAMATÓRIAS E REUMÁTICAS EM GERAL." ]
  ], [

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO FORNECIMENTO POR BANCOS INTERNACIONAIS DE LINFOCITOS DE DOADOR NAO APARENTADO (PARA OS CASOS DE RECIDIVA POS TRANSPLANTE), ACONDICIONAMENTO E DEMAIS ATOS NECESSARIOS. E PERMITIDA A COBRANCA DE UM UNICO PROCEDIMENTO POR RECEPTOR." ]
  ], [

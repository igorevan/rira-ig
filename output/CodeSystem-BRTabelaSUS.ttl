     fhir:CodeSystem.concept.display [ fhir:value "RESSECÇAO PULMONAR EM CUNHA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO PULMONAR EM CUNHA/NÓDULO POR TUMOR MALIGNO." ]
  ], [
     fhir:index 3629 ;

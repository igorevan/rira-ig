     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DE  REMOÇÃO TOTAL DA LARINGE, VISANDO TRATAR TUMORES." ]
  ], [
     fhir:index 2143 ;
     fhir:CodeSystem.concept.code [ fhir:value "0404010199" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "LARINGECTOMIA TOTAL C/ ESVAZIAMENTO CERVICAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO CIRÚRGICO DE  REMOÇÃO TOTAL DA LARINGE, VISANDO TRATAR TUMORES. O PROCEDIMENTO CONTEMPLA A CIRURGIA QUE REMOVE ALÉM DE TODA A LARINGE, TODOS OS LINFONODOS DA ÁREA, BEM COMO OS TECIDOS CIRCUNVIZINHOS." ]
  ], [

     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO EXAME CONFIRMATÓRIO DA ATIVIDADE DA BIOTINA EM AMOSTRAS DE SORO PARA O  DIAGNÓSTICO DFINITIVO DE DEFICIÊNCIA DE BIOTINIDASE, CUJA DOSAGEM QUALITATIVA EM PAPEL FILTRO APRESENTOU RESULTADO ALTERADO. ESTE PROCEDIMENTO ESTÁ PREVISTO NO PROGRAMA NACIONAL DE TRIAGEM NEONATAL E PODE SER REALIZADA MÁXIMO DE 1(UM) POR INDIVÍDUO." ]
  ], [

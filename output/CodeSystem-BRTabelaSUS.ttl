     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO QUE CONSISTE  EM CRIAR UM ATALHO DO SANGUE ENTRE A VEIA CAVA SUPERIOR E AS ARTÉRIAS PULMONARES, ATRAVÉS DA CONECÇÃO DA VEIA CAVA SUPERIOR DIRETAMENTE NAS ARTÉRIAS PULMONARES, EM CRIANÇAS COM HIPODESENVOLVIMENTO DE UM DOS VENTRÍCULOS. ATUALMENTE PODE SER FEITA PARA DESCOMPRESSÃO DO VENTRÍCULO DIREITO EM OUTRAS DOENÇAS COMO ANOMALIA DE EBSTEIN." ]
  ], [

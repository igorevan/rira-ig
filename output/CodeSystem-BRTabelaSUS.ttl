     fhir:CodeSystem.concept.display [ fhir:value "STENT FARMACOLÓGICO PARA ARTÉRIA PERIFÉRICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "DISPOSITIVO TUBULAR ESTÉRIL EXPANSÍVEL, RECOBERTO, COM ELUIÇÃO DE FÁRMACO, EXPANSÍVEL IMPLANTADO EM ARTÉRIA PERIFÉRICA  A FIM DE MANTER A SUA PERMEABILIDADE E AUMENTAR O DIÂMETRO DO SEU LÚMEN. É GERALMENTE COLOCADO NO LOCAL DE IMPLANTAÇÃO POR UM INSTRUMENTO ESPECÍFICO, ONDE SE EXPANDE AUTOMATICAMENTE AO SER LIBERTADO." ]
  ], [
     fhir:index 4624 ;
     fhir:CodeSystem.concept.code [ fhir:value "0702040517" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "STENT PARA ARTÉRIA PERIFÉRICA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "DISPOSITIVO TUBULAR ESTÉRIL EXPANSÍVEL QUE É ALTERNATIVAMENTE IMPLANTADO EM MAIS DE UMA ARTÉRIA PERIFÉRICA (P. EX. AS ARTÉRIAS ILÍACAS, CEREBRAIS, CARÓTIDAS E RENAIS), A FIM DE MANTER A SUA PERMEABILIDADE E AUMENTAR O DIÂMETRO DO SEU LÚMEN. O DISPOSITIVO PODE SER INSERIDO E AVANÇADO ATÉ AO LOCAL DE IMPLANTAÇÃO COM UM CATETER BALÃO QUE, AO SER INSUFLADO, PROVOCA A SUA EXPANSÃO, OU PODE SER COLOCADO NO LOCAL DE IMPLANTAÇÃO POR UM INSTRUMENTO ESPECÍFICO, ONDE SE EXPANDE AUTOMATICAMENTE AO SER LIBERTADO." ]
  ], [
     fhir:index 4625 ;
     fhir:CodeSystem.concept.code [ fhir:value "0702040533" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "STENT PARA ARTÉRIA CORONARIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "DISPOSITIVO TUBULAR ESTÉRIL (STENT DE METAL NÃO RECOBERTO OU STENT DE METAL SIMPLE) CONCEBIDO PARA SER IMPLANTADO NUMA ARTÉRIA CORONÁRIA PARA MANTER A SUA DESOBSTRUÇÃO E AUMENTAR O DIÂMETRO DO SEU LÚMEN. O DISPOSITIVO PODE SER INSERIDO E AVANÇADO ATÉ AO LOCAL DE IMPLANTAÇÃO COM UM CATETER BALÃO QUE, AO SER INSUFLADO, PROVOCA A SUA EXPANSÃO, OU PODE SER COLOCADO COM UM INSTRUMENTO ESPECÍFICO QUE O FAZ EXPANDIR AUTOMATICAMENTE AO SER LIBERTADO." ]

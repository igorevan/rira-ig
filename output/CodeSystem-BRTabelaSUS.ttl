     fhir:CodeSystem.concept.display [ fhir:value "INTERCORRENCIA POS-TRANSPLANTE AUTOGENICO DE CELULAS-TRONCO HEMATOPOETICAS (HOSPITAL DIA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO TRATAMENTO EM HOSPITAL-DIA DE PACIENTE TRANSPLANTADO DE CELULAS-TRONCO HEMATOPOETICAS POR INTERCORRENCIA PROVENIENTE DO TRANSPLANTE. O LIMITE PARA A COBRANCA DA AIH E DE 7 DIAS NAO E PERMITIDA A COBRANCA DE DIARIA DE UTI. SERA, ENTRETANTO, PERMITIDA A COBRANCA DOS MEDICAMENTOS PREVISTOS PARA A INTERCORRENCIA POS TRANSPLANTE, HEMOTERAPIA E DEMAIS PROCEDIMENTOS ESPECIAIS.  EM  CASO DA  NECESSIDADE  DE CONTINUACAO  DO TRATAMENTO PODERAO SER EMITIDAS NOVAS AIH  PARA O PACIENTE ATE COMPLETAR 06 MESES DA REALIZACAO DO TRANSPLANTE. E OBRIGATORIO O REGISTRO DO CID SECUNDARIO." ]

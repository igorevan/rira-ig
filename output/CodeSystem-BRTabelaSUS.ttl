     fhir:CodeSystem.concept.definition [ fhir:value "EXAME ULTRASSONOGRÁFICO COMPLEMENTAR PARA CARACTERIZAÇÃO DE MORTE ENCEFÁLICA DE ACORDO COM A RESOLUÇÃO CFM VIGENTE." ]
  ], [

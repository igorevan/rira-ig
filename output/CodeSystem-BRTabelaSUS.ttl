     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZAÇÃO DE AVALIAÇÃO DE REATIVIDADE CONTRA PAINEL HLA - CLASSE I OU CLASSE II, COM CARACTERIZAÇÃO DO ANTICORPO ANTI-HLA PARA OS RECEPTORES DE  ÓRGÃOS E RECEPTORES DE TCTH COM DOADOR SEM IDENTIDADE HLA TOTAL. PERMITIDO ATÉ 4 VEZES AO ANO E APÓS UM EVENTO DE SENSIBILIZAÇÃO." ]
  ], [

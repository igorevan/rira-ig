     fhir:CodeSystem.concept.display [ fhir:value "ATENDIMENTO DE URGENCIA EM ATENCAO ESPECIALIZADA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "ATENDIMENTO DE URGÊNCIA EM ATENÇÃO ESPECIALIZADA CONSISTE NAS CONSULTAS MÉDICAS/ODONTOLÓGICAS REALIZADAS EM UNIDADES HOSPITALARES OU EM OUTROS ESTABELECIMENTOS DE SERVIÇO DE ATENDIMENTO ÀS URGÊNCIAS, PRONTOS SOCORROS ESPECIALIZADOS E/OU SERVIÇOS DE ATENÇÃO ÀS URGÊNCIAS. ESSES ESTABELECIMENTOS DEVEM DISPOR DE PROFISSIONAIS QUE PRESTEM ATENÇÃO EM ESPECIALIDADES." ]

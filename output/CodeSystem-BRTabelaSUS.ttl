     fhir:CodeSystem.concept.display [ fhir:value "TESTE MOLECULAR PARA A DETECÇÃO DO COMPLEXO MYCOBACTERIUM TUBERCULOSIS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "MÉTODO MOLECULAR COM BASE NA REAÇÃO EM CADEIA DA POLIMERAS PARA IDENTIFICAÇÃO DO COMPLEXO MYCROBACTERIUM TUBERCULOSIS E DETECÇÃO DE RESITÊNCIAS À RIFAMPISCINA EM AMOSTRAS DE ESCARRO, ESCARRO REDUZIDO LEVADO BRONCOALVEOLAR, LEVADO GÁSTRICO LÍQUOR, GANGLIOS LINFÁTICOS E MECERADOS DE TECIDOS." ]
  ], [
     fhir:index 627 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100014" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO DE CARIÓTIPO EM CULTURA DE LONGA DURAÇÃO (C/ TÉCNICA DE BANDAS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA ANÁLISE EM AMOSTRAS BIOLÓGICAS, APÓS CULTURA DE LONGA DURAÇÃO, INTERROMPIDA NA METÁFASE, SEGUIDA DE COLORAÇÃO ESPECIFICA, PARA IDENTIFICAÇÃO DOS CROMOSSOMOS E DE SUAS DIFERENTES REGIÕES, TENDO POR BASE SUA MORFOLOGIA E TAMANHO E A PRESENÇA DE BANDAS, QUE SÃO CARACTERÍSTICAS DE CADA PAR, PERMITINDO A DETECÇÃO DE ABERRAÇÕES NUMÉRICAS E ESTRUTURAIS, EQUILIBRADAS OU NÃO EQUILIBRADAS." ]
  ], [
     fhir:index 628 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100022" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO DE CARIÓTIPO EM MEDULA ÓSSEA E VILOSIDADES CORIÔNICAS (C/ TÉCNICA DE BANDAS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA ANÁLISE EM AMOSTRA DE MEDULA ÓSSEA OU VILOSIDADES CORIÔNICAS,BLOQUEADAS NA METÁFASE, SEGUIDA DE COLORAÇÃO ESPECIFICA,PARA IDENTIFICAÇÃO DOS CROMOSSOMOS E DE SUAS DIFERENTES REGIÕES, TENDO POR BASE SUA MORFOLOGIA E TAMANHO E A PRESENÇA DE BANDAS, QUE SÃO CARACTERÍSTICAS DE CADA PAR, PERMITINDO A DETECÇÃO DE ABERRAÇÕES NUMÉRICAS E ESTRUTURAIS, EQUILIBRADAS OU NÃO EQUILIBRADAS." ]
  ], [
     fhir:index 629 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100030" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DETERMINAÇÃO DE CARIÓTIPO EM SANGUE PERIFÉRICO (C/ TÉCNICA DE BANDAS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA ANÁLISE DE SANGUE PERIFÉRICO, BLOQUEADAS NA METÁFASE, SEGUIDA DE COLORAÇÃO ESPECÍFICA, PARA IDENTIFICAÇÃO DOS CROMOSSOMOS E DE SUAS DIFERENTES REGIÕES, TENDO POR BASE SUA MORFOLOGIA E TAMANHO E A PRESENÇA DE BANDAS, QUE SÃO CARACTERÍSTICAS DE CADA PAR, PERMITINDO A DETECÇÃO DE ABERRAÇÕES NUMÉRICAS E ESTRUTURAIS, EQUILIBRADAS OU NÃO EQUILIBRADAS." ]
  ], [
     fhir:index 630 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100049" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "QUANTIFICAÇÃO/AMPLIFICAÇÃO DO HER-2" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE DA QUANTIFICAÇÃO/AMPLIFICAÇÃO DO RECEPTOR DO FATOR DE CRESCIMENTO EPIDÉRMICO HUMANO 2 (HER-2) POR TÉCNICA MOLECULAR EM AMOSTRA DE CÂNCER DE MAMA EM ESTÁGIOS I, II, III OU IV CLÍNICO OU PATOLÓGICO PARA CONFIRMAÇÃO DE EXAME IMUNO-HISTOQUÍMICO COM RESULTADO DE 2 CRUZES PARA O HER-2." ]
  ], [
     fhir:index 631 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100057" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "FOCALIZAÇÃO ISOELÉTRICA DA TRANSFERRINA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM TESTE PELO MÉTODO DE ISOELETROFOCALIZAÇÃO, PARA DETECÇÃO DE TODOS OS SUBTIPOS DE DEFEITOS CONGÊNITOS DA GLICOSILAÇÃO TIPO I. O AGRAVO É DECORRENTE DA DEFICIÊNCIA, OU AUSÊNCIA , DE CARBOIDRATOS, SECUNDÁRIA A SECREÇÃO DE GLICOPROTEINAS, ESPECIALMENTE TRANSFERRINA SÉRICA, DEVIDO A ATIVIDADE ENZIMÁTICA ANORMAL DA FOSFOMANOMUTASE." ]
  ], [
     fhir:index 632 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100065" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ANÁLISE DE DNA PELA TÉCNICA DE SOUTHERN BLOT" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA EXTRAÇÃO DE DNA, DIGESTÃO COM ENZIMAS DE RESTRIÇÃO ESPECÍFICAS, SEPARAÇÃO DOS FRAGMENTOS EM GEL AGAROSE, TRANSFERÊNCIA PARA MEMBRANA SEGUIDA DE HIBRIDAÇÃO COM UMA OU MAIS SONDAS ESPECÍFICAS, PARA DETECÇÃO DE UMA DETERMINADA SEQUÊNCIA E SEU TAMANHO, OU DETERMINAÇÃO DE SUA AUSÊNCIA." ]
  ], [
     fhir:index 633 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100073" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ANÁLISE DE DNA POR MLPA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE  NA EXTRAÇÃO DE DNA, SEGUIDA DE HIBRIDIZAÇÃO DO DNA GENÔMINO A UMA MISTURA DE SONDAS ESPECÍFICAS PARA CADA UMA DE DIVERSAS REGIÕES ESTUDADAS SIMULTANEAMENTE, COM AMPLIFICAÇÃO DOS PRODUTOS DE LIGAÇÃO PELA TÉCNICA DE REAÇÃO EM CADEIA DE POLIMERASE, UTILIZANDO UM PAR DE DE PRIMERS UNIVERSAL A VISUALIZAÇÃO DESSAS AMPLIFICAÇÕES PODE  SER FEITA POR ELETROFORESE CAPILAR E A ANÁLISE POR PROGRAMAS ESPECÍFICOS DE GENOTIPAGEM. A TÉCNICA PERMITE DETECTAR DELEÇÕES E DUPLICAÇÕES DE GENES." ]
  ], [
     fhir:index 634 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100081" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICAÇÃO DE MUTAÇÃO/REARRANJOS POR PCR, PCR SENSÍVEL A METILAÇÃO, qPCR E qPCR SENSÍVEL A METILA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA EXTRAÇÃO DE DNA, SEGUIDA DA AMPLIFICAÇÃO DA SEQUENCIA DE DNA DE INTERESSE POR PRIMERS ESPECÍFICOS, ATRAVÉS DA AÇÃO DA ENZIMA DNA POLIMERASE, COM VISUALIZAÇÃO EM GEL APÓS ELETROFORESE (PCR CLÁSSICO), OU DIRETAMENTE PELA DINÂMICA DA REAÇÃO DE PCR (QPCR), PODENDO SER ANTECEDIDA POR TRATAMENTOS PRÉVIOS QUE PERMITAM VERIFICAÇÃO DO ESTADO DE METILAÇÃO (PCR SENSÍVEL A METILAÇÃO E QPCR SENSÍVEL A METILAÇÃO)" ]
  ], [
     fhir:index 635 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100090" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "FISH EM METÁFASE OU NÚCLEO INTERFÁSICO, POR DOENÇA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "TECNICA USADA PARA VERIFICAR A PRESENÇA OU AUSÊNCIA, O NUMERO DE CÓPIAS E A LOCALIZAÇÃO CROMOSSÔMICA DE UMA SEQUÊNCIA DE DNA ESPECÍFICA TANTO NOS CROMOSSOMOS EM METÁFASE QUANTO NAS CÉLULAS EM INTERFASE." ]
  ], [
     fhir:index 636 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100103" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICAÇÃO DE ALTERAÇÃO CROMOSSÔNICA SUBMICROSCÓPICA POR ARRAY-CGH" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA EXTRAÇÃO DE DNA ,SEGUIDA DE HIBRIDAÇÃO GENÔMICA COMPARATIVA COM MILHARES DE SEQUÊNCIAS DE DNA ARRANJADAS EM UMA BASE (ARRAY) PARA DETECÇÃO DE VARIAÇÃO NO NÚMERO DE COPIAS DE SEQUÊNCIAS DE DNA (PERDAS OU GANHOS DE MATERIAL CROMOSSÔMICO)" ]
  ], [
     fhir:index 637 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100111" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICAÇÂO DE MUTAÇÃO POR SEQUENCIAMENTO POR AMPLICON ATÉ 500 PARES DE BASES" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA EXTRAÇÃO DE DNA SEGUIDO DO SEQUENCIAMENTO BIDIRECIONAL PELO MÉTODO DE SANGER DE UMA SEQUENCIA DE ATÉ 500 PARES DE BASES. O MÉTODO É UTILIZADO PARA IDENTIFICAÇÃO DE MUTAÇÕES PONTUAIS, DELEÇÕES E DUPLICAÇÕES DE BASES." ]
  ], [
     fhir:index 638 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100120" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICAÇÃO DE GLICOSAMINOGLICANOS URINÁRIOS POR CROMATOGRAFIA EM CAMADA DELGADA , ELETROFORESE E" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA DETECÇÃO DE GLICOSAMINOGLICANOS NA URINA DE PACIENTES SUSPEITOS  DE MUCOPOLISSACARIDOSES, UM ERRO INATO DE METABOLISMO, QUALITATIVAMENTE ATRAVÉS DE CROMATOGRAFIA DE CAMADA DELGADA, ELETROFORESE OU QUANTITATIVAMENTE, ATRAVES DE ESPECTROFOTOMETRIA.." ]
  ], [
     fhir:index 639 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100138" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "IDENTIFICAÇÃO DE OLIGOSSACARÍDEOS E SIALOSSACARÍDEOS POR CROMATOGRAFIA (CAMADA DELGADA)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA SEPARAÇÃO DE OLIGOSSACARÍDEOS E SIALOSSACARÍDEOS EM   CROMATOGRAFIA DE CAMADA DELGADA, COM IDENTIFICAÇÃO DE SUAS BANDAS PARA DIAGNÓSTICO DE ERROS INATOS DO METABOLISMO QUE ACUMULAM ESSES METABÓLITOS." ]
  ], [
     fhir:index 640 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100146" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM QUANTITATIVA DE CARNITINA, PERFIL DE ACILCARNITINAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA IDENTIFICAÇÃO E QUANTIFICAÇÃO, ATRAVÉS DA ESPECTROMETRIA DE MASSA, DE CARNITINA E ACILCARNITINAS EM SANGUE PARA AUXÍLIO DIAGNÓSTICO EM ACIDEMIAS ORGÃNICAS, DEFEITOS DE BETA-OXIDAÇÃO DE ÁCIDOS GRAXOS E DOENÇAS DO METABOLISMO ENERGÉTICO EM GERAL" ]
  ], [
     fhir:index 641 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100154" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM QUANTITATIVA DE AMINOÁCIDOS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA IDENTIFICAÇÃO E QUANTIFICAÇÃO DOS AMINOÁCIDOS EM SANGUE OU URINA, ATRAVÉS DE CROMATOGRAFIA GASOSA,CROMATOGRAFIA LÍQUIDA DE ALTA PERFOMANCE (HPLC) OU ESPECTROMETRIA DE MASSA PARA DIAGNÓSTICO AMINOÁCIDOPATIAS." ]
  ], [
     fhir:index 642 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100162" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM QUANTITATIVA DE ÁCIDOS ORGÂNICOS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA IDENTIFICAÇÃO E QUANTIFICAÇÃO DE ÁCIDOS ORGÂNICOS, POR CROMATOGRAFIA GASOSA ACOPLADA A ESPECTROMETRIA DE MASSA PARA AUXÍLIO DIAGNÓSTICO EM ACIDEMIAS ORGÂNICAS." ]
  ], [
     fhir:index 643 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100170" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ENSAIOS ENZIMÁTICOS NO PLASMA E LEUCÓCITOS PARA DIAGNÓSTICO DE ERROS INATOS DO METABOLISMO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE DE ANÁLISE BIOQUÍMICA REALIZADA EM COLETA EM SANGUE TOTAL PARA MEDIDA DA ATIVIDADE ENZIMÁTICA EM PLASMA, LEUCÓCITOS OU TECIDO(FIBROBLASTO,TECIDO HEPÁTICO, MEDULA ÓSSEA, ET.) A SER CULTIVADO EM MEIOS ESPECÍFICOS PARA SEU CRESCIMENTO. AS TÉCNICAS UTILIZADAS SÃO GERALMENTE BIOQUÍMICAS, FLUORIMÉTRICAS,ESPECTROFOTOMÉTRICAS, COLORIMÉTRICAS E OUTRAS TÉCNICAS USUALMENTE UTILIZADAS EM ANÁLISES BIOQUÍMICAS USUAIS." ]
  ], [
     fhir:index 644 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100189" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ENSAIOS ENZIMÁTICOS EM ERITRÓCITOS PARA DIAGNÓSTICO DE ERROS INATOS DO METABOLISMO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE DE ANÁLISE BIOQUÍMICA REALIZADA EM COLETA DE SANGUE TOTAL, SEPARANDO -SE OS ERITRÓCITOS. A TÉCNICA UTILIZADA É GERALMENTE FLUORIMÉTRICA, PODENDO AINDA SER ESPECTROFOTOMÉTRICA OU COLORIMÉTRICA. AUXILIA NO DIAGNÓSTICO DE GALACTOSEMIA, PODENDO-SE DOSAR TANTO A GALACTOSE - 1 FOSFATO, QUANTO A GALACTOSE TOTAL, ALÉM DE SE FAZER O ENSAIO BIOQUÍMICO PARA ANÁLISE DA ATIVIDADE ENZIMÁTICA DA GALACTOSE - 1 -FOSFATO URIDIL TRANSFERASE." ]
  ], [
     fhir:index 645 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202100197" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ENSAIOS ENZIMÁTICOS EM TECIDO CULTIVADO PARA DIAGNÓSTICO DE ERROS INATOS DO METABOLISMO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE DE UMA ANÁLISE BIOQUÍMICA REALIZADA EM TECIDO CULTIVADO, PREFERENCIALMENTE FIBROBLASTO, COLETADO ATRAVÉS DE UMA BIÓPSIA DE PELE E CULTIVADO EM MEIOS ESPECÍFICOS PARA SEU CRESCIMENTO. AS TÉCNICAS UTILIZADAS SÃO GERALMENTE FLUORIMÉTRICAS, EPECTROFOTOMÉTRICAS OU OUTRAS TÉCNICAS USUALMENTE UTILIZADAS EM ANÁLISES BIOQUÍMICAS USUAIS. É ÚTIL PARA O DIAGNÓSTICO DE DOENÇAS LISOSSÔMICAS." ]
  ], [

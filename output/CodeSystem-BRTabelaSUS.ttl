     fhir:CodeSystem.concept.display [ fhir:value "EXAMES DE PACIENTES EM LISTA DE ESPERA PARA TRANSPLANTES" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA REALIZAÇÃO DE EXAMES RADIOLÓGICOS , ANÁLISES LABORATORIAIS ( HEMATOLOGIA, BIOQUÍMICA, SOROLOGIA E ELETRÓLITOS), PARA COMPLEMENTAÇÃO DA INVESTIGAÇÃO CLÍNICA DE CANDIDATOS A RECEPÇÃO DE ÓRGÃOS (FIGADO,RINS, PULMÕES, RIM-PÂNCREAS)." ]
  ], [

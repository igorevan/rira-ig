     fhir:CodeSystem.concept.definition [ fhir:value "PRÁTICA TERAPÊUTICA QUE UTILIZA OS PRODUTOS PRODUZIDOS PELAS ABELHAS (A PRÓPOLIS, O MEL, A GELEIA REAL, O PÓLEN, A APITOXINA) PARA PROMOÇÃO, MANUTENÇÃO DA SAÚDE E AUXÍLIO COMPLEMENTAR NO TRATAMENTO DE ALGUMAS CONDIÇÕES ALTERADAS." ]
  ], [

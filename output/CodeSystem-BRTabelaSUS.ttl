  ], [
     fhir:index 301 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202020541" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TESTE DIRETO DE ANTIGLOBULINA HUMANA (TAD)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA IDENTIFICAÇÃO DIRETA DE IMUNOGLOBULINA E OU COMPLEMENTO  LIGADO A MEMBRANA DA HEMÁCIA. ESTA INDICADO PARA ACOMPANHAMENTO DE  QUADROS DE SENSIBILIZAÇÃO QUE TENHAM OCORRIDO IN VIVO DEVIDO A  MECANISMOS AUTÓLOGOS OU ALOGENEICOS. O VALOR DO PROCEDIMENTO INCLUI  INSUMOS NECESSÁRIOS A SUA EXECUÇÃO" ]
  ], [
     fhir:index 302 ;
     fhir:CodeSystem.concept.code [ fhir:value "0202020550" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DOSAGEM DE PROTEÍNA C FUNCIONAL" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA APLICAÇÃO DE TÉCNICAS LABORATORIAIS A FIM DE DOSAR OS NÍVEIS DE PROTEÍNA C COMO FORMA DE RASTREAMENTO DE TROMBOFILIA EM GESTANTES NOS SEGUINTES CASOS: (A) GESTANTES COM HISTÓRIA PESSOAL DE TEV, COM OU SEM FATOR DE RISCO RECORRENTE E SEM TESTE DE TROMBOFILIA PRÉVIO E; (B) GESTANTES COM HISTÓRIA PRÉVIA DE ALTO RISCO DE TROMBOFILIA HEREDITÁRIA EM PARENTES DE PRIMEIRO GRAU." ]
  ], [

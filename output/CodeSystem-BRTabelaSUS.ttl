     fhir:CodeSystem.concept.code [ fhir:value "0401010040" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ELETROCOAGULACAO DE LESAO CUTANEA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PROCEDIMENTO CIRÚRGICO PARA RETIRADA DE PEQUENAS LESÕES DE PELE ATRAVÉS DA ELETROCOAGULAÇÃO. CONSISTE NA DESTRUIÇÃO DAS LESÕES COM O USO DE ELETROCAUTÉRIO  OU BISTURI ELÉTRICO , QUE  ATRAVÉS DE ENERGIA TRANSFORMADA EM CALOR É UTILIZADO PARA DESTRUIR A LESÃO OBJETO DO PROCEDIMENTO." ]
  ], [
     fhir:index 1970 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010058" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXCISAO DE LESAO E/OU SUTURA DE FERIMENTO DA PELE ANEXOS E MUCOSA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NO PROCEDIMENTO NO QUAL, APÓS ADMINISTRADA ANESTESIA LOCAL, É REALIZADA UMA INCISÃO COM BISTURI, ENVOLVENDO A LESÃO A SER REMOVIDA, ATINGINDO TODA AS CAMADAS DA PELE. O FECHAMENTO DA FERIDA É REALIADO COM SUTURA COM PONTOS. OS PONTOS EXTERNOS PODEM SER RETIRADOS EM 5 A 10 DIAS. ESTE PROCEDIMENTO PREVÊ A EXCISÃO DE UMA LESÃO OU O FECHAMENTO DE UM FERIMENTO NA PELE, ANEXOS E MUCOSAS EM QUALQUER REGIÃO DO CORPO." ]
  ], [
     fhir:index 1971 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010066" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXCISÃO E/OU SUTURA SIMPLES DE PEQUENAS LESÕES / FERIMENTOS DE PELE / ANEXOS E MUCOSA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA CIRÚRGICA ONDE SE FAZ UMA INCISÃO (CORTE) AO REDOR OU EM QUALQUER OUTRA FORMA PARA RETIRADA DA LESÃO E APÓS PARADO O SANGRAMENTO POR TÉCNICAS CIRÚRGICAS, PODE SER REALIZADA OU NÃO A SUTURA NA PELE, ANEXOS OU MUCOSA. O PROCEDIMENTO, TAMBÉM, CONTEMPLA A REALIZAÇÃO DE SUTURAS SIMPLES EM FERIMENTOS DE PELE, ANEXOS OU MUCOSA." ]
  ], [
     fhir:index 1972 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010074" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "EXERESE DE TUMOR DE PELE E ANEXOS / CISTO SEBACEO / LIPOMA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA EXÉRESE CIRÚRGICA DE PEQUENAS LESÕES DE PELE E SEUS ANEXOS, COMO NEVUS, CISTO SEBÁCEO, INCLUINDO A RETIRADA DE CÁPSULA E LIPOMAS, COM USO DE DRENO OU NÃO. INCLUI A SUTURA INDICADA SENDO  REALIZADAS EM AMBULATÓRIO." ]
  ], [
     fhir:index 1973 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010082" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "FRENÉCTOMIA/FRENOTOMIA." ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE SOMENTE NA INCISÃO DO FREIO LABIAL E/OU LINGUAL (FRENOTOMIA) OU INCISÃO E REMOÇÃO DE TECIDO (FRENÉCTOMIA)." ]
  ], [
     fhir:index 1974 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010090" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "FULGURACAO / CAUTERIZACAO QUIMICA DE LESOES CUTANEAS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "FULGURAÇÃO CONSISTE NO MÉTODO TERAPÊUTICO QUE EMPREGA AS FAÍSCAS ELÉTRICAS E OS EFLÚVIOS DE ALTA FREQUÊNCIA APLICADAS SOBRE LESÕES VISANDO SUA DESTRUIÇÃO E/ OU REMOÇÃO.E A CAUTERIZAÇÃO QUÍMICA CONSISTE NA APLICAÇÃO DE UMA SUBSTANCIA CAUSTICA, GERALMENTE UM ÁCIDO, SOBRE UMA LESÃO CUTÂNEA, PROVOCANDO A SUA REMOÇÃO E/OU DESTRUIÇÃO. ATÉ 05 (CINCO) LESÕES." ]
  ], [
     fhir:index 1975 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010104" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "INCISÃO E DRENAGEM DE ABSCESSO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM PROCEDIMENTO CIRÚRGICO PARA PROMOVER A DRENAGEM DE COLEÇÃO PURULENTA NA DERME E TECIDO SUBCUTÂNEO ADJACENTE.  EM ALGUNS CASOS  PODE SER NECESSÁRIA A COLOCAÇÃO DE UM DRENO DENTRO DO ESPAÇO DEIXADO PELO ABSCESSO CUTÂNEO PARA FACILITAR A DRENAGEM DE FLUIDOS CORPORAIS." ]
  ], [
     fhir:index 1976 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010112" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RETIRADA DE CORPO ESTRANHO SUBCUTANEO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE NA RETIRADA DO CORPO ESTRANHO NOS TECIDOS MOLES ATRAVÉS DE PEQUENA INCISÃO OU PELO PRÓPRIO ORIFÍCIO DA LESÃO, NA MAIORIA DAS VEZES É NECESSÁRIO O BLOQUEIO ANESTÉSICO LOCAL." ]
  ], [
     fhir:index 1977 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010120" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RETIRADA DE LESAO POR SHAVING" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "CONSISTE EM REMOVER UMA LESÃO COM A UTILIZAÇÃO DE LÂMINA DE BISTURI OU TESOURA FINA, ATRAVÉS DE UMA INCISÃO PARALELAMENTE À PELE, DE FORMA SEMELHANTE AO ATO DE BARBEAR (“SHAVING”). PODE-SE USAR A ELETROCOAGULAÇÃO LEVE, LOGO EM SEGUIDA, DE MODO A APENAS ESTANCAR O SANGRAMENTO. A CICATRIZAÇÃO DEVE OCORRER EM 7 A 15 DIAS, DEPENDENDO DO TAMANHO DA LESÃO. É NECESSÁRIA A ADMINISTRAÇÃO DE ANESTESIA LOCAL, SENDO ESTE PROCEDIMENTO IDEAL PARA LESÕES BENIGNAS, QUE SE ELEVAM ACIMA DA SUPERFÍCIE DA PELE, COMO, POR EXEMPLO, NEVOS MELANOCÍTICOS INTRADÉRMICOS." ]
  ], [
     fhir:index 1978 ;
     fhir:CodeSystem.concept.code [ fhir:value "0401010139" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TRATAMENTO CIRURGICO DE FISTULA DO PESCOCO (POR APROXIMACAO)" ]
  ], [
     fhir:index 1979 ;

     fhir:CodeSystem.concept.code [ fhir:value "0416090079" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "SACRALECTOMIA (ENDOPELVECTOMIA) EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO TOTAL OU PARCIAL DA COLUNA SACROCOCCÍGEA POR TUMOR MALIGNO OU INCERTO SE BENIGNO OU MALIGNO. ADMITE PROCEDIMENTO SEQUENCIAL." ]
  ], [
     fhir:index 3618 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416090109" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "RESSECCAO DE TUMOR OSSEO COM SUBSTITUICAO (ENDOPROTESE) OU COM RECONSTRUÇÃO E FIXAÇÃO EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TUMOR ÓSSEO MALIGNO OU INCERTO SE BENIGNO OU MALIGNO E RECONSTRUÇÃO OU COM ENDOPRÓTESE OU COM CIMENTO ORTOPÉDICO, SUBSTITUTO ÓSSEO OU ENXERTO (AUTÓLOGO OU HOMÓLOGO) COM FIXAÇÃO. AS PLACAS, HASTES E FIXADORES SÃO EXCLUDENTES COM A ENDOPRÓTESE E RESPECTIVAMENTE ENTRE SI, USADOS CONFORME O OSSO ACOMETIDO." ]
  ], [
     fhir:index 3619 ;
     fhir:CodeSystem.concept.code [ fhir:value "0416090117" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DESARTICULACAO INTERESCAPULO-TORACICA EM ONCOLOGIA" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "RESSECÇÃO DE TODO O MEMBRO SUPERIOR INCLUINDO A ESCÁPULA, COM OU SEM RESSECÇÃO DE CLAVÍCULA, POR TUMOR MALIGNO OU INCERTO SE BENIGNO OU MALIGNO." ]
  ], [

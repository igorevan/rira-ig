  ] [
     fhir:code [ fhir:v "0209010037" ] ;
     fhir:display [ fhir:v "ESOFAGOGASTRODUODENOSCOPIA" ] ;
     fhir:definition [ fhir:v "CONSISTE NA AVALIAÇÃO ENDOSCÓPICA PREFERENCIALMENTE DOS TRÊS SEGMENTOS, PODENDO SER UTILIZADA PARA EXAME DE UM OU MAIS SEGMENTOS. PERMITE TAMBÉM REALIZAR VARIAS INTERVENÇÕES DIAGNÓSTICAS E TERAPÊUTICAS COMO OBTENÇÃO DE FRAGMENTOS DE TECIDOS PARA ANALISE (BIOPSIA), EXTRAÇÃO OU EXERESE DE POLIPO, DESTRUIÇÃO DE DILATAÇÃO VASCULAR, DILATAÇÃO DE ESTENOSES, ENTRE OUTRAS." ]
  ] [
     fhir:code [ fhir:v "0209010045" ] ;
     fhir:display [ fhir:v "LAPAROSCOPIA" ] ;
     fhir:definition [ fhir:v "CONSISTE NUMA INTERVENÇÃO CIRÚRGICA MINIMAMENTE INVASIVA, MUITO UTILIZADA EM CIRURGIAS GINECOLÓGICAS E UROLÓGICAS, CONSAGRADA PARA A RETIRADA DA VESÍCULA BILIAR. A EVOLUÇÃO DA TECNOLOGIA PERMITE ACESSAR PRATICAMENTE TODOS OS ÓRGÃOS DA CAVIDADE ABDOMINAL E SEU CONTEÚDO COM APARELHOS  É REALIZADA SOB ANESTESIA E CONSISTE NUMA PEQUENA INCISÃO NA REGIÃO A SER EXAMINADA OU TRATADA, POR ONDE É INTRODUZIDO O LAPAROSCÓPIO, QUE É UM FINO TUBO DE FIBRAS ÓTICAS, ATRAVÉS DO QUAL PODE VISUALIZAR OS ÓRGÃOS INTERNOS E FAZER INTERVENÇÕES DIAGNÓSTICAS OU TERAPÊUTICAS. OUTRAS PEQUENAS INCISÕES PODEM SER NECESSÁRIAS PARA INTRODUZIR OS INSTRUMENTOS CIRÚRGICOS. CERTA QUANTIDADE DE GÁS (DIÓXIDO DE CARBONO) É INTRODUZIDA DENTRO DA CAVIDADE ABDOMINAL A FIM DE EXPANDI-LA E CRIAR UM CAMPO DE TRABALHO PARA SE REALIZ" ]
  ] [

     fhir:definition [ fhir:v "CONSISTE EM PROCEDIMENTO NÃO INVASIVO, QUE NÃO UTILIZA RADIAÇÃO IONIZANTE, SENDO UM IMPORTANTE MEIO DE DIAGNÓSTICO POR IMAGEM NA AVALIAÇÃO DAS ALTERAÇÕES DAS ESTRUTURAS ARTICULARES E DA MUSCULATURA ASSOCIADA À ARTICULAÇÃO." ]
  ] [
     fhir:code [ fhir:v "0205020070" ] ;
     fhir:display [ fhir:v "ULTRASSONOGRAFIA DE BOLSA ESCROTAL" ] ;
     fhir:definition [ fhir:v "CONSISTE NUM PROCEDIMENTO NÃO INVASIVO, UTILIZADO PARA AVALIAÇÃO, SEGUIMENTO, DIAGNÓSTICO E CARACTERIZAÇÃO DAS ALTERAÇÕES DA BOLSA ESCROTAL E DOS TESTÍCULOS. TEM ALTA SENSIBILIDADE PARA O DIAGNÓSTICO DAS PATOLOGIAS QUE INCIDEM SOBRE ESSA REGIÃO, SENDO UM MÉTODO QUE NÃO UTILIZA NENHUM TIPO DE RADIAÇÃO E NÃO APRESENTA EFEITOS COLATERAIS." ]
  ] [

     fhir:display [ fhir:v "PORTOGRAFIA TRANS-HEPÁTICA" ] ;
     fhir:definition [ fhir:v "ESTUDO ANGIOGRÁFICO DA VEIA PORTA POR VIA PERCUTÂNEA TRANS-HEPÁTICA" ]
  ] [
     fhir:code [ fhir:v "0210020016" ] ;
     fhir:display [ fhir:v "COLANGIOGRAFIA TRANSCUTÂNEA" ] ;
     fhir:definition [ fhir:v "CONSISTE NO EXAME DAS VIAS BILIARES, PARA VISUALIZAÇÃO DO TRAJETO DA BILE DESDE O FÍGADO ATÉ O DUODENO. PERMITE DIAGNOSTICAR OBSTRUÇÃO À PASSAGEM DA BILE, PROVOCADA POR TUMOR, CÁLCULO OU CORPO ESTRANHO. TAMBÉM PERMITE VERIFICAR O FUNCIONAMENTO DA AMPOLA DE VATER, LESÕES, ESTREITAMENTO OU DILATAÇÃO DOS DUCTOS BILIARES. ESTE EXAME TAMBÉM PODE SER FEITO POR OUTRAS VIAS ALÉM DA TRANSCUTÂNEA.  (POR RX – COLANGIOGRAFIA VENOSA, VIA ENDOSCÓPICA, TRANS-OPERATÓRIA, COLANGIOGRAFIA TRANSPARIETAL, TRANSHEPÁTICA E POR RESSONÂNCIA MAGNÉTICA).  A COLANGIOGRAFIA TRANS-HEPÁTICA PERCUTÂNEA É FEITA INJETANDO-SE MEIO DE CONTRASTE SOB VISÃO FLUOROSCÓPICA ATRAVÉS DE UMA AGULHA DE PEQUENO CALIBRE INTRODUZIDA NO PARÊNQUIMA DO FÍGADO E TEM VANTAGEM DE PERMITIR  DRENAGEM BILIAR, SE NECESSÁRIA. É UTILIZADO NO DIAGNÓS" ]
  ] [
     fhir:code [ fhir:v "0211010014" ] ;
     fhir:display [ fhir:v "CAPILAROSCOPIA" ] ;

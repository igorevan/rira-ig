     fhir:definition [ fhir:v "CONSISTE NA COLETA DE SANGUE PERIFÉRICO REALIZADA EM TODO RECÉM-NASCIDO COM A FINALIDADE DE DETECTAR PRECOCEMENTE INDIVÍDUOS COM DOENÇAS METABÓLICAS, GENÉTICAS, ENZIMÁTICAS E ENDOCRINOLÓGICAS, PARA QUE POSSAM SER TRATADOS EM TEMPO OPORTUNO SE DIAGNOSTICADAS NESTE PERÍODO DA VIDA OU O MAIS PRECOCEMENTE POSSÍVEL. PARA REALIZAR O TESTE DO PEZINHO." ]
  ] [
     fhir:code [ fhir:v "0201020068" ] ;
     fhir:display [ fhir:v "COLETA DE SANGUE PARA TIPIFICAÇÃO DO ALELO HLA-B" ] ;
     fhir:definition [ fhir:v "COLETA DE AMOSTRA PARA A REALIZAÇÃO DE ENSAIOS MOLECULARES PARA DETECÇÃO DO ALELO HLA-B EM PESSOAS VIVENDO COM HIV (PVHIV) POR UM LABORATÓRIO DE REFERENCIA DO SUS." ]
  ] [
     fhir:code [ fhir:v "0202010015" ] ;
     fhir:display [ fhir:v "CLEARANCE OSMOLAR" ] ;
     fhir:definition [ fhir:v "CONSISTE NA REALIZAÇÃO DO EXAME QUE EXPRESSA A QUANTIDADE DE ÁGUA COM CARGA VARIÁVEL DE SOLUTO, DEPURADO DO PLASMA POR UNIDADE DE TEMPO. A DIFERENÇA ENTRE O VOLUME TOTAL DE URINA E O CLEARANCE OSMOLAR É CHAMADA CLEARANCE DE ÁGUA LIVRE. BASEADO NA PARTE DA FUNÇÃO TUBULAR QUE ENVOLVE REABSORÇÃO DE FLUIDOS E ELETRÓLITOS COM A FORMAÇÃO DE ÁGUA LIVRE, ESTA ATIVIDADE É UMA DAS ÚLTIMAS FUNÇÕES RENAIS A SER PERDIDA. QUANDO A REABSORÇÃO DE ÁGUA NÃO MAIS ACONTECE NORMALMENTE, A EXCREÇÃO DE ÁGUA LIVRE AUMENTA. MEDE A HABILIDADE DOS RINS EM MANTER A TONICIDADE E O BALANÇO HÍDRICO, SENDO ESTAS FUNÇÕES ESPECÍFICAS AVALIADAS POR MEDIDAS DE CONCENTRAÇÕES DE SOLUTOS DA URINA (TESTE DE CONCENTRAÇÃO E DILUIÇÃO). PODE SER UTILIZADO O SANGUE (TUBO SEM ANTICOAGULANTE) OU URINA (FRASCO SEM CONSERVANTE)." ]
  ] [
     fhir:code [ fhir:v "0202010023" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CAPACIDADE DE FIXACAO DO FERRO" ] ;
     fhir:definition [ fhir:v "REPRESENTA A PORÇÃO TOTAL DE FERRO LIGADA À TRANSFERRINA. A CAPACIDADE TOTAL DE COMBINAÇÃO DO FERRO AUMENTA EM PATOLOGIAS QUE REDUZEM AS RESERVAS DE FERRO (DEFICIÊNCIA DO METAL OU PERDA SANGUÍNEA ), OU QUE ELEVAM A PRODUÇÃO HEPÁTICA DE TRANSFERRINA (GESTAÇÃO E USO DE ANTICONCEPCIONAL ORAL) A CAPACIDADE TOTAL DIMINUI NA PATOLOGIAS EM QUE A QUANTIDADE DE FERRO ESTA AUMENTADA, COMO NA HEMOCROMATOSE" ]
  ] [
     fhir:code [ fhir:v "0202010031" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CROMATOGRAFIA DE AMINOACIDOS" ] ;
     fhir:definition [ fhir:v "A CROMATOGRAFIA  DE AMINOÁCIDOS E UTILIZADA NO RASTREAMENTO DE DOENÇAS DO METABOLISMO DOS AMINOÁCIDOS COMO, POR EXEMPLO, A HEMOCISTINURIA E A TIROSENEMIA. RESSALTA-SE QUE OS NÍVEIS DE AMINOÁCIDOS NO SANGUE SÃO DEPENDENTES DA IDADE E DO ESTADO NUTRICIONAL NO MOMENTO DA COLETA. A SUSPEITA CLINICA É EXTREMAMENTE IMPORTANTE NA INTERPRETAÇÃO DOS RESULTADOS." ]
  ] [
     fhir:code [ fhir:v "0202010040" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CURVA GLICEMICA (2 DOSAGENS)" ] ;
     fhir:definition [ fhir:v "CONSISTE NA COLETA DE SANGUE PARA MEDIR A GLICEMIA EM JEJUM, SEGUIDA DE OFERTA AO PACIENTE DE CERTA DOSE DE UM XAROPE AÇUCARADO E APOS UMA , DUAS OU TRÊS HORAS, CONFORME A SOLICITAÇÃO MEDICA, É FEITA UMA NOVA COLETA PARA DETERMINAR A GLICEMIA. TAMBÉM DENOMINADO DE TESTE ORAL DE TOLERÂNCIA À GLICOSE" ]
  ] [
     fhir:code [ fhir:v "0202010058" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CURVA GLICEMICA C/ INDUCAO POR CORTISONA ( 5 DOSAGENS)" ]
  ] [
     fhir:code [ fhir:v "0202010066" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CURVA GLICEMICA C/ INDUCAO POR CORTISONA (4 DOSAGENS)" ]
  ] [
     fhir:code [ fhir:v "0202010074" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE CURVA GLICEMICA CLASSICA (5 DOSAGENS)" ] ;
     fhir:definition [ fhir:v "É UTILIZADA NO DIAGNOSTICO DE DIABETES EM PACIENTES NOS QUAIS A GLICEMIA DE JEJUM NÃO FOI ESCLARECEDORA ENTRE 100 E 125 MG/DL. O EXAME COMPREENDE DOSAGENS SERIADAS DE GLICOSE (BASAL,30,60,90 E 120 MINUTOS) APOS ESTIMULO COM 75 GRAMAS DE GLICOSE POR VIA ORAL OU CONFORME SOLICITAÇÃO MEDICA." ]
  ] [
     fhir:code [ fhir:v "0202010082" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE OSMOLARIDADE" ]
  ] [
     fhir:code [ fhir:v "0202010090" ] ;
     fhir:display [ fhir:v "DOSAGEM DE 5-NUCLEOTIDASE" ] ;
     fhir:definition [ fhir:v "A 5-NUCLEOTIDASE É UMA FOSFATASE AMPLAMENTE DISTRIBUÍDA NOS TECIDOS E A DOSAGEM DESTA ENZIMA É USADA NO DIAGNOSTICO DE DOENÇAS HEPATOBILIARES. ENCONTRA-SE ELEVADA NA OBSTRUÇÃO BILIAR, NA COLESTASE INTRA-HEPÁTICA E NA CIRROSE BILIAR. AUMENTO DISCRETOS OU NÍVEIS NORMAIS SÃO ENCONTRADOS NAS DOENÇAS PARENQUIMATOSAS HEPÁTICAS. NÍVEIS ELEVADOS PODEM SER OBSERVADOS DURANTE O USO DE ANTICONVULSIVANTES. PODE SER DETERMINADA ATRAVÉS DE ESPECTROFOTOMETRIA CINÉTICA." ]
  ] [
     fhir:code [ fhir:v "0202010104" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ACETONA" ]
  ] [
     fhir:code [ fhir:v "0202010112" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ACIDO ASCORBICO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DO ACIDO ASCÓRBICO É ÚTIL NA DETECÇÃO DA DEFICIÊNCIA OU DA INGESTÃO EXCESSIVA DE VITAMINA C. ESSA VITAMINA ESTA ENVOLVIDA NA CONVERSÃO DO TROPOCOLÁGENO PARA COLÁGENO, NA ESTEROIDOGENESE E NO METABOLISMO DA TIROSINA E DO ACIDO FÓLICO. A DEFICIÊNCIA DA VITAMINA C PODE SER ENCONTRADA NO ESCORBUTO, NA SÍNDROME DA MÁ ABSORÇÃO, NO ALCOOLISMO, NA GRAVIDEZ, NO HIPERPARATIROIDISMO E NA INSUFICIÊNCIA RENAL." ]
  ] [
     fhir:code [ fhir:v "0202010120" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ACIDO URICO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DO ACIDO ÚRICO É ÚTIL NA AVALIAÇÃO DO METABOLISMO DAS PURINAS. ENCONTRA-SE ALTERADO EM DIVERSAS CONDIÇÕES CLINICO-PATOLÓGICAS COMO, POR EXEMPLO, A GOTA. UTILIZADO TAMBÉM PARA MONITORAR PACIENTES EM QUIMIOTERAPIA OU RADIOTERAPIA." ]
  ] [
     fhir:code [ fhir:v "0202010139" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ACIDO VANILMANDELICO" ] ;
     fhir:definition [ fhir:v "O ÁCIDO VANILMANDELICO É O METABOLITO FINAL COMUM DAS CATECOLAMINAS (ADRENALINA E NORADRENALINA) E SUA EXCREÇÃO URINARIA ESTA AUMENTADA EM PACIENTES PORTADORES DE FEOCROMOCITOMA, GANGLIONEUROMA E NEUROBLASTOMA. OS EU DOSEAMENTO, PREFERIVELMENTE, É EFETUADO EM UMA AMOSTRA DE URINA DE 24 HS PELO MÉTODO CROMATOGRAFIA LIQUIDA DE ALTA DEFINIÇÃO (HPLC)." ]
  ] [
     fhir:code [ fhir:v "0202010147" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ALDOLASE" ] ;
     fhir:definition [ fhir:v "A ALDOLASE É UMA ENZIMA ESSENCIALMENTE CITOPLASMÁTICA E É ENCONTRADA EM TODOS OS TECIDOS EM QUE OCORRE GLICÓLISE OU GLICOGENÓLISE. O AUMENTO DA ATIVIDADE DESSA ENZIMA É OBSERVADA PRINCIPALMENTE NAS DESORDENS MUSCULARES" ]
  ] [
     fhir:code [ fhir:v "0202010155" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ALFA-1-ANTITRIPSINA" ] ;
     fhir:definition [ fhir:v "A ALFA-1-ANTITRIPSINA É UMA GLICOPROTEÍNA SINTETIZADA NO FÍGADO. A DEFICIÊNCIA DESSA GLICOPROTEÍNA É UMA DOENÇA GENÉTICA CARACTERIZADA POR VARIAÇÕES SEVERAS EM SEUS NÍVEIS. PODE ESTAR ASSOCIADA COM DOENÇA PULMONAR NA INFÂNCIA E/OU DOENÇA DO FÍGADO. A ALFA-1-ANTITRIPSINA É UMA PROTEÍNA DE FASE AGUDA QUE SE ELEVA EM INÚMERAS DOENÇAS INFLAMATÓRIAS, NEOPLASIAS E DOENÇAS HEPÁTICAS." ]
  ] [
     fhir:code [ fhir:v "0202010163" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ALFA-1-GLICOPROTEINA ACIDA" ]
  ] [
     fhir:code [ fhir:v "0202010171" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ALFA-2-MACROGLOBULINA" ] ;
     fhir:definition [ fhir:v "A ALFA-2-MACROGLOBULINA ESTÁ RELACIONADA AO TRANSPORTE HORMONAL E À INIBIÇÃO DE ENZIMAS PROTEOLÍTICAS. CRIANÇAS SAUDÁVEIS PODEM APRESENTAR NÍVEIS MAIS ALTOS QUE OS ADULTOS. HOMENS ENTRE 30 E 50 ANOS PODEM TER ÍNDICES DIMINUÍDOS, TALVEZ COMO REFLEXOS DE ESTRESSE E INFLUÊNCIAS HORMONAIS." ]
  ] [
     fhir:code [ fhir:v "0202010180" ] ;
     fhir:display [ fhir:v "DOSAGEM DE AMILASE" ] ;
     fhir:definition [ fhir:v "A AMILASE É HIDROLASE QUE DEGRADA COMPLEXOS DE CARBOIDRATOS, SENDO, PREDOMINANTEMENTE, DE ORIGEM PANCRÁTICA E GLÂNDULA SALIVAR. A DETERMINAÇÃO DA SUA DOSAGEM ESTÁ INDICADA NO DIAGNÓSTICO DIFERENCIAL DO QUADRO DE ABDOME AGUDO, ESPECIALMENTE, NA PANCREATITE AGUDA E NOS CASOS DE PAROTIDITE." ]
  ] [
     fhir:code [ fhir:v "0202010198" ] ;
     fhir:display [ fhir:v "DOSAGEM DE AMONIA" ] ;
     fhir:definition [ fhir:v "A AMÔNIA É UTILIZADA NA AVALIAÇÃO DA INSUFICIÊNCIA E DO COMA HEPÁTICO. PODE ESTAR ELEVADA, POR EXEMPLO, NO CHOQUE E NA INSUFICIÊNCIA CARDÍACA CONGESTIVA." ]
  ] [
     fhir:code [ fhir:v "0202010201" ] ;
     fhir:display [ fhir:v "DOSAGEM DE BILIRRUBINA TOTAL E FRACOES" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE BILIRRUBINA TOTAL E FRAÇÕES É ÚTIL NA AVALIAÇÃO DE HEPATOPATIAS E DE QUADROS HEMOLÍTICOS, EM PARTICULAR, NA AVALIAÇÃO DA ICTERÍCIA DO RECÉM-NASCIDO" ]
  ] [
     fhir:code [ fhir:v "0202010210" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CALCIO" ] ;
     fhir:definition [ fhir:v "O CÁLCIO É ENCONTRADO NAS CARTILAGENS, DENTES E, PRINCIPALMENTE, NOS OSSOS. A DOSAGEM DE CÁLCIO É ÚTIL NO DIAGNÓSTICO DE DISTÚRBIOS DO METABOLISMO DE CÁLCIO E FÓSFORO, INCLUINDO DOENÇAS ÓSSEAS, NEFROLÓGICAS E NEOPLÁSICAS." ]
  ] [
     fhir:code [ fhir:v "0202010228" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CALCIO IONIZAVEL" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE CÁLCIO IONIZÁVEL NÃO É AFETADA PELAS MUDANÇAS NAS CONCENTRAÇÕES DE ALBUMINA. ISSO É UMA VANTAGEM SOBRE A DOSAGEM DO CÁLCIO TOTAL, SENDO  ÚTIL NO DIAGNÓSTICO DE HIPERPARATIREOIDISMO. ALÉM DISSO, A DETERMINAÇÃO DO CÁLCIO IONIZÁVEL OFERECE, EM RELAÇÃO AO CÁLCIO TOTAL, A VANTAGEM DE REFERIR-SE À FRAÇÃO DO ELEMENTO FISIOLOGICAMENTE ATUANTE." ]
  ] [
     fhir:code [ fhir:v "0202010236" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CAROTENO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE CAROTENO É UTILIZADA NO RASTREAMENTO DA MÁ ABSORÇÃO DE GORDURAS E  NO DIAGNÓSTICO DE CAROTENODERMIA. ALTOS NÍVEIS SÉRICOS PODEM SER DETECTADOS DEVIDO À INGESTÃO DE GRANDES QUANTIDADES DE VEGETAIS E/OU COMPLEXOS VITAMÍNICOS. ENQUANTO QUE  BAIXOS NÍVEIS PODEM SER ENCONTRADOS EM CASOS DE ESTEATORRÉIA." ]
  ] [
     fhir:code [ fhir:v "0202010244" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CATECOLAMINAS" ] ;
     fhir:definition [ fhir:v "AS CATECOLAMINAS (EPINEFRINA, NOREPINEFRINA E DOPAMINA) SÃO HORMÔNIOS DA MEDULA SUPRA-RENAL. A PRINCIPAL INDICAÇÃO CLÍNICA PARA A DOSAGEM DE CATECOLAMINAS É NO DIAGNÓSTICO DO FEOCROMOCITOMA." ]
  ] [
     fhir:code [ fhir:v "0202010252" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CERULOPLASMINA" ] ;
     fhir:definition [ fhir:v "A CERULOPLASMINA É UMA PROTEÍNA DE FASE AGUDA, PODENDO APRESENTAR NÍVEIS ELEVADOS EM TUMORES, INFLAMAÇÕES AGUDAS E CRÔNICAS. CERCA DE 95% DO COBRE PLASMÁTICO ESTÁ LIGADO À CERULOPLASMINA. A ATIVIDADE DESTA PROTEÍNA É AUMENTADA PELO USO DE ESTRÓGENOS E FENITOÍNA. É ÚTIL NO DIAGNÓSTICO DA DOENÇA DE WILSON" ]
  ] [
     fhir:code [ fhir:v "0202010260" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CLORETO" ] ;
     fhir:definition [ fhir:v "A CERULOPLASMINA É UMA PROTEÍNA DE FASE AGUDA, PODENDO APRESENTAR NÍVEIS ELEVADOS EM TUMORES, INFLAMAÇÕES AGUDAS E CRÔNICAS. CERCA DE 95% DO COBRE PLASMÁTICO ESTÁ LIGADO À CERULOPLASMINA. A ATIVIDADE DESTA PROTEÍNA É AUMENTADA PELO USO DE ESTRÓGENOS E FENITOÍNA." ]
  ] [
     fhir:code [ fhir:v "0202010279" ] ;
     fhir:display [ fhir:v "DOSAGEM DE COLESTEROL HDL" ] ;
     fhir:definition [ fhir:v "A FRAÇÃO HDL DO COLESTEROL É PROTETORA CONTRA DOENÇA ARTERIAL CORONARIANA SEGUNDO GRANDE NÚMERO DE ESTUDOS POPULACIONAIS, PORTANTO, AVALIA O RISCO DE DOENÇA ATEROSCLERÓTICA." ]
  ] [
     fhir:code [ fhir:v "0202010287" ] ;
     fhir:display [ fhir:v "DOSAGEM DE COLESTEROL LDL" ] ;
     fhir:definition [ fhir:v "A FRAÇÃO LDL DO COLESTEROL ESTÁ ASSOCIADO AO RISCO AUMENTADO DA DOENÇA ARTERIAL CORONARIANA. AS LIPOPROTEÍNAS DE BAIXA DENSIDADE SÃO AS PRINCIPAIS PROTEÍNAS DE TRANSPORTE DO COLESTEROL. SEUS NÍVEIS TAMBÉM SE ELEVAM NA SÍNDROME NEFRÓTICA, HIPOTIREOIDISMO E ICTERÍCIA OBSTRUTIVA." ]
  ] [
     fhir:code [ fhir:v "0202010295" ] ;
     fhir:display [ fhir:v "DOSAGEM DE COLESTEROL TOTAL" ]
  ] [
     fhir:code [ fhir:v "0202010309" ] ;
     fhir:display [ fhir:v "DOSAGEM DE COLINESTERASE" ] ;
     fhir:definition [ fhir:v "HÁ DOIS TIPOS DE COLINESTERASE NO ORGANISMO. A COLINESTERASE É ENCONTRADA NAS HEMÁCIAS E NAS SINAPSES DO SISTEMA NERVOSO (VERDADEIRA COLINESTERASE - ACETILCOLINESTERASE) E, TAMBÉM, É ENCONTRADA NO SORO (PSEUDOCOLINESTERASE), QUE É SINTETIZADA PELO FÍGADO E DOSADA LABORATORIALMENTE.  AS DOSAGENS DE COLINESTERASE SÃO OS PARÂMETROS PARA CONTROLE BIOLÓGICO DA EXPOSIÇÃO AOS ORGANOFOSFORADOS E AOS CARBAMATOS." ]
  ] [
     fhir:code [ fhir:v "0202010317" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CREATININA" ] ;
     fhir:definition [ fhir:v "A CREATININA É O PRODUTO DE DEGRADAÇÃO DA CREATINA E SUA DOSAGEM É ÚTIL NA AVALIAÇÃO E NO MONITORAMENTO DA FUNÇÃO EXCRETORA RENAL." ]
  ] [
     fhir:code [ fhir:v "0202010325" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CREATINOFOSFOQUINASE (CPK)" ] ;
     fhir:definition [ fhir:v "A CREATINOFOSFOQUINASE É UMA ENZIMA ENCONTRADA PRINCIPALMENTE NA MUSCULATURA ESTRIADA, CÉREBRO E CORAÇÃO. É UM MARCADOR SENSÍVEL, MAS INESPECÍFICO, DE LESÃO MIOCÁRDICA. NÍVEIS ELEVADOS SÃO ENCONTRADOS, POR EXEMPLO, NO INFARTO AGUDO DO MIOCÁRDIO, NA DISTROFIA MUSCULAR E NO EXERCÍCIO FÍSICO." ]
  ] [
     fhir:code [ fhir:v "0202010333" ] ;
     fhir:display [ fhir:v "DOSAGEM DE CREATINOFOSFOQUINASE FRACAO MB" ] ;
     fhir:definition [ fhir:v "A CREATINOFOSFOQUINASE FRAÇÃO MB É CONSIDERADA O MARCADOR BIOQUÍMICO DE REFERÊNCIA PARA O DIAGNÓSTICO DE LESÃO MIOCÁRDICA E TEM SIDO A BASE PARA COMPARAÇÃO COM OUTROS MARCADORES." ]
  ] [
     fhir:code [ fhir:v "0202010341" ] ;
     fhir:display [ fhir:v "DOSAGEM DE DESIDROGENASE ALFA-HIDROXIBUTIRICA" ]
  ] [
     fhir:code [ fhir:v "0202010350" ] ;
     fhir:display [ fhir:v "DOSAGEM DE DESIDROGENASE GLUTAMICA" ] ;
     fhir:definition [ fhir:v "A DESIDROGENASE GLUTÂMICA É UMA ENZIMA MITOCONDRIAL. ESSA ENZIMA É ENCONTRADA, EM QUANTIDADES MÍNIMAS, NO SORO. ENQUANTO QUE EM SITUAÇÃO DE DOENÇA HEPÁTICA É ENCONTRADA COM ATIVIDADE AUMENTADA." ]
  ] [
     fhir:code [ fhir:v "0202010368" ] ;
     fhir:display [ fhir:v "DOSAGEM DE DESIDROGENASE LATICA" ] ;
     fhir:definition [ fhir:v "A DESIDROGENASE LÁTICA É UMA ENZIMA QUE CATALIZA A CONVERSÃO DE LACTATO A PIRUVATO E É LIBERADA EM QUADROS DE INJÚRIA TISSULAR. PORTANTO A ELEVAÇÃO DOS NÍVEIS DE DESIDROGENASE LÁTICA OCORRE, POR EXEMPLO, EM NEOPLASIAS, HIPÓXIA, CARDIOPATIAS, INFLAMAÇÕES, HIPOTIREOIDISMO, HEPATITES, PANCREATITE E OBSTRUÇÃO INTESTINAL." ]
  ] [
     fhir:code [ fhir:v "0202010376" ] ;
     fhir:display [ fhir:v "DOSAGEM DE DESIDROGENASE LATICA (ISOENZIMAS FRACIONADAS)" ]
  ] [
     fhir:code [ fhir:v "0202010384" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FERRITINA" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE FERRITINA REFLETE O NÍVEL DE ESTOQUE CELULAR DE FERRO. PORTANTO, É UTILIZADO NO DIAGNÓSTICO E SEGUIMENTO DE ANEMIAS FERROPRIVAS E HEMOCROMATOSE." ]
  ] [
     fhir:code [ fhir:v "0202010392" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FERRO SERICO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE FERRO SÉRICO É ÚTIL NO DIAGNÓSTICO DIFERENCIAL DE ANEMIAS, HEMOCROMATOSE E HEMOSSIDEROSE. ENCONTRA-SE NÍVEIS BAIXOS NA ANEMIA FERROPRIVA, GLOMERULOPATIAS, MENSTRUAÇÃO E FASES INICIAIS DE REMISSÃO DA ANEMIA PERNICIOSA." ]
  ] [
     fhir:code [ fhir:v "0202010406" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FOLATO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE FOLATO É INDICADA PARA A DETERMINAÇÃO DA DEFICIÊNCIA DE ÁCIDO FÓLICO E PARA O MONITORAMENTO DA TERAPIA COM FOLATO. DEVE SER INCLUÍDA NA INVESTIGAÇÃO DA ETIOLOGIA DE ANEMIAS MACROCÍTICA E MEGALOBLÁSTICA, NO ALCOOLISMO E NA SÍNDROME DA ALÇA CEGA INTESTINAL." ]
  ] [
     fhir:code [ fhir:v "0202010414" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FOSFATASE ACIDA TOTAL" ] ;
     fhir:definition [ fhir:v "A FOSFATASE ÁCIDA TOTAL, EM PESSOAS DO SEXO MASCULINO, É REPRESENTADA EM 50% PELA FRAÇÃO PROSTÁTICA. JÁ EM INDIVÍDUOS DO SEXO FEMININO A FOSFATASE ÁCIDA TOTAL É PROVENIENTE DO FÍGADO, DOS ERITRÓCITOS E DAS PLAQUETAS. PORTANTO, ENCONTRA-SE AUMENTADA, POR EXEMPLO, EM PROCESSOS DE EXCESSIVA DESTRUIÇÃO PLAQUETÁRIA, DOENÇAS HEMOLÍTICAS, METÁSTASE DE CÂNCER ÓSSEO E NO CÂNCER DE PRÓSTATA ( NOS CASOS EM QUE HÁ AUMENTO DOS NÍVEIS DA FRAÇÃO PROSTÁTICA)." ]
  ] [
     fhir:code [ fhir:v "0202010422" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FOSFATASE ALCALINA" ] ;
     fhir:definition [ fhir:v "A FOSFATASE ALCALINA POSSUI DUAS ISOENZIMAS. UMA  DELAS É DE ORIGEM HEPÁTICA E AVALIA DE MANEIRA SIGNIFICATIVA OS CASOS DE OBSTRUÇÃO BILIAR, A OUTRA É DE ORIGEM ÓSSEA E AVALIA AS DOENÇAS QUE AFETAM A ATIVIDADE OSTEOBLÁSTICA." ]
  ] [
     fhir:code [ fhir:v "0202010430" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FOSFORO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE FÓSFORO É IMPORTANTE PARA A AVALIAÇÃO DO BALANÇO CÁLCIO/FÓSFORO NO ORGANISMO E PARA O MONITORAMENTO DA INSUFICIÊNCIA RENAL CRÔNICA." ]
  ] [
     fhir:code [ fhir:v "0202010449" ] ;
     fhir:display [ fhir:v "DOSAGEM DE FRACAO PROSTATICA DA FOSFATASE ACIDA" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DA FRAÇÃO PROSTÁTICA DA FOSFATASE ÁCIDA AUXILIA NO DIAGNÓSTICO DO CARCINOMA PROSTÁTICO E NO MONITORAMENTO DA TERAPIA." ]
  ] [
     fhir:code [ fhir:v "0202010457" ] ;
     fhir:display [ fhir:v "DOSAGEM DE GALACTOSE" ] ;
     fhir:definition [ fhir:v "A PRESENÇA DE GALACTOSE NO SANGUE REPRESENTA ANORMALIDADE AUTOSSÔMICA RECESSIVA, QUE CURSA COM AUSÊNCIA DA  ENZIMA  GALACTOSE 1-FOSFATO-URIDIL- TRANSFERASE QUE CONVERTE A GALACTOSE EM GLICOSE." ]
  ] [
     fhir:code [ fhir:v "0202010465" ] ;
     fhir:display [ fhir:v "DOSAGEM DE GAMA-GLUTAMIL-TRANSFERASE (GAMA GT)" ] ;
     fhir:definition [ fhir:v "A GAMA GT É UM MARCADOR SENSÍVEL DE COLESTASE HEPATOBILIAR E DE USO DO ÁLCOOL. TENDE A SE ELEVAR EM DOENÇAS HEPÁTICAS E PANCREÁTICAS. A LIBRAÇÃO DE GAMA GT NO SORO REFLETE O EFEITO TÓXICO DO ÁLCOOL E OUTRAS DROGAS NA ESTRUTURA MICROSSOMAL NAS CÉLULAS HEPÁTICAS." ]
  ] [
     fhir:code [ fhir:v "0202010473" ] ;
     fhir:display [ fhir:v "DOSAGEM DE GLICOSE" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE GLICOSE, TAMBÉM CHAMADA DE GLICEMIA,  É UTILIZADA NO DIAGNÓSTICO E NO MONITORAMENTO DO DIABETES MELLITUS E NOS DISTÚRBIOS DA HOMEOSTASE GLICÊMICA. ALÉM DISSO, É ÚTIL NO RASTREAMENTO DO DIABETES GESTACIONAL." ]
  ] [
     fhir:code [ fhir:v "0202010481" ] ;
     fhir:display [ fhir:v "DOSAGEM DE GLICOSE-6-FOSFATO DESIDROGENASE" ] ;
     fhir:definition [ fhir:v "A DEFICIÊNCIA DE GLICOSE-6-FOSFATO DESIDROGENASE É UMA ENZIMOPATIA COMUM (GENÉTICA) LIGADA AO CROMOSSOMO X, COM INCIDÊNCIA EM ATÉ 10% DA POPULAÇÃO. PODE LEVAR A CRISES DE HEMÓLISE, INDUZIDA POR DROGAS, POR INFECÇÕES BACTERIANAS E VIRÓTICAS E PELA INGESTÃO DE FAVA. PODE SE MANIFESTAR COMO ANEMIA ESFEROCÍTICA E ICTERÍA NEONATAL." ]
  ] [
     fhir:code [ fhir:v "0202010490" ] ;
     fhir:display [ fhir:v "DOSAGEM DE HAPTOGLOBINA" ] ;
     fhir:definition [ fhir:v "A SÍNTESE DE HAPTOGLOBINA É ESTIMULADA PELA INFLAMAÇÃO. A HAPTOGLOBINA É UMA GLOBINA SINTETIZADA PELO FÍGADO E QUE SE LIGA À HEMOGLOBINA LIVRE. ESSA LIGAÇÃO É RESPONSÁVEL PELA DIMINUIÇÃO DOS NÍVEIS EM EPISÓDIOS AGUDOS DE HEMÓLISE." ]
  ] [
     fhir:code [ fhir:v "0202010503" ] ;
     fhir:display [ fhir:v "DOSAGEM DE HEMOGLOBINA GLICOSILADA" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE HEMOGLOBINA GLICOSILADA É UTILIZADA PARA O MONITORAMENTO DE PACIENTES DIABÉTICOS E, TAMBÉM, O DIAGNÓSTICO INICIAL, JÁ QUE REFLETE A GLICEMIA MÉDIA DOS ÚLTIMOS 90 A 120 DIAS. APRESENTA ELEVADO VALOR PREDITIVO POSITIVO PARA AS COMPLICAÇÕES CLÍNICAS DIABÉTICAS E APRESENTA BOA CORRELAÇÃO COM OS NÍVEIS DECISÓRIOS DE GLICOSE PLASMÁTICA." ]
  ] [
     fhir:code [ fhir:v "0202010511" ] ;
     fhir:display [ fhir:v "DOSAGEM DE HIDROXIPROLINA" ] ;
     fhir:definition [ fhir:v "A HIDROXIPROLINA É UM AMINOÁCIDO BASTANTE FREQÜENTE NA COMPOSIÇÃO DO COLÁGENO E SUA EXCREÇÃO URINÁRIA REFLETE EM PARTE A REABSORÇÃO DA MATRIZ ÓSSEA. MAIS RECENTEMENTE A DOSAGEM DA HIDROXIPROLINA NA URINA DE 24 HORAS FOI SUBSTITUÍDA PELA DOSAGEM DESSE AMINOÁCIDO NA URINA COLHIDA DURANTE 2 HORAS APÓS JEJUM DE 10 HORAS. MÉTODO: HPLC (CROMATOGRAFIA LIQUIDA DE ALTA DEFINIÇÃO). SINONÍMIA: OH PROLINA" ]
  ] [
     fhir:code [ fhir:v "0202010520" ] ;
     fhir:display [ fhir:v "DOSAGEM DE ISOMERASE-FOSFOHEXOSE" ] ;
     fhir:definition [ fhir:v "A ENZIMA ISOMERASE-FOSFOHEXOSE CATALISA A ISOMERIZAÇÃO REVERSÍVEL DA GLICOSE 6-FOSFATO, UMA ALDOSE, EM FRUTOSE 6-FOSFATO, UMA CETOSE." ]
  ] [
     fhir:code [ fhir:v "0202010538" ] ;
     fhir:display [ fhir:v "DOSAGEM DE LACTATO" ] ;
     fhir:definition [ fhir:v "O LACTATO É PRODUZIDO PELO ORGANISMO APÓS A GLICÓLISE, PARA O FORNECIMENTO DE ENERGIA EM CONDIÇÕES ANAERÓBICAS. DESSA FORMA, A DETERMINAÇÃO DA CONCENTRAÇÃO SANGUÍNEA DO LACTATO PERMITE AVALIAR, INDIRETAMENTE, A ACIDOSE METABÓLICA APÓS A ATIVIDADE FÍSICA E EM SITUAÇÕES PATOLÓGICAS NAS QUAIS ESTA VIA DE OBTENÇÃO DE ENERGIA FOI UTILIZADA." ]
  ] [
     fhir:code [ fhir:v "0202010546" ] ;
     fhir:display [ fhir:v "DOSAGEM DE LEUCINO-AMINOPEPTIDASE" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE LEUCINO-AMINOPEPTIDASE É ÚTIL NA AVALIAÇÃO DE DOENÇAS HEPATOBILIARES E ÓSSEAS QUANDO A FOSFATASE ALCALINA SE ENCONTRA ELEVADA." ]
  ] [
     fhir:code [ fhir:v "0202010554" ] ;
     fhir:display [ fhir:v "DOSAGEM DE LIPASE" ] ;
     fhir:definition [ fhir:v "A LIPASE É UMA ENZIMA PRODUZIDA MAJORITARIAMENTE NO PÂNCREAS E É UM MARCADOR PRIMORDIAL DE DOENÇA PANCREÁTICA. OS NÍVEIS DE LIPASE FICAM ELEVADOS, PRINCIPALMENTE, NA PANCREATITE AGUDA E, FREQUENTEMENTE, NA PANCREATITE CRÔNICA." ]
  ] [
     fhir:code [ fhir:v "0202010562" ] ;
     fhir:display [ fhir:v "DOSAGEM DE MAGNESIO" ] ;
     fhir:definition [ fhir:v "O MAGNÉSIO É UM DOS CÁTIONS MAIS ABUNDANTES NO ORGANISMO HUMANO, ATUANDO COMO COFATOR ESSENCIAL PARA ENZIMAS LIGADAS À RESPIRAÇÃO CELULAR, À GLICÓLISE E AO TRANSPORTE DE OUTROS CÁTIONS. ALÉM DISSO, O MAGNÉSIO É ESSENCIAL PARA A PRESERVAÇÃO DA ESTRUTURA MOLECULAR DO DNA, DO RNA E DOS RIBOSSOMOS." ]
  ] [
     fhir:code [ fhir:v "0202010570" ] ;
     fhir:display [ fhir:v "DOSAGEM DE MUCO-PROTEINAS" ] ;
     fhir:definition [ fhir:v "AS MUCOPROTEÍNAS SÃO GLICOPROTEÍNAS DE FASE AGUDA. ELEVAM-SE, CONSIDERAVELMENTE, NOS PROCESSOS INFLAMATÓRIOS AGUDOS, CONSTITUINDO UM IMPORTANTE ÍNDICE DA ATIVIDADE REUMÁTICA." ]
  ] [
     fhir:code [ fhir:v "0202010589" ] ;
     fhir:display [ fhir:v "DOSAGEM DE PIRUVATO" ] ;
     fhir:definition [ fhir:v "O PIRUVATO É ORIGINADO PELA QUEBRA DA GLICOSE E PODE SER CONVERTIDO EM LACTATO, ALANINA OU OXALOACETATO OU, ENTÃO, DEGRADADO DANDO ORIGEM AO ACETIL-COA E AO GÁS CARBÔNICO. O PIRUVATO PODE SE ACUMULAR POR EXCESSO DE PRODUÇÃO OU POR METABOLIZAÇÃO DEFICIENTE. A DOSAGEM DE PIRUVATO, EM CONJUNTO COM O LACTATO, É ÚTIL NA AVALIAÇÃO DE DIVERSOS DESARRANJOS METABÓLICOS." ]
  ] [
     fhir:code [ fhir:v "0202010597" ] ;
     fhir:display [ fhir:v "DOSAGEM DE PORFIRINAS" ] ;
     fhir:definition [ fhir:v "AS PORFIRINAS SÃO DESORDENS HEREDITÁRIAS OU ADQUIRIDAS DE ENZIMAS ESPECÍFICAS NA BIOSSÍNTESE DO HEME. AS PORFIRINAS SÃO CLASSIFICADAS EM HEPÁTICAS OU EM ERITROPOIÉTICAS, DEPENDENDO DO SÍTIO PRIMÁRIO DE SUPERPRODUÇÃO OU ACUMULAÇÃO DA PORFIRINA OU DO SEU PRECURSOR. OS PRODUTOS DO METABOLISMO INTERMEDIÁRIO DO HEME OU SEU DERIVADOS SÃO EXCRETADOS NA URINA NESSAS PATOLOGIAS." ]
  ] [
     fhir:code [ fhir:v "0202010600" ] ;
     fhir:display [ fhir:v "DOSAGEM DE POTASSIO" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE POTÁSSIO É ÚTIL NA AVALIAÇÃO DO EQUILÍBRIO HIDROELETROLÍTICO E ACIDOBÁSICO. A MONITORIZAÇÃO DO POTÁSSIO É UTILIZADA NO ACOMPANHAMENTO DE PACIENTES EM TERAPIA COM DIURÉTICOS, EM NEFROPATIAS, NA CETOACIDOSE DIABÉTICA, NO MANEJO DA HIDRATAÇÃO PARENTERAL E NA INSUFICIÊNCIA HEPÁTICA." ]
  ] [
     fhir:code [ fhir:v "0202010619" ] ;
     fhir:display [ fhir:v "DOSAGEM DE PROTEINAS TOTAIS" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE PROTEÍNAS TOTAIS É UTILIZADA NA AVALIAÇÃO DO ESTADO NUTRICIONAL E NA INVESTIGAÇÃO DE EDEMAS." ]
  ] [
     fhir:code [ fhir:v "0202010627" ] ;
     fhir:display [ fhir:v "DOSAGEM DE PROTEINAS TOTAIS E FRACOES" ] ;
     fhir:definition [ fhir:v "A ALBUMINA É A PROTEÍNA MAIS ABUNDANTE NO PLASMA E SUA FUNÇÃO PRIMÁRIA É MANTER A PRESSÃO COLOIDOSMÓTICA DO PLASMA. EM CONDIÇÕES NORMAIS, ESPERA-SE ENCONTRAR UMA RAZÃO ALBUMINA/GLOBULINA MAIOR OU IGUAL A 1." ]
  ] [
     fhir:code [ fhir:v "0202010635" ] ;
     fhir:display [ fhir:v "DOSAGEM DE SODIO" ] ;
     fhir:definition [ fhir:v "O SÓDIO É O PRINCIPAL CÁTION EXTRACELULAR, ALÉM DISSO É O DETERMINANTE PRIMORDIAL DA OSMOLARIDADE CELULAR. ALGUNS FATORES REGULAM A HOMEOSTASIA DO BALANÇO DO SÓDIO, TAIS COMO, ALDOSTERONA E HORMÔNIO ANTIDIURÉTICO. A DOSAGEM DE SÓDIO É ÚTIL NA AVALIAÇÃO DOS DISTÚRBIOS HIDROELETROLÍTICOS." ]
  ] [
     fhir:code [ fhir:v "0202010643" ] ;
     fhir:display [ fhir:v "DOSAGEM DE TRANSAMINASE GLUTAMICO-OXALACETICA (TGO)" ] ;
     fhir:definition [ fhir:v "A TRANSAMINASE GLUTAMICO-OXALACETICA É UMA ENZIMA ENCONTRADA EM ALTAS QUANTIDADES NO MÚSCULO CARDÍACO, ESQUELÉTICO, CÉLULAS HEPÁTICAS E, EM MENOR QUANTIDADE, NO PÂNCREAS E NOS RINS. A DOSAGEM DE TRANSAMINASE GLUTAMICO-OXALACETICA É ÚTIL, POR EXEMPLO, NO DIAGNÓSTICO DO INFARTO DO MIOCÁRDIO, DAS DOENÇAS HEPÁTICAS, DA PANCREATITE AGUDA, DA OPERAÇÃO CARDÍACA, DA CATETERIZAÇÃO CARDÍACA, DA DISTROFIA MUSCULAR, DA MONONUCLEOSE, DA DOENÇA RENAL AGUDAE DE CONVULSÕES RECENTES." ]
  ] [
     fhir:code [ fhir:v "0202010651" ] ;
     fhir:display [ fhir:v "DOSAGEM DE TRANSAMINASE GLUTAMICO-PIRUVICA (TGP)" ] ;
     fhir:definition [ fhir:v "A TRANSAMINASE GLUTAMICO-PIRUVICA É ENCONTRADA, PRINCIPALMENTE, NO FÍGADO. A DOSAGEM DE TRANSAMINASE GLUTAMICO-PIRUVICA É ÚTIL NA AVALIAÇÃO DE HEPATOPATIAS." ]
  ] [
     fhir:code [ fhir:v "0202010660" ] ;
     fhir:display [ fhir:v "DOSAGEM DE TRANSFERRINA" ] ;
     fhir:definition [ fhir:v "A TRANSFERRINA É UMA GLICOPROTEÍNA  SINTETIZADA NO FÍGADO. É A PRINCIPAL PROTEÍNA PLASMÁTICA TRANSPORTADORA DE FERRO, SENDO QUE OCORREM VARIAÇÕES EM SUAS CONCENTRAÇÕES EM RESPOSTA A DEFICIÊNCIA DE FERRO E EM DOENÇAS CRÔNICAS. A DOSAGEM DE TRANSFERRINA É UTILIZADA NO DIAGNÓSTICO E NO MONITORAMENTO DE ANEMIAS." ]
  ] [
     fhir:code [ fhir:v "0202010678" ] ;
     fhir:display [ fhir:v "DOSAGEM DE TRIGLICERIDEOS" ] ;
     fhir:definition [ fhir:v "A DOSAGEM DE TRIGLICERÍDEOS, EM CONJUNTO COM A DOSAGEM DO COLESTEROL, É UTILIZADA NA AVALIAÇÃO DO RISCO CÁRDIACO. OS TRIGLICERÍDEOS SÃO PRODUZIDOS NO FÍGADO E SÃO TRANSPORTADOS NO SANGUE POR VLDL E LDL." ]
  ] [
     fhir:code [ fhir:v "0202010686" ] ;
     fhir:display [ fhir:v "DOSAGEM DE TRIPTOFANO" ] ;
     fhir:definition [ fhir:v "O TRIPTOFANO É UM AMINOÁCIDO ESSENCIAL UTILIZADO PELO CÉREBRO, JUNTAMENTE COM A VITAMINA B3 E O MAGNÉSIO, PARA PRODUZIR A SEROTONINA, UM NEUROTRANSMISSOR IMPORTANTE NOS PROCESSOS BIOQUÍMICOS DO SONO E DO HUMOR." ]
  ] [
     fhir:code [ fhir:v "0202010694" ] ;
     fhir:display [ fhir:v "DOSAGEM DE UREIA" ] ;
     fhir:definition [ fhir:v "A UREIA É A PRINCIPAL FONTE DE EXCREÇÃO DO NITROGÊNIO, ORIGINA-SE DO METABOLISMO HEPÁTICO DAS PROTEÍNAS E É EXCRETADA NOS RINS. DESSA FORMA, A UREIA ESTÁ DIRETAMENTE RELACIONADA À FUNÇÃO METABÓLICA HEPÁTICA E À FUNÇÃO RENAL. SUA CONCENTRAÇÃO PODE VARIAR, POR EXEMPLO, COM A DIETA E COM A HIDRATAÇÃO." ]
  ] [
     fhir:code [ fhir:v "0202010708" ] ;
     fhir:display [ fhir:v "DOSAGEM DE VITAMINA B12" ] ;
     fhir:definition [ fhir:v "A VITAMINA B12 TEM PAPEL IMPORTANTE NA HEMATOPOIESE, NA FUNÇÃO NEURAL, NO METABOLISMO DO ÁCIDO FÓLICO E NA SÍNTESE ADEQUADA DE DNA. A ABSORÇÃO DE VITAMINA B12 É DEPENDENTE DA PRESENÇA DO FATOR INTRÍNSECO (SECRETADO PELA CÉLULAS PARIETAIS DO ESTÔMAGO)." ]
  ] [
     fhir:code [ fhir:v "0202010716" ] ;
     fhir:display [ fhir:v "ELETROFORESE DE LIPOPROTEINAS" ] ;
     fhir:definition [ fhir:v "A ELETROFORESE DE LIPOPROTEÍNAS É ÚTIL NA CARACTERIZAÇÃO DAS DISLIPIDEMIAS SECUNDÁRIAS E PRIMÁRIAS. OS LIPÍDEOS CIRCULAM NO PLASMA COMBINADOS A PROTEÍNAS E PODEM SER SEPARADOS POR MEIO DE ELETROFORESE, RECEBENDO NOMES DE ACORDO COM SUA MOBILIDADE: HDL (ALFA-LIPOPROTEÍNA) MIGRAM COM AS ALFA-1-GLOBULINAS; LDL (BETA-LIPOPROTEÍNAS) MIGRAM COM AS BETA-GLOBULINAS; VLDL (PRÉ-BETALIPOPROTEINAS) MIGRAM COM AS ALFA-2- GLOBULINAS; E QUILOMÍCRONS." ]
  ] [
     fhir:code [ fhir:v "0202010724" ] ;
     fhir:display [ fhir:v "ELETROFORESE DE PROTEINAS" ] ;
     fhir:definition [ fhir:v "ELETROFORESE É UMA TÉCNICA LABORATORIAL USADA PARA SEPARAR OS GRUPOS DE PROTEÍNAS DO SORO. A ELETROFORESE DE PROTEÍNAS É UTILIZADA NA TRIAGEM DE ANORMALIDADES DAS PROTEÍNAS SÉRICAS. AS PRINCIPAIS FRAÇÕES PROTEICAS, DE ACORDO COM A ELETROPOSITIVIDADE SÃO AS SEGUINTES: ALBUMINA, ALFA 1 GLOBULINA, ALFA 2 GLOBULINA, BETAGLOBULINA E GAMAGLOBULINA." ]
  ] [
     fhir:code [ fhir:v "0202010732" ] ;
     fhir:display [ fhir:v "GASOMETRIA (PH PCO2 PO2 BICARBONATO AS2 (EXCESSO OU DEFICIT BASE )" ] ;
     fhir:definition [ fhir:v "CONSISTE NO EXAME QUE É REALIZADO NO SANGUE RETIRADO POR PUNÇÃO DE UMA ARTÉRIA PARA MEDIR O OXIGÊNIO (O2), O GÁS CARBÔNICO (CO2) E O PH NO SANGUE ARTERIAL ANTES QUE HAJA O CONTATO COM OS TECIDOS CORPORAIS. AVALIA O EQUILÍBRIO ÁCIDO BÁSICO DO PACIENTE, EXPRESSANDO PRINCIPALMENTE SE OS PULMÕES ESTÃO SENDO CAPAZES DE FAZER CORRETAMENTE A TROCA DO OXIGÊNIO PELO DIÓXIDO DE CARBONO NOS ALVÉOLOS, AJUDANDO A DETERMINAR SE O PACIENTE TEM OU NÃO NECESSIDADE DE SUPLEMENTAÇÃO DE OXIGÊNIO, A AVALIAR A FUNÇÃO RENAL E A MONITORAR DOENÇAS PULMONARES, METABÓLICAS OU RENAIS QUE POSSAM CAUSAR DESEQUILÍBRIO ÁCIDO-BASE OU DIFICULDADES RESPIRATÓRIAS." ]
  ] [
     fhir:code [ fhir:v "0202010740" ] ;
     fhir:display [ fhir:v "PROVA DA D-XILOSE" ] ;
     fhir:definition [ fhir:v "A D-XILOSE É UMA PENTOSE ABSORVIDA PELO INTESTINO DELGADO E ELIMINADA PELOS RINS SEM SER METABOLIZADA NO FÍGADO. A PROVA DA D-XILOSE É UTILIZADA NO DIAGNÓSTICO DE MÁ-ABSORÇÃO INTESTINAL, O QUE PERMITE A AVALIAÇÃO DA ABSORÇÃO DE CARBOIDRATOS PELA MUCOSA DO INTESTINO DELGADO. DEVEM SER COLHIDAS DUAS AMOSTRAS. A 1ª AMOSTRA BASAL E A 2ª AMOSTRA UMA OU DUAS HORAS PÓS-ADMINISTRAÇÃO DE D-XILOSE POR VIA ORAL, DE ACORDO COM A SOLICITAÇÃO MÉDICA. É REALIZADA A DOSAGEM NO PLASMA PELO MÉTODO ESPECTROFOTOMÉTRICO" ]
  ] [
     fhir:code [ fhir:v "0202010759" ] ;
     fhir:display [ fhir:v "TESTE DE TOLERANCIA A INSULINA / HIPOGLICEMIANTES ORAIS" ]
  ] [
     fhir:code [ fhir:v "0202010767" ] ;
     fhir:display [ fhir:v "DOSAGEM DE 25 HIDROXIVITAMINA D" ] ;
     fhir:definition [ fhir:v "CONSISTE NA DOSAGEM SÉRICA DO COLECAL-CIFEROL OU 25-HIDROXIVITAMINA D, O METABÓLITO MAIS ATIVO DA VITAMINA D E DE MAIOR NÍVEL SÉRICO, PARA O DIAGNÓSTICO E MONITORIZAÇÃO TERAPÊUTICA DO RAQUITISMO E OSTEOMALÁCIA." ]
  ] [
     fhir:code [ fhir:v "0202010775" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE CREMATÓCRITO NO LEITE HUMANO ORDENHADO" ] ;
     fhir:definition [ fhir:v "CONSISTE NA ANALISE FISICO-QUIMICA DO LEITE HUMANO ORDENHADO VISANDO A DETERMINAÇÃO DO SEU CONTEÚDO ENÉRGETICO." ]
  ] [
     fhir:code [ fhir:v "0202010783" ] ;
     fhir:display [ fhir:v "ACIDEZ TITULÁVEL NO LEITE HUMANO (DORNIC)" ] ;
     fhir:definition [ fhir:v "CONSISTE NA DETERMINAÇÃO DA ACIDEZ DORNIC NO LEITE HUMANO ORDENHADO." ]
  ] [
     fhir:code [ fhir:v "0202010791" ] ;
     fhir:display [ fhir:v "DOSAGEM DE PEPTÍDEOS NATRIURÉTICOS TIPO B (BNP E NT-PROBNP)" ] ;
     fhir:definition [ fhir:v "O BIOMARCADOR PEPTÍDEO NATRIURÉTICO TIPO B (BNP) E SUA PRÓ-MOLÉCULA (NTPROBNP)  SÃO MEMBROS DE UMA CLASSE DE HORMÔNIOS QUE REGULAM A PRESSÃO  ARTERIAL. O BNP E O NT-PROBNP SÉRICOS ELEVAM-SE CONTINUAMENTE NA MEDIDA  EM QUE A INSUFICIÊNCIA CARDÍACA (IC) AVANÇA. A TESTAGEM DO BNP E DO NTPROBNP  SÉRICO OFERECE UMA MEDIDA NÃO-INVASIVA E OBJETIVA PARA A  AVALIAÇÃO DE PACIENTES SOB RISCO DE IC. OS EXAMES LABORATORIAIS DEVEM SER  REALIZADOS NO SANGUE PERIFÉRICO DE PACIENTES COM SUSPEITA CLÍNICA DE IC,  CONFORME DIRETRIZES DO MINISTÉRIO DA SAÚDE, UNICAMENTE COM A FINALIDADE  DE DIAGNÓSTICO AMBULATORIAL EM PACIENTES COM BAIXO E MÉDIO RISCO CLÍNICO,  NA ATENÇÃO PRIMÁRIA À SAÚDE (APS)." ]
  ] [
     fhir:code [ fhir:v "0202020010" ] ;
     fhir:display [ fhir:v "CITOQUIMICA HEMATOLOGICA" ] ;
     fhir:definition [ fhir:v "A CITOQUIMICA HEMATOLOGICA DETECTA A PRESENÇA DE ENZIMAS INTRACELULARES, QUE CATALISAM E CONTROLAM VÁRIAS REAÇÕES, BEM COMO SUBSTÂNCIAS ESPECÍFICAS PARA UM DETERMINADO TIPO CELULAR. A ATIVIDADE DESSAS ENZIMAS É DEMONSTRADA PELA ADIÇÃO DE PSEUDO-SUBSTRATOS, QUE LEVAM A UMA CONVERSÃO ENZIMÁTICA COLORIDA PERCEPTÍVEIS A MICROSCOPIA OPTICA.  AS CÉLULAS SANGÜÍNEAS NORMAIS, ASSIM COMO SUAS PRECURSORAS, TÊM ATIVIDADE E LOCALIZAÇÃO ENZIMÁTICAS DIFERENTES QUANDO COMPARADAS A SEUS CORRESPONDENTES MALIGNOS. A CITOQUÍMICA BASEIA-SE NA RELAÇÃO DA MORFOLOGIA COM A DISTRIBUIÇÃO, A INTENSIDADE E A LOCALIZAÇÃO DA REAÇÃO NA CÉLULA." ]
  ] [
     fhir:code [ fhir:v "0202020029" ] ;
     fhir:display [ fhir:v "CONTAGEM DE PLAQUETAS" ] ;
     fhir:definition [ fhir:v "A CONTAGEM DE PLAQUETAS CONSISTE NA AVALIAÇÃO QUANTITATIVA DESTE ELEMENTO DO SANGUE.   É REALIZADA PELA CONTAGEM ELETRÔNICA EM APARELHO AUTOMÁTICO OU PELA CONTAGEM NO MICROSCÓPICO EM CÂMARAS ESPECÍFICAS. PERMMITE REALIZAR O DIAGNÓSTICO DE HIPERPLAQUETENIA E PLAQUETOPENIA." ]
  ] [
     fhir:code [ fhir:v "0202020037" ] ;
     fhir:display [ fhir:v "CONTAGEM DE RETICULOCITOS" ] ;
     fhir:definition [ fhir:v "A CONTAGEM DE RETICULÓCITOS É ÚTIL PARA AVALIAR A ATIVIDADE ERITROPOIÉTICA, SENDO IMPORTANTE PARA O DIAGNÓSTICO DIFERENCIAL DAS ANEMIAS, ASSIM COMO PARA ACOMPANHAR O TRATAMENTO. VALORES AUMENTADOS SÃO ENCONTRADOS NA HIPERATIVIDADE DA MEDULA ÓSSEA (RETICULOCITOSE), COMO, POR EXEMPLO, NAS ANEMIAS HEMOLÍTICAS. VALORES DIMINUÍDOS SÃO ENCONTRADOS NA HIPOATIVIDADE DA MEDULA ÓSSEA (RETICULOCITOPENIA), COMO, POR EXEMPLO, NA APLASIA MEDULAR." ]
  ] [
     fhir:code [ fhir:v "0202020045" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE CURVA DE RESISTÊNCIA GLOBULAR" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE CURVA DE RESISTÊNCIA GLOBULAR AVALIA A HABILIDADE DOS GLÓBULOS VERMELHOS DE INCORPORAR ÁGUA EM SEU INTERIOR, SEM QUE OCORRA LISE DA CÉLULA. ESSA RESISTÊNCIA ESTÁ ASSOCIADA À RELAÇÃO ENTRE SUPERFÍCIE/VOLUME DO GLÓBULO." ]
  ] [
     fhir:code [ fhir:v "0202020053" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE ENZIMAS ERITROCITARIAS (CADA)" ]
  ] [
     fhir:code [ fhir:v "0202020061" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE SULFO-HEMOGLOBINA" ] ;
     fhir:definition [ fhir:v "AS SULFONAMIDAS, ASSIM COMO A FENACETINA E A ACETANILIDA, PODEM ALTERAR A HEMOGLOBINA PELA ADIÇÃO DE UM RADICAL SULFUROSO À SUA MOLÉCULA, O QUE ORIGINA A SULFOHEMOGLOBINA, A QUAL NÃO TEM CAPACIDADE DE TRANSPORTAR OXIGÊNIO. ESSA ALTERAÇÃO DA HEMOGLOBINA NÃO PODE SER REVERTIDA." ]
  ] [
     fhir:code [ fhir:v "0202020070" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE COAGULAÇÃO" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE TEMPO DE COAGULAÇÃO AVALIA A ATIVIDADE DOS FATORES  QUE PARTICIPAM DO PROCESSO INTRÍNSECO DA COAGULAÇÃO. RESULTADOS  NORMAIS, NO ENTANTO, PODEM SER OBTIDOS EM PACIENTES COM DEFICIÊNCIA LEVE  OU MODERADA DE UM DESSES FATORES. O RESULTADO MOSTRA O TEMPO GASTO  PARA A HOMEOSTASIA COMPLETA DO SANGUE QUANDO COLHIDO E COLOCADO EM  CONDIÇÕES PADRÃO." ]
  ] [
     fhir:code [ fhir:v "0202020088" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE LISE DA EUGLOBULINA" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE TEMPO DE LISE DA EUGLOBINA CONSISTE NO TESTE REALIZADO  COM O PLASMA, APÓS ELE SER ACIDIFICADO, DILUÍDO, REFRIGERADO E PRECIPITADO.  A FRAÇÃO PRECIPITADA (FRACÃO DAS EUGLOBINAS) CONTÉM FIBRINOGÊNIO,  PLASMINOGÊNIO, PLASMINA ATIVA E ATIVADORES E INIBIDORES DO PLASMINOGÊNIO E  , POR CENTRIFUGAÇÃO, É REDISSOLVIDA. ADICIONA-SE, EM SEGUIDA, A TROMBINA  QUE INDUZ A FORMAÇÃO DO COÁGULO E REGISTRA-SE O TEMPO ATÉ A LISE. OS  RESULTADOS DESSE TESTE REFLETEM A CAPACIDADE FIBRINOLÍTICA E A SUA  INIBIÇÃO." ]
  ] [
     fhir:code [ fhir:v "0202020096" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE SANGRAMENTO -DUKE" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE TEMPO DE LISE DA EUGLOBINA CONSISTE NO TESTE REALIZADO  COM O PLASMA, APÓS ELE SER ACIDIFICADO, DILUÍDO, REFRIGERADO E PRECIPITADO.  A FRAÇÃO PRECIPITADA (FRACÃO DAS EUGLOBINAS) CONTÉM FIBRINOGÊNIO, PLASMINOGÊNIO, PLASMINA ATIVA E ATIVADORES E INIBIDORES DO PLASMINOGÊNIO E, POR CENTRIFUGAÇÃO, É REDISSOLVIDA. ADICIONA-SE, EM SEGUIDA, A TROMBINA QUE INDUZ A FORMAÇÃO DO COÁGULO E REGISTRA-SE O TEMPO ATÉ A LISE. OS RESULTADOS DESSE TESTE REFLETEM A CAPACIDADE FIBRINOLÍTICA E A SUA INIBIÇÃO." ]
  ] [
     fhir:code [ fhir:v "0202020100" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE SANGRAMENTO DE IVY" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DO TEMPO DE SANGRAMENTO AVALIA A INTERAÇÃO DA PLAQUETA  COM A PAREDE DO VASO SANGUÍNEO E A FORMAÇÃO SUBSEQUENTE DO COÁGULO  HEMOSTÁTICO DE MODO INDEPENDENTE DA CASCATA DA COAGULAÇÃO. EXISTE UMA  RELAÇÃO QUASE LINEAR ENTRE A CONTAGEM DE PLAQUETAS E O TEMPO DE  SANGRAMENTO. PODE SER REALIZADO PELA TÉCNICA DE IVY. APÓS INSUFLAÇÃO DE  UM ESFIGMOMANÔMETRO COLOCADO NO BRAÇO ATÉ AOS 40 MM HG. UMA LANCETA,  AGULHA OU BISTURI É USADO PARA PROVOCAR UMA FERIDA PERFUROCORTANTE DE  COMPRIMENTO E PROFUNDIDADE PADRONIZADOS NO ANTEBRAÇO DO MESMO LADO E  MEDE-SE O TEMPO NECESSÁRIO PARA CESSAR A HEMORRAGIA." ]
  ] [
     fhir:code [ fhir:v "0202020118" ] ;
     fhir:display [ fhir:v "DETERMINACAO DE TEMPO DE SOBREVIDA DE HEMACIAS" ]
  ] [
     fhir:code [ fhir:v "0202020126" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE TROMBINA" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE TEMPO DE TROMBINA É UM TESTE DE SCREENING PARA DETECTAR DEFICIÊNCIA DE  FIBRINOGÊNIO FUNCIONAL . O EXAME SE BASEIA NA MEDIDA DO TEMPO QUE DEMORA EM COAGULAR UM PLASMA CITRATADO, COLOCADO A 37O C E EM PRESENÇA DE UMA SOLUÇÃO DE TROMBINA DE ATIVIDADE FIXA." ]
  ] [
     fhir:code [ fhir:v "0202020134" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO DE TROMBOPLASTINA PARCIAL ATIVADA (TTP ATIVADA)" ] ;
     fhir:definition [ fhir:v "A DETERMINAÇÃO DE TEMPO DE TROMBOPLASTINA PARCIAL ATIVADA (TTP ATIVADA) NORMALMENTE MEDE A VIA INTRÍNSECA DA COAGULAÇÃO. É INDICADA NOS CASOS DE SUSPEITA DE DEFICIÊNCIA DE FATORES DA VIA INTRÍNSECA DA COAGULAÇÃO, ANTES DE SEREM REALIZADAS INTERVENÇÕES CIRÚRGICAS, E NO CONTROLE DE TERAPÊUTICA ANTICOAGULANTE PELA HEPARINA. A DETERMINAÇÃO DE TEMPO DE TROMBOPLASTINA PARCIAL ATIVADA (TTP ATIVADA) NORMALMENTE MEDE A VIA INTRÍNSECA DA COAGULAÇÃO. É INDICADA NOS CASOS DE SUSPEITA DE DEFICIÊNCIA DE FATORES DA VIA INTRÍNSECA DA COAGULAÇÃO, ANTES DE SEREM REALIZADAS INTERVENÇÕES CIRÚRGICAS, E NO CONTROLE DE TERAPÊUTICA ANTICOAGULANTE PELA HEPARINA. O TEMPO DE TROMBOPLASTINA PARCIAL CORRESPONDE AO TEMPO GASTO PARA OCORRER A COAGULAÇÃO DO PLASMA RECALCIFICADO EM PRESENÇA DE CEFALINA" ]
  ] [
     fhir:code [ fhir:v "0202020142" ] ;
     fhir:display [ fhir:v "DETERMINAÇÃO DE TEMPO E ATIVIDADE DA PROTROMBINA (TAP)" ] ;
     fhir:definition [ fhir:v "O TEMPO DA PROTROMBINA ESTÁ PROLONGADO NAS SEGUINTES CONDIÇÕES: NAS DEFICIÊNCIAS DE FATORES VII, V, X, II (PROTROMBINA) E I, NA PRESENÇA DE ALGUNS TIPOS DE ANTICOAGULANTES CIRCULANTES, EM PACIENTES COM DOENÇA HEPÁTICA GRAVE, EM CONDIÇÕES QUE ALTEREM A ABSORÇÃO, SÍNTESE E O METABOLISMO DA VITAMINA K E EM PACIENTES COM HIPOFIBRINOGENEMIA. MÉTODO: COAGULOMÉTRICO EM SANGUE VENOSO." ]
  ] [

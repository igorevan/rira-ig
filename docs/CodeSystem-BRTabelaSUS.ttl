  fhir:concept ( [
     fhir:code [ fhir:v "0101010010" ] ;
     fhir:display [ fhir:v "ATIVIDADE EDUCATIVA / ORIENTAÇÃO EM GRUPO NA ATENÇÃO PRIMÁRIA" ] ;
     fhir:definition [ fhir:v "CONSISTE NAS ATIVIDADES EDUCATIVAS, EM GRUPO,  SOBRE AÇÕES DE PROMOÇÃO E PREVENÇÃO À SAÚDE, DESENVOLVIDAS NA UNIDADE OU NA COMUNIDADE.  RECOMENDA-SE O MÍNIMO DE 10 (DEZ) PARTICIPANTES,COM DURAÇÃO MÍNIMA  DE 30 (TRINTA) MINUTOS.DEVE-SE REGISTRAR O NÚMERO DE ATIVIDADES REALIZADAS POR MÊS" ]
  ] [
     fhir:code [ fhir:v "0101010028" ] ;
     fhir:display [ fhir:v "ATIVIDADE EDUCATIVA / ORIENTAÇÃO EM GRUPO NA ATENÇÃO ESPECIALIZADA" ] ;
     fhir:definition [ fhir:v "CONSISTE NAS ATIVIDADES EDUCATIVAS SOBRE AÇÕES DE PROMOÇÃO E PREVENÇÃO À SAÚDE, DESENVOLVIDAS EM GRUPO.  RECOMENDA-SE O MÍNIMO DE 10 (DEZ) PARTICIPANTES,COM DURAÇÃO MÍNIMA  DE 30 (TRINTA) MINUTOS.DEVE-SE REGISTRAR O NÚMERO DE ATIVIDADES REALIZADAS POR MÊS." ]
  ] [
     fhir:code [ fhir:v "0101010036" ] ;
     fhir:display [ fhir:v "PRÁTICA CORPORAL / ATIVIDADE FÍSICA EM GRUPO" ] ;
     fhir:definition [ fhir:v "ATIVIDADE FÍSICA DESENVOLVIDA EM GRUPO POR PROFISSIONAIS QUALIFICADOS , REALIZADA NO ESTABELECIMENTO DE SAÚDE OU NA COMUNIDADE.INFORMAR NÚMERO DE ATIVIDADES REALIZADAS EM GRUPO POR MÊS." ]
  ] [
     fhir:code [ fhir:v "0101010095" ] ;
     fhir:display [ fhir:v "PREVENÇÃO DA COVID-19 NAS ESCOLAS" ] ;
     fhir:definition [ fhir:v "AÇÕES COLETIVAS DE PROMOÇÃO DA SAÚDE E PREVENÇÃO DE DOENÇAS VOLTADAS À PREVENÇÃO DO NOVO CORONAVÍRUS (COVID-19) REALIZADAS NO ÂMBITO NAS ESCOLAS" ]
  ] [
     fhir:code [ fhir:v "0101020015" ] ;
     fhir:display [ fhir:v "AÇÃO COLETIVA DE APLICAÇÃO TÓPICA DE FLÚOR GEL" ] ;
     fhir:definition [ fhir:v "APLICAÇÃO TÓPICA DE FLÚOR EM GEL COM CONCENTRAÇÃO DE 1,23 , REALIZADA SISTEMATICAMENTE POR GRUPOS POPULACIONAIS SOB ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE, UTILIZANDO-SE ESCOVA DENTAL, MOLDEIRA, PINCELAMENTO OU OUTRAS FORMAS DE APLICAÇÃO. AÇÃO REGISTRADA POR PESSOA POR MÊS." ]
  ] [
     fhir:code [ fhir:v "0101020023" ] ;
     fhir:display [ fhir:v "AÇÃO COLETIVA DE BOCHECHO FLUORADO" ] ;
     fhir:definition [ fhir:v "BOCHECHO DE SOLUÇÃO FLUORETADA, REALIZADO SISTEMATICAMENTE POR GRUPOS POPULACIONAIS SOB  ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE, PODENDO TER PERIODICIDADE SEMANAL, CASO A  SOLUÇÃO DE FLUORETO DE SÓDIO TENHA A CONCENTRAÇÃO DE 0,2 , OU DIARIAMENTE, CASO A CONCENTRAÇÃO SEJA DE 0,05. AÇÃO REGISTRADA POR USUÁRIO PARTICIPANTE POR MÊS, INDEPENDENTE DA FREQUÊNCIA COM QUE É REALIZADA (DIÁRIA OU SEMANAL) OU DA FREQUÊNCIA COM QUE O USUÁRIO PARTICIPOU DA AÇÃO." ]
  ] [
     fhir:code [ fhir:v "0101020031" ] ;
     fhir:display [ fhir:v "AÇÃO COLETIVA DE ESCOVAÇÃO DENTAL SUPERVISIONADA" ] ;
     fhir:definition [ fhir:v "ESCOVAÇÃO DENTAL COM OU SEM EVIDENCIAÇÃO DE PLACAS BACTERIANAS. REALIZADA COM GRUPOS POPULACIONAIS SOB ORIENTAÇÃO E SUPERVISÃO DE UM OU MAIS PROFISSIONAIS DE SAÚDE. AÇÃO REGISTRADA POR USUÁRIO POR USUÁRIO PARTICIPANTE DA AÇÃO." ]
  ] [
     fhir:code [ fhir:v "0101020040" ] ;
